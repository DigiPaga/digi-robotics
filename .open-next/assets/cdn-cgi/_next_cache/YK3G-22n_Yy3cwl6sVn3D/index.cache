--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\">REQUEST ACCESS<!-- --> →</a></div></article><article class=\"group overflow-hidden rounded-2xl border border-white/[.09] bg-[var(--surface)] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[var(--primary)]/30 focus-within:border-[var(--primary)]/30\"><div class=\"relative h-48 w-full overflow-hidden rounded-t-lg bg-[#161c29]\"><img alt=\"HVAC maintenance technician servicing an air conditioning unit\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 33vw, 25vw\" srcSet=\"/_next/image?url=%2Fmarketplace%2Fhvac-maintenance.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fmarketplace%2Fhvac-maintenance.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fmarketplace%2Fhvac-maintenance.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fmarketplace%2Fhvac-maintenance.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fmarketplace%2Fhvac-maintenance.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fmarketplace%2Fhvac-maintenance.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fmarketplace%2Fhvac-maintenance.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fmarketplace%2Fhvac-maintenance.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fmarketplace%2Fhvac-maintenance.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fmarketplace%2Fhvac-maintenance.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fmarketplace%2Fhvac-maintenance.jpeg&amp;w=3840&amp;q=75\"/><span class=\"absolute left-4 top-3 rounded-full bg-[#0e1118]/80 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[.14em] text-[var(--primary)]\">POV / <!-- -->09</span></div><div class=\"p-6\"><p class=\"font-mono text-[11px] uppercase tracking-[.15em] text-[var(--primary)]\">Domestic/Hospitality</p><h3 class=\"mt-3 font-heading text-2xl leading-[1.05] transition-colors duration-300 ease-out group-hover:text-[var(--primary)]\">HVAC MAINTENANCE</h3><p class=\"mt-4 text-[17px] leading-6 text-[var(--muted-foreground)]\">Air conditioning filter cleaning, system setup, and airflow optimization procedures.</p><a href=\"#custom-data\" class=\"relative mt-6 inline-flex min-h-11 items-center text-[13px] font-semibold tracking-[.08em] text-white transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-2 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\">REQUEST ACCESS<!-- --> →</a></div></article></div><div class=\"mt-12\"><a class=\"inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[var(--primary)] px-6 py-3 text-[15px] font-semibold uppercase tracking-[.04em] text-[var(--page-bg)] transition-all duration-300 ease-out hover:-translate-y-0.5 hover:opacity-90 hover:shadow-[0_10px_30px_-14px_var(--primary)] \" href=\"#join\">Enter the marketplace<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></a></div></div></section><section id=\"contributors\" class=\"scroll-mt-24 border-y border-white/[.07] bg-[#141923] py-24 sm:py-32 lg:py-40\"><div class=\"mx-auto w-full max-w-[1440px] px-5 sm:px-8 lg:px-12 xl:px-16 grid gap-14 lg:grid-cols-[.92fr_1.08fr] lg:items-center\"><div class=\"reveal \" style=\"opacity:0;transform:translateY(24px)\"><p class=\"font-mono text-[12px] font-medium uppercase tracking-[0.18em] text-[var(--primary)] sm:text-[13px]\">03 / Contribute and earn</p><h2 class=\"max-w-4xl font-heading text-[clamp(2.45rem,5vw,5.4rem)] font-medium leading-[.94] tracking-[-.045em] text-[var(--foreground)] mt-5\">Turn real-world skills into audiovisual training data.</h2><p class=\"mt-6 max-w-xl text-[19px] leading-[1.5] text-[var(--muted-foreground)] lg:text-[21px]\">Create your profile, register for upcoming campaigns, and capture approved first-person tasks using a phone or supported camera.</p><ol class=\"mt-9 border-t border-white/10\"><li class=\"grid min-h-24 grid-cols-[42px_1fr_32px] items-center gap-3 border-b border-white/10 py-4\"><span class=\"font-mono text-[12px] text-[var(--primary)]\">01</span><span><strong class=\"block font-heading text-base font-medium sm:text-lg\">LOGIN —</strong><span class=\"mt-1 block text-[15px] leading-5 text-[var(--muted-foreground)] sm:text-[16px]\">Create your profile, register for upcoming campaigns.</span></span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-radio text-white/45\" aria-hidden=\"true\"><path d=\"M16.247 7.761a6 6 0 0 1 0 8.478\"></path><path d=\"M19.075 4.933a10 10 0 0 1 0 14.134\"></path><path d=\"M4.925 19.067a10 10 0 0 1 0-14.134\"></path><path d=\"M7.753 16.239a6 6 0 0 1 0-8.478\"></path><circle cx=\"12\" cy=\"12\" r=\"2\"></circle></svg></li><li class=\"grid min-h-24 grid-cols-[42px_1fr_32px] items-center gap-3 border-b border-white/10 py-4\"><span class=\"font-mono text-[12px] text-[var(--primary)]\">02</span><span><strong class=\"block font-heading text-base font-medium sm:text-lg\">CAPTURE —</strong><span class=\"mt-1 block text-[15px] leading-5 text-[var(--muted-foreground)] sm:text-[16px]\">Record approved first-person tasks using a phone or supported camera.</span></span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-upload text-white/45\" aria-hidden=\"true\"><path d=\"M12 3v12\"></path><path d=\"m17 8-5-5-5 5\"></path><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path></svg></li><li class=\"grid min-h-24 grid-cols-[42px_1fr_32px] items-center gap-3 border-b border-white/10 py-4\"><span class=\"font-mono text-[12px] text-[var(--primary)]\">03</span><span><strong class=\"block font-heading text-base font-medium sm:text-lg\">EARN —</strong><span class=\"mt-1 block text-[15px] leading-5 text-[var(--muted-foreground)] sm:text-[16px]\">Receive USDG after acceptance.</span></span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-wallet-cards text-white/45\" aria-hidden=\"true\"><path d=\"M3 11h3.75a2 2 0 0 1 1.6.8l.45.6a4 4 0 0 0 6.4 0l.45-.6a2 2 0 0 1 1.6-.8H21\"></path><path d=\"M3 7h18\"></path><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"></rect></svg></li></ol><button type=\"button\" class=\"mt-8 min-h-13 rounded-full bg-[var(--primary)] px-6 py-3 text-[15px] font-semibold uppercase tracking-[.04em] text-[var(--page-bg)] transition-all duration-300 ease-out hover:-translate-y-0.5 hover:opacity-90 hover:shadow-[0_10px_30px_-14px_var(--primary)]\">Join the first capture campaigns ↗</button><p class=\"mt-5 flex items-center gap-2 text-[16px] font-medium text-[var(--primary)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg> Gmail or email OTP. No previous robotics experience required.</p></div><div class=\"reveal relative\" style=\"opacity:0;transform:translateY(24px)\"><div class=\"grid grid-cols-[1fr_.28fr] gap-3\"><div class=\"relative aspect-[4/5] overflow-hidden rounded-2xl border border-white/10\"><img alt=\"First-person view of a contributor packing a parcel\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1024px) 75vw, 45vw\" srcSet=\"/_next/image?url=%2Fdigirobotics%2Fcontributor%2Fparcel-capture.webp&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fdigirobotics%2Fcontributor%2Fparcel-capture.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fdigirobotics%2Fcontributor%2Fparcel-capture.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fdigirobotics%2Fcontributor%2Fparcel-capture.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fdigirobotics%2Fcontributor%2Fparcel-capture.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fdigirobotics%2Fcontributor%2Fparcel-capture.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fdigirobotics%2Fcontributor%2Fparcel-capture.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fdigirobotics%2Fcontributor%2Fparcel-capture.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fdigirobotics%2Fcontributor%2Fparcel-capture.webp&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fdigirobotics%2Fcontributor%2Fparcel-capture.webp&amp;w=3840&amp;q=75\"/></div><div class=\"flex flex-col gap-3\"><div class=\"flex flex-1 flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-white/10 bg-white/[.015] p-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-camera text-white/45\" aria-hidden=\"true\"><path d=\"M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z\"></path><circle cx=\"12\" cy=\"13\" r=\"3\"></circle></svg><p class=\"font-mono text-[10px] uppercase tracking-[.14em] text-white/45\">Capture setup</p></div><div class=\"flex flex-1 flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-white/10 bg-white/[.015] p-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-camera text-white/45\" aria-hidden=\"true\"><path d=\"M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z\"></path><circle cx=\"12\" cy=\"13\" r=\"3\"></circle></svg><p class=\"font-mono text-[10px] uppercase tracking-[.14em] text-white/45\">First-person recording</p></div><div class=\"flex flex-1 flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-white/10 bg-white/[.015] p-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-upload text-white/45\" aria-hidden=\"true\"><path d=\"M12 3v12\"></path><path d=\"m17 8-5-5-5 5\"></path><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path></svg><p class=\"font-mono text-[10px] uppercase tracking-[.14em] text-white/45\">Upload in progress</p></div><div class=\"flex flex-1 flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-white/10 bg-white/[.015] p-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check text-white/45\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><p class=\"font-mono text-[10px] uppercase tracking-[.14em] text-white/45\">Approved submission</p></div></div></div><div class=\"absolute -bottom-5 left-3 max-w-[calc(100%-1.5rem)] rounded-xl border border-[var(--primary)]/30 bg-[#11170f] px-4 py-3 font-mono text-[10px] uppercase tracking-[.15em] text-[var(--primary)] shadow-xl sm:-left-3 sm:max-w-none\">Human signal / verified task</div></div></div></section><section id=\"custom-data\" class=\"scroll-mt-24 py-24 sm:py-32 lg:py-40\"><div class=\"mx-auto w-full max-w-[1440px] px-5 sm:px-8 lg:px-12 xl:px-16\"><div class=\"reveal \" style=\"opacity:0;transform:translateY(24px)\"><p class=\"font-mono text-[12px] font-medium uppercase tracking-[0.18em] text-[var(--primary)] sm:text-[13px]\">04 / Data on demand</p><h2 class=\"max-w-4xl font-heading text-[clamp(2.45rem,5vw,5.4rem)] font-medium leading-[.94] tracking-[-.045em] text-[var(--foreground)] mt-5\">Request the datasets your robot needs.</h2><p class=\"mt-6 max-w-2xl text-[19px] leading-[1.5] text-[var(--muted-foreground)] lg:text-[21px]\">Define the task, environment category, capture method, and acceptance criteria. DigiRobotics will use the request to plan a targeted contributor campaign.</p></div><div class=\"mt-14 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 lg:grid-cols-3\"><a href=\"#request-form\" class=\"group min-h-[260px] border border-transparent bg-[var(--surface)] p-7 transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[var(--primary)]/30 hover:bg-white/[.03] sm:p-9\"><div class=\"flex items-start justify-between\"><span class=\"font-mono text-[11px] text-[var(--primary)]\">0<!-- -->1</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-video text-white/55 transition group-hover:text-[var(--primary)]\" aria-hidden=\"true\"><path d=\"m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5\"></path><rect x=\"2\" y=\"6\" width=\"14\" height=\"12\" rx=\"2\"></rect></svg></div><h3 class=\"mt-16 font-heading text-3xl transition-colors duration-300 ease-out group-hover:text-[var(--primary)]\">AUDIOVISUAL</h3><p class=\"mt-4 max-w-sm text-[17px] leading-6 text-[var(--muted-foreground)]\">First-person video, synchronized camera views, audio, and demonstrations.</p></a><a href=\"#request-form\" class=\"group min-h-[260px] border border-transparent bg-[var(--surface)] p-7 transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[var(--primary)]/30 hover:bg-white/[.03] sm:p-9\"><div class=\"flex items-start justify-between\"><span class=\"font-mono text-[11px] text-[var(--primary)]\">0<!-- -->2</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-monitor-play text-white/55 transition group-hover:text-[var(--primary)]\" aria-hidden=\"true\"><path d=\"M15.033 9.44a.647.647 0 0 1 0 1.12l-4.065 2.352a.645.645 0 0 1-.968-.56V7.648a.645.645 0 0 1 .967-.56z\"></path><path d=\"M12 17v4\"></path><path d=\"M8 21h8\"></path><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\"></rect></svg></div><h3 class=\"mt-16 font-heading text-3xl transition-colors duration-300 ease-out group-hover:text-[var(--primary)]\">SOFTWARE</h3><p class=\"mt-4 max-w-sm text-[17px] leading-6 text-[var(--muted-foreground)]\">Screen interactions, digital workflows, and interface navigation.</p></a><a href=\"#request-form\" class=\"group min-h-[260px] border border-transparent bg-[var(--surface)] p-7 transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[var(--primary)]/30 hover:bg-white/[.03] sm:p-9\"><div class=\"flex items-start justify-between\"><span class=\"font-mono text-[11px] text-[var(--primary)]\">0<!-- -->3</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cpu text-white/55 transition group-hover:text-[var(--primary)]\" aria-hidden=\"true\"><path d=\"M12 20v2\"></path><path d=\"M12 2v2\"></path><path d=\"M17 20v2\"></path><path d=\"M17 2v2\"></path><path d=\"M2 12h2\"></path><path d=\"M2 17h2\"></path><path d=\"M2 7h2\"></path><path d=\"M20 12h2\"></path><path d=\"M20 17h2\"></path><path d=\"M20 7h2\"></path><path d=\"M7 20v2\"></path><path d=\"M7 2v2\"></path><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"></rect><rect x=\"8\" y=\"8\" width=\"8\" height=\"8\" rx=\"1\"></rect></svg></div><h3 class=\"mt-16 font-heading text-3xl transition-colors duration-300 ease-out group-hover:text-[var(--primary)]\">HARDWARE</h3><p class=\"mt-4 max-w-sm text-[17px] leading-6 text-[var(--muted-foreground)]\">Tool use, device operation, sensors, wearables, and physical interaction.</p></a></div><form id=\"request-form\" class=\"mt-16 grid gap-6 rounded-2xl border border-white/10 bg-[#141a25] p-6 sm:p-9 lg:grid-cols-2 lg:p-12\" aria-describedby=\"form-status\"><div><label for=\"workEmail\" class=\"block font-heading text-base\">Work email</label><input required=\"\" type=\"email\" autoComplete=\"email\" id=\"workEmail\" placeholder=\"you@company.com\" class=\"mt-2 block min-h-13 w-full rounded-lg border border-white/15 bg-[#111721] px-4 py-3 text-[17px] text-white placeholder:text-white/35 transition focus:border-[var(--primary)] focus:outline-none\" name=\"workEmail\"/></div><div><label for=\"company\" class=\"block font-heading text-base\">Company or project</label><input required=\"\" id=\"company\" autoComplete=\"organization\" placeholder=\"Project name\" class=\"mt-2 block min-h-13 w-full rounded-lg border border-white/15 bg-[#111721] px-4 py-3 text-[17px] text-white placeholder:text-white/35 transition focus:border-[var(--primary)] focus:outline-none\" name=\"company\"/></div><div><label for=\"dataType\" class=\"block font-heading text-base\">Data type</label><select required=\"\" id=\"dataType\" name=\"dataType\" class=\"mt-2 block min-h-13 w-full rounded-lg border border-white/15 bg-[#111721] px-4 py-3 text-[17px] text-white placeholder:text-white/35 transition focus:border-[var(--primary)] focus:outline-none\"><option value=\"\" disabled=\"\" selected=\"\">Select a data type</option><option>Audiovisual</option><option>Software interaction</option><option>Hardware and sensor</option><option>Mixed campaign</option></select></div><div><label for=\"captureEstimate\" class=\"block font-heading text-base\">Estimated number of captures</label><input required=\"\" min=\"1\" type=\"number\" inputMode=\"numeric\" id=\"captureEstimate\" placeholder=\"e.g. 250\" class=\"mt-2 block min-h-13 w-full rounded-lg border border-white/15 bg-[#111721] px-4 py-3 text-[17px] text-white placeholder:text-white/35 transition focus:border-[var(--primary)] focus:outline-none\" name=\"captureEstimate\"/></div><div class=\"lg:col-span-2\"><label for=\"scenario\" class=\"block font-heading text-base\">Task or scenario</label><textarea required=\"\" minLength=\"20\" id=\"scenario\" name=\"scenario\" rows=\"4\" placeholder=\"Describe the task, environment, and observable outcome.\" class=\"mt-2 block min-h-13 w-full rounded-lg border border-white/15 bg-[#111721] px-4 py-3 text-[17px] text-white placeholder:text-white/35 transition focus:border-[var(--primary)] focus:outline-none\"></textarea></div><div class=\"lg:col-span-2\"><label for=\"requirements\" class=\"block font-heading text-base\">Additional requirements<!-- --> <span class=\"text-white/45\">(optional)</span></label><textarea id=\"requirements\" name=\"requirements\" rows=\"3\" placeholder=\"Capture devices, camera views, acceptance criteria, or constraints.\" class=\"mt-2 block min-h-13 w-full rounded-lg border border-white/15 bg-[#111721] px-4 py-3 text-[17px] text-white placeholder:text-white/35 transition focus:border-[var(--primary)] focus:outline-none\"></textarea></div><div class=\"flex flex-col items-start gap-4 lg:col-span-2 sm:flex-row sm:items-center\"><button class=\"inline-flex min-h-13 items-center justify-center gap-2 rounded-full bg-[var(--primary)] px-7 py-3 text-[15px] font-semibold uppercase tracking-[.04em] text-[var(--page-bg)] disabled:cursor-default disabled:opacity-60 transition-all duration-300 ease-out hover:-translate-y-0.5 hover:opacity-90 hover:shadow-[0_10px_30px_-14px_var(--primary)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-send\" aria-hidden=\"true\"><path d=\"M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z\"></path><path d=\"m21.854 2.147-10.94 10.939\"></path></svg>Submit data request</button><p id=\"form-status\" role=\"status\" aria-live=\"polite\" class=\"text-[15px] leading-6 text-white/55\">We’ll use your request to plan a targeted contributor campaign.</p></div></form></div></section><section id=\"capture-gear\" class=\"scroll-mt-24 border-y border-white/[.07] bg-[#141923] py-24 sm:py-32 lg:py-40\"><div class=\"mx-auto w-full max-w-[1440px] px-5 sm:px-8 lg:px-12 xl:px-16\"><div class=\"grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-end\"><div class=\"reveal \" style=\"opacity:0;transform:translateY(24px)\"><p class=\"font-mono text-[12px] font-medium uppercase tracking-[0.18em] text-[var(--primary)] sm:text-[13px]\">05 / Capture equipment</p><h2 class=\"max-w-4xl font-heading text-[clamp(2.45rem,5vw,5.4rem)] font-medium leading-[.94] tracking-[-.045em] text-[var(--foreground)] mt-5\">Gear up for the next wave of data creation.</h2><p class=\"mt-6 max-w-2xl text-[19px] leading-[1.5] text-[var(--muted-foreground)] lg:text-[21px]\">Explore cameras, holders, wearables, and sensors designed for stable first-person capture.</p></div><div class=\"reveal \" style=\"opacity:0;transform:translateY(24px)\"><div class=\"relative aspect-[3/2] overflow-hidden rounded-2xl border border-white/10\"><img alt=\"Head mount, chest harness, depth camera, and motion sensors arranged on a workbench\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1024px) 100vw, 52vw\" srcSet=\"/_next/image?url=%2Fdigirobotics%2Fgear%2Fcapture-kit.webp&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fdigirobotics%2Fgear%2Fcapture-kit.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fdigirobotics%2Fgear%2Fcapture-kit.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fdigirobotics%2Fgear%2Fcapture-kit.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fdigirobotics%2Fgear%2Fcapture-kit.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fdigirobotics%2Fgear%2Fcapture-kit.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fdigirobotics%2Fgear%2Fcapture-kit.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fdigirobotics%2Fgear%2Fcapture-kit.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fdigirobotics%2Fgear%2Fcapture-kit.webp&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fdigirobotics%2Fgear%2Fcapture-kit.webp&amp;w=3840&amp;q=75\"/></div></div></div><div class=\"mt-12 grid gap-px overflow-hidden rounded-xl border border-white/10 bg-white/10 md:grid-cols-2 xl:grid-cols-4\"><article class=\"group flex flex-col border border-transparent bg-[var(--surface)] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[var(--primary)]/30\"><div class=\"relative h-48 w-full overflow-hidden rounded-t-lg bg-[#161c29]\"><img alt=\"Sensorial head-mounted camera worn by a contributor for hands-free first-person recording\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 25vw\" srcSet=\"/_next/image?url=%2Fgear%2Fhead-mounted-phone-holder.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fgear%2Fhead-mounted-phone-holder.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fgear%2Fhead-mounted-phone-holder.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fgear%2Fhead-mounted-phone-holder.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fgear%2Fhead-mounted-phone-holder.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fgear%2Fhead-mounted-phone-holder.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fgear%2Fhead-mounted-phone-holder.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fgear%2Fhead-mounted-phone-holder.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fgear%2Fhead-mounted-phone-holder.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fgear%2Fhead-mounted-phone-holder.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fgear%2Fhead-mounted-phone-holder.jpg&amp;w=3840&amp;q=75\"/><span class=\"absolute left-4 top-3 rounded-full bg-[#0e1118]/80 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[.14em] text-[var(--primary)]\">0<!-- -->1</span></div><div class=\"flex flex-1 flex-col p-6\"><div class=\"flex items-start justify-between gap-3\"><p class=\"font-mono text-[10px] uppercase tracking-[.14em] text-white/45\">Sensorial Head Camera</p><span class=\"shrink-0 rounded-full border px-2.5 py-1 font-mono text-[9px] uppercase tracking-[.12em] border-white/15 bg-white/[.04] text-white/55\">COMING SOON</span></div><h3 class=\"mt-4 font-heading text-xl leading-tight transition-colors duration-300 ease-out group-hover:text-[var(--primary)]\">SENSORIAL HEAD-MOUNTED CAMERA</h3><p class=\"mt-3 flex-1 text-[15px] leading-6 text-[var(--muted-foreground)]\">Stable, hands-free first-person capture designed for continuous task recording.</p></div></article><article class=\"group flex flex-col border border-transparent bg-[var(--surface)] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[var(--primary)]/30\"><div class=\"relative h-48 w-full overflow-hidden rounded-t-lg bg-[#161c29]\"><img alt=\"Worker wearing a chest-mounted capture harness on an ergonomic body rig\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 25vw\" srcSet=\"/_next/image?url=%2Fgear%2Fchest-mount-capture-harness.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fgear%2Fchest-mount-capture-harness.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fgear%2Fchest-mount-capture-harness.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fgear%2Fchest-mount-capture-harness.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fgear%2Fchest-mount-capture-harness.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fgear%2Fchest-mount-capture-harness.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fgear%2Fchest-mount-capture-harness.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fgear%2Fchest-mount-capture-harness.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fgear%2Fchest-mount-capture-harness.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fgear%2Fchest-mount-capture-harness.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fgear%2Fchest-mount-capture-harness.png&amp;w=3840&amp;q=75\"/><span class=\"absolute left-4 top-3 rounded-full bg-[#0e1118]/80 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[.14em] text-[var(--primary)]\">0<!-- -->2</span></div><div class=\"flex flex-1 flex-col p-6\"><div class=\"flex items-start justify-between gap-3\"><p class=\"font-mono text-[10px] uppercase tracking-[.14em] text-white/45\">Ergonomic Body Rig</p><span class=\"shrink-0 rounded-full border px-2.5 py-1 font-mono text-[9px] uppercase tracking-[.12em] border-[var(--primary)]/30 bg-[var(--primary)]/[.08] text-[var(--primary)]\">AVAILABLE</span></div><h3 class=\"mt-4 font-heading text-xl leading-tight transition-colors duration-300 ease-out group-hover:text-[var(--primary)]\">CHEST-MOUNT CAPTURE HARNESS</h3><p class=\"mt-3 flex-1 text-[15px] leading-6 text-[var(--muted-foreground)]\">Distributed weight harness for all-day comfort during industrial and field data collection.</p></div></article><article class=\"group flex flex-col border border-transparent bg-[var(--surface)] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[var(--primary)]/30\"><div class=\"relative h-48 w-full overflow-hidden rounded-t-lg bg-[#161c29]\"><img alt=\"Smart gloves used for haptic and motion tracking of fine hand movements\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 25vw\" srcSet=\"/_next/image?url=%2Fgear%2Fsmart-gloves.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fgear%2Fsmart-gloves.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fgear%2Fsmart-gloves.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fgear%2Fsmart-gloves.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fgear%2Fsmart-gloves.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fgear%2Fsmart-gloves.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fgear%2Fsmart-gloves.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fgear%2Fsmart-gloves.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fgear%2Fsmart-gloves.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fgear%2Fsmart-gloves.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fgear%2Fsmart-gloves.jpeg&amp;w=3840&amp;q=75\"/><span class=\"absolute left-4 top-3 rounded-full bg-[#0e1118]/80 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[.14em] text-[var(--primary)]\">0<!-- -->3</span></div><div class=\"flex flex-1 flex-col p-6\"><div class=\"flex items-start justify-between gap-3\"><p class=\"font-mono text-[10px] uppercase tracking-[.14em] text-white/45\">Haptic &amp; Motion Tracking</p><span class=\"shrink-0 rounded-full border px-2.5 py-1 font-mono text-[9px] uppercase tracking-[.12em] border-[var(--primary)]/30 bg-[var(--primary)]/[.08] text-[var(--primary)]\">AVAILABLE</span></div><h3 class=\"mt-4 font-heading text-xl leading-tight transition-colors duration-300 ease-out group-hover:text-[var(--primary)]\">SMART GLOVES</h3><p class=\"mt-3 flex-1 text-[15px] leading-6 text-[var(--muted-foreground)]\">Capture fine motor skills, grip pressure, and precise hand movements for dexterity training.</p></div></article><article class=\"group flex flex-col border border-transparent bg-[var(--surface)] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[var(--primary)]/30\"><div class=\"relative h-48 w-full overflow-hidden rounded-t-lg bg-[#161c29]\"><img alt=\"Contributor wearing motion and environmental sensor gear for full-body spatial tracking\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 25vw\" srcSet=\"/_next/image?url=%2Fgear%2Fmotion-sensor-kit.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fgear%2Fmotion-sensor-kit.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fgear%2Fmotion-sensor-kit.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fgear%2Fmotion-sensor-kit.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fgear%2Fmotion-sensor-kit.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fgear%2Fmotion-sensor-kit.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fgear%2Fmotion-sensor-kit.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fgear%2Fmotion-sensor-kit.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fgear%2Fmotion-sensor-kit.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fgear%2Fmotion-sensor-kit.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fgear%2Fmotion-sensor-kit.png&amp;w=3840&amp;q=75\"/><span class=\"absolute left-4 top-3 rounded-full bg-[#0e1118]/80 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[.14em] text-[var(--primary)]\">0<!-- -->4</span></div><div class=\"flex flex-1 flex-col p-6\"><div class=\"flex items-start justify-between gap-3\"><p class=\"font-mono text-[10px] uppercase tracking-[.14em] text-white/45\">Advanced Telemetry</p><span class=\"shrink-0 rounded-full border px-2.5 py-1 font-mono text-[9px] uppercase tracking-[.12em] border-[var(--primary)]/30 bg-[var(--primary)]/[.08] text-[var(--primary)]\">AVAILABLE</span></div><h3 class=\"mt-4 font-heading text-xl leading-tight transition-colors duration-300 ease-out group-hover:text-[var(--primary)]\">MOTION AND SENSOR KIT</h3><p class=\"mt-3 flex-1 text-[15px] leading-6 text-[var(--muted-foreground)]\">Full-body spatial tracking and environmental sensor fusion for comprehensive egocentric data.</p></div></article></div><div class=\"mt-10\"><a class=\"inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[var(--primary)] px-6 py-3 text-[15px] font-semibold uppercase tracking-[.04em] text-[var(--page-bg)] transition-all duration-300 ease-out hover:-translate-y-0.5 hover:opacity-90 hover:shadow-[0_10px_30px_-14px_var(--primary)] \" href=\"/gear\">Explore all capture gear<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></a></div></div></section><section id=\"join\" class=\"relative scroll-mt-24 overflow-hidden py-28 sm:py-36 lg:py-48\"><div aria-hidden=\"true\" class=\"absolute inset-0 bg-[radial-gradient(circle_at_50%_45%,oklch(0.82_0.21_130/.15),transparent_42%)]\"></div><div aria-hidden=\"true\" class=\"absolute inset-0 opacity-[.025] [background-image:url(&#x27;data:image/svg+xml,%3Csvg_viewBox=%220_0_120_120%22_xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter_id=%22n%22%3E%3CfeTurbulence_type=%22fractalNoise%22_baseFrequency=%22.9%22_numOctaves=%224%22_stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect_width=%22100%25%22_height=%22100%25%22_filter=%22url(%23n)%22_opacity=%22.6%22/%3E%3C/svg%3E&#x27;)]\"></div><div class=\"mx-auto w-full max-w-[1440px] px-5 sm:px-8 lg:px-12 xl:px-16 relative text-center\"><p class=\"font-mono text-[12px] uppercase tracking-[.2em] text-[var(--primary)]\">Registration / Phase 1</p><h2 class=\"mx-auto mt-6 max-w-5xl font-display text-[clamp(3rem,7vw,7.8rem)] font-bold uppercase leading-[.9] tracking-[-.06em]\">The first DigiRobotics campaigns are coming.</h2><p class=\"mx-auto mt-7 max-w-2xl text-[19px] leading-[1.5] text-[var(--muted-foreground)] lg:text-[21px]\">Register now to contribute first-person data, request a custom campaign, or receive marketplace launch updates.</p><div class=\"mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row\"><button type=\"button\" class=\"inline-flex min-h-13 items-center justify-center rounded-full bg-[var(--primary)] px-7 py-3 text-[15px] font-semibold uppercase tracking-[.04em] text-[var(--page-bg)] transition-all duration-300 ease-out hover:-translate-y-0.5 hover:opacity-90 hover:shadow-[0_10px_30px_-14px_var(--primary)]\">Join as a contributor ↗</button><a class=\"inline-flex min-h-12 items-center justify-center gap-2 rounded-full bo