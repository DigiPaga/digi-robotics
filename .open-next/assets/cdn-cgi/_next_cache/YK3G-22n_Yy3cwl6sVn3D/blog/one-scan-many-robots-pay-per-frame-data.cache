",{\"children\":[[\"$\",\"main\",null,{\"className\":\"min-h-screen bg-[var(--page-bg)] text-white\",\"children\":[[\"$\",\"$L2\",null,{}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BlogPosting\\\",\\\"headline\\\":\\\"One Scan, Many Robots: Pay-Per-Frame Data\\\",\\\"description\\\":\\\"A new gold standard in physical AI research shows that capturing a real environment once can be repurposed endlessly into simulation environments, robot trajectories, and training data. Stablecoin micropayments remove the fee floor, making per-request data commerce viable.\\\",\\\"datePublished\\\":\\\"2026-11-20\\\",\\\"dateModified\\\":\\\"2026-11-20\\\",\\\"author\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"DigiRobotics Team\\\"},\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"DigiRobotics\\\",\\\"url\\\":\\\"https://digirobotics.xyz\\\"},\\\"mainEntityOfPage\\\":\\\"https://digirobotics.xyz/blog/one-scan-many-robots-pay-per-frame-data\\\",\\\"image\\\":\\\"https://digirobotics.xyz/images/blog/one-scan-many-robots-pay-per-frame-data-cover.jpg\\\"}\"}}],[\"$\",\"article\",null,{\"children\":[[\"$\",\"header\",null,{\"className\":\"relative overflow-hidden border-b border-white/10\",\"children\":[[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute inset-0 opacity-25 [background-image:radial-gradient(oklch(from_var(--primary)_l_c_h_/_24%)_1px,transparent_1px)] [background-size:22px_22px]\"}],[\"$\",\"div\",null,{\"className\":\"relative mx-auto max-w-5xl px-5 pb-16 pt-12 sm:px-8 sm:pb-24 sm:pt-16\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/blog\",\"className\":\"inline-flex min-h-11 items-center gap-2 font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--muted-foreground)] transition hover:text-[var(--primary)]\",\"children\":[[\"$\",\"$L4\",null,{\"icon\":{\"name\":\"arrow-left\",\"size\":24,\"node