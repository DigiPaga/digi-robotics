{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/[slug]/layout,_N_T_/blog/[slug]/page,_N_T_/blog/one-scan-many-robots-pay-per-frame-data"},"segmentPaths":["/_tree","/_full","/_index","/blog/$d$slug/__PAGE__"],"prefetchHints":{"hints":0,"slots":{"children":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fdigirobotics%2Fbrand%2Fdigirobotics-logo.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fdigirobotics%2Fbrand%2Fdigirobotics-logo.png&amp;w=640&amp;q=75 2x\"/><link rel=\"stylesheet\" href=\"/_next/static/css/9b6cbde999f1a60b.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/1558ad27e78fe6f2.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-feab7531448ae1d4.js\"/><script src=\"/_next/static/chunks/4bd1b696-f998cba21de05210.js\" async=\"\"></script><script src=\"/_next/static/chunks/93794-e8109c8d2fd3ab34.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-e238e8a45519d65c.js\" async=\"\"></script><script src=\"/_next/static/chunks/66609-81fc326aefa2b35a.js\" async=\"\"></script><script src=\"/_next/static/chunks/17112-6d02a7878e38f17b.js\" async=\"\"></script><script src=\"/_next/static/chunks/96048-94353edf3fef0226.js\" async=\"\"></script><script src=\"/_next/static/chunks/37024-473db45fa25438c6.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-9ceac550056e754f.js\" async=\"\"></script><script src=\"/_next/static/chunks/99489-7b4b74c1a59849db.js\" async=\"\"></script><script src=\"/_next/static/chunks/5772-2ad3d6bb0136fa62.js\" async=\"\"></script><script src=\"/_next/static/chunks/57304-ca98254065b92130.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/error-f0666043f78adcc8.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/blog/%5Bslug%5D/page-a38ec015cb873e3f.js\" async=\"\"></script><title>One Scan, Many Robots: Pay-Per-Frame Data — DigiRobotics</title><meta name=\"description\" content=\"A new gold standard in physical AI research shows that capturing a real environment once can be repurposed endlessly into simulation environments, robot trajectories, and training data. Stablecoin micropayments remove the fee floor, making per-request data commerce viable.\"/><link rel=\"manifest\" href=\"/manifest.webmanifest\"/><link rel=\"canonical\" href=\"https://digirobotics.xyz/blog/one-scan-many-robots-pay-per-frame-data\"/><meta property=\"og:title\" content=\"One Scan, Many Robots: Pay-Per-Frame Data\"/><meta property=\"og:description\" content=\"A new gold standard in physical AI research shows that capturing a real environment once can be repurposed endlessly into simulation environments, robot trajectories, and training data. Stablecoin micropayments remove the fee floor, making per-request data commerce viable.\"/><meta property=\"og:url\" content=\"https://digirobotics.xyz/blog/one-scan-many-robots-pay-per-frame-data\"/><meta property=\"og:image\" content=\"https://digirobotics.xyz/images/blog/one-scan-many-robots-pay-per-frame-data-cover.jpg\"/><meta property=\"og:image:alt\" content=\"One Scan, Many Robots: Pay-Per-Frame Data\"/><meta property=\"og:type\" content=\"article\"/><meta property=\"article:published_time\" content=\"2026-11-20\"/><meta property=\"article:modified_time\" content=\"2026-11-20\"/><meta property=\"article:author\" content=\"DigiRobotics Team\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"One Scan, Many Robots: Pay-Per-Frame Data\"/><meta name=\"twitter:description\" content=\"A new gold standard in physical AI research shows that capturing a real environment once can be repurposed endlessly into simulation environments, robot trajectories, and training data. Stablecoin micropayments remove the fee floor, making per-request data commerce viable.\"/><meta name=\"twitter:image\" content=\"https://digirobotics.xyz/images/blog/one-scan-many-robots-pay-per-frame-data-cover.jpg\"/><link rel=\"icon\" href=\"/favicon.ico?63d5b2ef705d808e\" type=\"image/x-icon\" sizes=\"256x256\"/><link rel=\"icon\" href=\"/icon.png?1f3d5ce59ec9c445\" type=\"image/png\" sizes=\"1254x1254\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.png?1f3d5ce59ec9c445\" type=\"image/png\" sizes=\"1254x1254\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main-content\" class=\"sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-[var(--primary)] focus:px-5 focus:py-3 focus:text-[15px] focus:font-semibold focus:text-[var(--page-bg)]\">Skip to content</a><noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript><script type=\"application/ld+json\">[{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"DigiRobotics\",\"url\":\"https://digirobotics.xyz\",\"logo\":\"https://digirobotics.xyz/digirobotics/brand/digirobotics-logo.png\",\"description\":\"Egocentric data for robotics training, captured through human eyes.\"},{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"DigiRobotics.xyz\",\"url\":\"https://digirobotics.xyz\"}]</script><div id=\"main-content\"><main class=\"min-h-screen bg-[var(--page-bg)] text-white\"><header class=\"sticky top-0 z-50 border-b border-white/[.08] bg-[#141923]/95 backdrop-blur-lg\"><nav aria-label=\"Primary navigation\" class=\"mx-auto flex h-[76px] max-w-[1440px] items-center gap-6 px-5 sm:px-8 lg:px-12 xl:px-16\"><a aria-label=\"DigiRobotics home\"