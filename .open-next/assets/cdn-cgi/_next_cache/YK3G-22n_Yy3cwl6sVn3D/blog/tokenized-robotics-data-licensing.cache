meRequest\":\"$@21\"}\n22:I[38437,[\"99489\",\"static/chunks/99489-7b4b74c1a59849db.js\",\"5772\",\"static/chunks/5772-2ad3d6bb0136fa62.js\",\"57304\",\"static/chunks/57304-ca98254065b92130.js\",\"95953\",\"static/chunks/app/blog/%5Bslug%5D/page-a38ec015cb873e3f.js\"],\"Image\"]\n27:I[90484,[],\"OutletBoundary\"]\n28:\"$Sreact.suspense\"\n2a:I[90484,[],\"ViewportBoundary\"]\n2b:I[90484,[],\"MetadataBoundary\"]\n2c:I[86869,[],\"IconMark\"]\n2d:I[57121,[],\"\"]\n2e:I[74581,[],\"\"]\n5:[\"$\",\"p\",\"p-1\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"font-semibold text-white\",\"children\":\"Tokenized robotics training data designed to generate licensing revenue.\"}],\" That sentence describes an intention and a commercial mechanism—not a guaranteed return.\"]}]\n6:[\"$\",\"h2\",\"h2-0\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Separate the layers\"}]\n7:[\"$\",\"p\",\"p-2\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Clear systems keep four concepts distinct:\"}]\n8:[\"$\",\"div\",\"table-0\",{\"className\":\"my-9 overflow-x-auto rounded-2xl border border-white/10\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full border-collapse text-left text-[15px]\",\"children\":[[\"$\",\"thead\",\"thead-0\",{\"className\":\"bg-white/[0.05] font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--primary)]\",\"children\":[\"$\",\"tr\",\"tr-0\",{\"children\":[[\"$\",\"th\",\"th-0\",{\"className\":\"border-b border-white/10 px-5 py-4 font-medium\",\"children\":\"Layer\"}],[\"$\",\"th\",\"th-1\",{\"className\":\"border-b border-white/10 px-5 py-4 font-medium\",\"children\":\"What it establishes\"}]]}]}],[\"$\",\"tbody\",\"tbody-0\",{\"children\":[[\"$\",\"tr\",\"tr-0\",{\"children\":[[\"$\",\"td\",\"td-0\",{\"className\":\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_&]:border-b-0\",\"children\":\"Media\"}],[\"$\",\"td\",\"td-1\",{\"className\":\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_&]:border-b-0\",\"children\":\"The video, sensor stream, annotations, or derived dataset\"}]]}],[\"$\",\"tr\",\"tr-1\",{\"children\":[[\"$\",\"td\",\"td-0\",{\"className\":\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_&]:border-b-0\",\"children\":\"Provenance\"}],[\"$\",\"td\",\"td-1\",{\"className\":\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_&]:border-b-0\",\"children\":\"Who captured, reviewed, and registered the material\"}]]}],[\"$\",\"tr\",\"tr-2\",{\"children\":[[\"$\",\"td\",\"td-0\",{\"className\":\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_&]:border-b-0\",\"children\":\"License\"}],[\"$\",\"td\",\"td-1\",{\"className\":\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_&]:border-b-0\",\"children\":\"Which uses are permitted, for whom, and for how long\"}]]}],[\"$\",\"tr\",\"tr-3\",{\"children\":[[\"$\",\"td\",\"td-0\",{\"className\":\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_&]:border-b-0\",\"children\":\"Revenue\"}],[\"$\",\"td\",\"td-1\",{\"className\":\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_&]:border-b-0\",\"children\":\"Payment from a verified purchase or licensing agreement\"}]]}]]}]]}]}]\n9:[\"$\",\"p\",\"p-3\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"A token may point to or help administer these records. It does not make an ambiguous license clear, prove the quality of the media, or cause customers to appear.\"}]\na:[\"$\",\"h2\",\"h2-1\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Where revenue can come from\"}]\nb:[\"$\",\"p\",\"p-4\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Licensing revenue requires an actual transaction: a robotics team purchases access, a marketplace order completes, or an implemented distribution mechanism allocates proceeds under disclosed rules.\"}]\nc:[\"$\",\"p\",\"p-5\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Without one of those events, there is no revenue to distribute. Language about future earnings should remain conditional and should explain the underlying demand, costs, and rights.\"}]\nd:[\"$\",\"h2\",\"h2-2\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Provenance still needs evidence\"}]\ne:[\"$\",\"p\",\"p-6\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"An immutable record can preserve a claim. It cannot make a false claim true.\"}]\nf:[\"$\",\"p\",\"p-7\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Strong provenance starts before tokenization with contributor consent, capture specifications, timestamps, review records, and content hashes. The digital asset should reference that evidence without exposing private material or personal information publicly.\"}]\n10:[\"$\",\"h2\",\"h2-3\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"A useful standard for readers\"}]\n11:[\"$\",\"p\",\"p-8\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"When evaluating a tokenized dataset, ask three questions:\"}]\n12:[\"$\",\"ol\",\"ol-0\",{\"className\":\"my-6 list-decimal space-y-3 pl-7 text-base leading-relaxed text-[var(--muted-foreground)] marker:font-mono marker:text-[var(--primary)]\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"node\":{\"type\":\"element\",\"tagName\":\"li\",\"properties\":{},\"children\":[{\"type\":\"text\",\"value\":\"What exact rights does the holder receive?\",\"position\":{\"start\":{\"line\":34,\"column\":4,\"offset\":1851},\"end\":{\"line\":34,\"column\":46,\"offset\":1893}}}],\"position\":{\"start\":{\"line\":34,\"column\":1,\"offset\":1848},\"end\":{\"line\":34,\"column\":46,\"offset\":1893}}},\"className\":\"relative pl-6 text-base leading-relaxed before:absolute before:left-0 before:top-[0.72em] before:size-1.5 before:rounded-full before:bg-[var(--primary)]\",\"children\":\"What exact rights does the holder receive?\"}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"node\":{\"type\":\"element\",\"tagName\":\"li\",\"properties\":{},\"children\":[{\"type\":\"text\",\"value\":\"What evidence connects the asset to the underlying data?\",\"position\":{\"start\":{\"line\":35,\"column\":4,\"offset\":1897},\"end\":{\"line\":35,\"column\":60,\"offset\":1953}}}],\"position\":{\"start\":{\"line\":35,\"column\":1,\"offset\":1894},\"end\":{\"line\":35,\"column\":60,\"offset\":1953}}},\"className\":\"relative pl-6 text-base leading-relaxed before:absolute before:left-0 before:top-[0.72em] before:size-1.5 before:rounded-full before:bg-[var(--primary)]\",\"children\":\"What evidence connects the asset to the underlying data?\"}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"node\":{\"type\":\"element\",\"tagName\":\"li\",\"properties\":{},\"children\":[{\"type\":\"text\",\"value\":\"What implemented event produces revenue, if any?\",\"position\":{\"start\":{\"line\":36,\"column\":4,\"offset\":1957},\"end\":{\"line\":36,\"column\":52,\"offset\":2005}}}],\"position\":{\"start\":{\"line\":36,\"column\":1,\"offset\":1954},\"end\":{\"line\":36,\"column\":52,\"offset\":2005}}},\"className\":\"relative pl-6 text-base leading-relaxed before:absolute before:left-0 before:top-[0.72em] before:size-1.5 before:rounded-full before:bg-[var(--primary)]\",\"children\":\"What implemented event produces revenue, if any?\"}],\"\\n\"]}]\n13:[\"$\",\"p\",\"p-9\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"If those answers are missing, the token is a label—not a licensing business.\"}]\n14:[\"$\",\"div\",null,{\"className\":\"mt-16 border-t border-white/10 pt-8\",\"children\":[\"$\",\"$L3\",null,{\"href\":\"/blog\",\"className\":\"inline-flex min-h-11 items-center gap-2 rounded-full border border-white/15 px-5 py-3 text-[14px] font-semibold transition hover:border-[var(--primary)] hover:text-[var(--primary)]\",\"children\":[[\"$\",\"$L4\",null,{\"icon\":\"$0:data:0:rsc:props:children:0:props:children:2:props:children:0:props:children:1:props:children:0:props:children:0:props:icon\",\"size\":16,\"aria-hidden\":\"true\"}],\" Return to the archive\"]}]}]\n15:[\"$\",\"footer\",null,{\"className\":\"border-t border-white/[.08] bg-[#111620] py-12\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full max-w-[1440px] px-5 sm:px-8 lg:px-12 xl:px-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-10 lg:grid-cols-[1fr_auto] lg:items-start\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"$L22\",null,{\"src\":\"/digirobotics/brand/digirobotics-logo.png\",\"alt\":\"DigiRobotics.xyz\",\"width\":210,\"height\":48,\"className\":\"h-auto w-[190px]\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-[17px] text-white/60\",\"children\":\"Egocentric data for robotics training.\"}]]}],[\"$\",\"nav\",null,{\"aria-label\":\"Footer navigation\",\"className\":\"flex max-w-2xl flex-wrap gap-x-7 gap-y-3\",\"children\":[[\"$\",\"a\",\"Contributor\",{\"href\":\"/#contributors\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:ab