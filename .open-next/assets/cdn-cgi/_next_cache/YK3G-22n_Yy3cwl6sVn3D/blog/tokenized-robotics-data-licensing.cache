{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/[slug]/layout,_N_T_/blog/[slug]/page,_N_T_/blog/tokenized-robotics-data-licensing"},"segmentPaths":["/_tree","/_full","/_index","/blog/$d$slug/__PAGE__"],"prefetchHints":{"hints":0,"slots":{"children":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fdigirobotics%2Fbrand%2Fdigirobotics-logo.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fdigirobotics%2Fbrand%2Fdigirobotics-logo.png&amp;w=640&amp;q=75 2x\"/><link rel=\"stylesheet\" href=\"/_next/static/css/9b6cbde999f1a60b.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/1558ad27e78fe6f2.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-feab7531448ae1d4.js\"/><script src=\"/_next/static/chunks/4bd1b696-f998cba21de05210.js\" async=\"\"></script><script src=\"/_next/static/chunks/93794-e8109c8d2fd3ab34.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-e238e8a45519d65c.js\" async=\"\"></script><script src=\"/_next/static/chunks/66609-81fc326aefa2b35a.js\" async=\"\"></script><script src=\"/_next/static/chunks/17112-6d02a7878e38f17b.js\" async=\"\"></script><script src=\"/_next/static/chunks/96048-94353edf3fef0226.js\" async=\"\"></script><script src=\"/_next/static/chunks/37024-473db45fa25438c6.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-9ceac550056e754f.js\" async=\"\"></script><script src=\"/_next/static/chunks/99489-7b4b74c1a59849db.js\" async=\"\"></script><script src=\"/_next/static/chunks/5772-2ad3d6bb0136fa62.js\" async=\"\"></script><script src=\"/_next/static/chunks/57304-ca98254065b92130.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/error-f0666043f78adcc8.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/blog/%5Bslug%5D/page-a38ec015cb873e3f.js\" async=\"\"></script><title>Tokenization is provenance—not automatic yield — DigiRobotics</title><meta name=\"description\" content=\"A precise framework for using digital assets to represent robotics data rights without confusing ownership records with revenue.\"/><link rel=\"manifest\" href=\"/manifest.webmanifest\"/><link rel=\"canonical\" href=\"https://digirobotics.xyz/blog/tokenized-robotics-data-licensing\"/><meta property=\"og:title\" content=\"Tokenization is provenance—not automatic yield\"/><meta property=\"og:description\" content=\"A precise framework for using digital assets to represent robotics data rights without confusing ownership records with revenue.\"/><meta property=\"og:url\" content=\"https://digirobotics.xyz/blog/tokenized-robotics-data-licensing\"/><meta property=\"og:type\" content=\"article\"/><meta property=\"article:published_time\" content=\"2026-09-17\"/><meta property=\"article:modified_time\" content=\"2026-09-21\"/><meta property=\"article:author\" content=\"DigiRobotics Research\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Tokenization is provenance—not automatic yield\"/><meta name=\"twitter:description\" content=\"A precise framework for using digital assets to represent robotics data rights without confusing ownership records with revenue.\"/><link rel=\"icon\" href=\"/favicon.ico?63d5b2ef705d808e\" type=\"image/x-icon\" sizes=\"256x256\"/><link rel=\"icon\" href=\"/icon.png?1f3d5ce59ec9c445\" type=\"image/png\" sizes=\"1254x1254\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.png?1f3d5ce59ec9c445\" type=\"image/png\" sizes=\"1254x1254\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><di