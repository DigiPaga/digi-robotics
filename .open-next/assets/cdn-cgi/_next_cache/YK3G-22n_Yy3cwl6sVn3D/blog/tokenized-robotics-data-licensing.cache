\":\\\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_\\u0026]:border-b-0\\\",\\\"children\\\":\\\"Media\\\"}],[\\\"$\\\",\\\"td\\\",\\\"td-1\\\",{\\\"className\\\":\\\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_\\u0026]:border-b-0\\\",\\\"children\\\":\\\"The video, sensor stream, annotations, or derived dataset\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"tr-1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"td-0\\\",{\\\"className\\\":\\\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_\\u0026]:border-b-0\\\",\\\"children\\\":\\\"Provenance\\\"}],[\\\"$\\\",\\\"td\\\",\\\"td-1\\\",{\\\"className\\\":\\\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_\\u0026]:border-b-0\\\",\\\"children\\\":\\\"Who captured, reviewed, and registered the material\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"tr-2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"td-0\\\",{\\\"className\\\":\\\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_\\u0026]:border-b-0\\\",\\\"children\\\":\\\"License\\\"}],[\\\"$\\\",\\\"td\\\",\\\"td-1\\\",{\\\"className\\\":\\\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_\\u0026]:border-b-0\\\",\\\"children\\\":\\\"Which uses are permitted, for whom, and for how long\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"tr-3\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"td-0\\\",{\\\"className\\\":\\\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_\\u0026]:border-b-0\\\",\\\"children\\\":\\\"Revenue\\\"}],[\\\"$\\\",\\\"td\\\",\\\"td-1\\\",{\\\"className\\\":\\\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_\\u0026]:border-b-0\\\",\\\"children\\\":\\\"Payment from a ver