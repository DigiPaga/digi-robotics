-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\">Capture Gear</a><a href=\"/blog\" class=\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\">Articles</a><a href=\"/agent-demo\" class=\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\">Agent Demo</a><a href=\"/#privacy-note\" class=\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\">Privacy &amp; Terms</a><a href=\"mailto:hello@digirobotics.xyz\" class=\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\">Contact Us</a></nav></div><div id=\"privacy-note\" class=\"mt-10 grid gap-4 border-t border-white/[.08] pt-6 text-[13px] leading-5 text-white/45 sm:grid-cols-[1fr_auto]\"><p>Privacy and terms notices will be published before campaign enrollment or data collection begins. Contact the team for Phase 1 information.</p><p>© 2026 DigiRobotics</p></div><div class=\"mt-6 flex items-center gap-4 text-white/45\"><a href=\"#\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/45 hover:text-white transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-x\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"></path><path d=\"m6 6 12 12\"></path></svg></a><a href=\"#\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-white/45 hover:text-white transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail\" aria-hidden=\"true\"><path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"></path><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"></rect></svg></a></div><p class=\"mt-5 font-mono text-[10px] uppercase tracking-[.12em] text-white/35\">Agent-compatible payment workflows powered by stablecoins and x402. Phase 1 infrastructure.</p></div></footer></main><!--$--><!--/$--></div><section aria-label=\"DigiRobotics notifications alt+T\" tabindex=\"-1\" aria-live=\"polite\" aria-relevant=\"additions text\" aria-atomic=\"false\" data-react-aria-top-layer=\"true\"></section><script src=\"/_next/static/chunks/webpack-feab7531448ae1d4.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n3:I[60203,[\\\"66609\\\",\\\"static/chunks/66609-81fc326aefa2b35a.js\\\",\\\"17112\\\",\\\"static/chunks/17112-6d02a7878e38f17b.js\\\",\\\"96048\\\",\\\"static/chunks/96048-94353edf3fef0226.js\\\",\\\"37024\\\",\\\"static/chunks/37024-473db45fa25438c6.js\\\",\\\"7177\\\",\\\"static/chunks