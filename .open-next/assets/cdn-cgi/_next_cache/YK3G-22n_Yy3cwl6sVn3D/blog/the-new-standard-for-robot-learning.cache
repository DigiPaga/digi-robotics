6\"]}]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[170px_minmax(0,760px)] lg:justify-center\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"hidden lg:block\",\"children\":[\"$\",\"div\",null,{\"className\":\"sticky top-28 border-t border-[var(--primary)] pt-4 font-mono text-[9px] uppercase leading-5 tracking-[0.15em] text-[var(--muted-foreground)]\",\"children\":[\"DigiRobotics\",\"$L5\",\"Field note\",\"$L6\",\"2026.11.20\"]}]}],\"$L7\"]}]]}],\"$L8\"]}],null,\"$L9\"]}],\"isPartial\":\"$@a\",\"staleTime\":\"$b\",\"varyParams\":null},{\"rsc\":\"$Lc\",\"isPartial\":\"$@d\",\"staleTime\":\"$b\",\"varyParams\":null},{\"rsc\":\"$Le\",\"isPartial\":\"$@f\",\"staleTime\":\"$b\",\"varyParams\":\"$10\"},{\"rsc\":\"$L11\",\"isPartial\":\"$@12\",\"staleTime\":\"$b\",\"varyParams\":\"$10\"}],\"isUpgradeableISRFallback\":false,\"a\":\"$@13\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@14\"}\n25:I[38437,[\"99489\",\"static/chunks/99489-7b4b74c1a59849db.js\",\"5772\",\"static/chunks/5772-2ad3d6bb0136fa62.js\",\"57304\",\"static/chunks/57304-ca98254065b92130.js\",\"95953\",\"static/chunks/app/blog/%5Bslug%5D/page-a38ec015cb873e3f.js\"],\"Image\"]\n2a:I[90484,[],\"OutletBoundary\"]\n2b:\"$Sreact.suspense\"\n2d:I[90484,[],\"ViewportBoundary\"]\n2e:I[90484,[],\"MetadataBoundary\"]\n2f:I[86869,[],\"IconMark\"]\n30:I[57121,[],\"\"]\n31:I[74581,[],\"\"]\n5:[\"$\",\"br\",null,{}]\n6:[\"$\",\"br\",null,{}]\n15:T47f,Robotics training has crossed an inflection point — third-person footage is being replaced by first-person, sensor-native data collected from the same perspective the robot occupies at deployment. Egocentric data eliminates the viewpoint mismatch: hand-object contact, gaze direction, and relative depth are all clearer from the agent's perspective. Performance evidence is overwhelming — 34% to 228% relative improvements over baselines, up to 30% gains from co-training, 54% improvement with large-scale pretraining, and more than 50% improvement from wrist-mounted views on fine-grained tasks. One hour of egocentric human data improves policy quality more than one hour of robot teleoperation data at scale. The data side demands a payment rail that can settle thousands of micro-contributions per day across multiple jurisdictions — legacy rails cannot handle that volume. The agentic payment stack provides sub-second finality, sub-cent fees, programmable conditionality, and a cross-cutting AI control plane for governance. DigiRobotics composes both stacks into one loop where contributors earn USDG the moment their footage is consumed.16:T477,The performance evidence is now overwhelming. A recent co-training study demonstrated 34 to 228 percent relative improvement in task score over state-of-the-art imitation learning baselines. A collaborative cross-institution dataset — 1,362 hours of egocentric demonstrations across 1,965 tasks, 240 scenes, and 2,087 demonstrators from multiple countries — showed up to 30 percent relative gains from co-training across multiple robots and tasks. A large-scale pretraining effort trained a vision-language-action model on more than 20,854 hours of action-labeled egocentric human video and achieved a 54 percent improvement in average success rate over a no-pretraining baseline, with a documented log-linear scaling law between human data scale and validation loss. A leading technology company released a dexterous manipulation dataset of 829 hours with three-dimensional tracking of every joint of each finger at 30 Hz across 194 tabletop tasks. Across multiple studies, adding an egocentric wrist-mounted view improves task success by more than 50 percent over third-person baselines on tasks requiring fine-grained spatial alignment.7:[\"$\",\"div\",null,{\"className\":\"min-w-0\",\"children\":[[[\"$\",\"blockquote\",\"blockquote-0\",{\"className\":\"my-10 border-l-2 border-[var(--primary)] bg-[var(--primary)]/[0.06] px-6 py-2 font-heading text-xl leading-8 text-white sm:px-8\",\"children\":[\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"font-semibold text-white\",\"children\":\"TL;DR:\"}]}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"$15\"}],\"\\n\"]}],\"\\n\",[\"$\",\"h2\",\"h2-0\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"The New Standard in Robot Training Data\"}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Robot policies trained on external camera footage must compensate for the viewpoint difference between training data and the sensor stream at deployment. This shows up as brittleness when camera angles change, object positions shift, or when spatial precision exceeds what external viewpoints can convey. Egocentric data eliminates this mismatch by collecting data from the same perspective the robot's camera occupies at deployment.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"$16\"}],\"\\n\",\"$L17\",\"\\n\",\"$L18\",\"\\n\",\"$L19\",\"\\n\",\"$L1a\",\"\\n\",\"$L1b\",\"\\n\",\"$L1c\",\"\\n\",\"$L1d\",\"\\n\",\"$L1e\",\"\\n\",\"$L1f\",\"\\n\",\"$L20\",\"\\n\",\"$L21\",\"\\n\",\"$L22\",\"\\n\",\"$L23\"],\"$L24\"]}]\n8:[\"$\",\"footer\",null,{\"className\":\"border-t border-white/[.08] bg-[#111620] py-12\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full max-w-[1440px] px-5 sm:px-8 lg:px-12 xl:px-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-10 lg:grid-cols-[1fr_auto] lg:items-start\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"$L25\",null,{\"src\":\"/digirobotics/brand/digirobotics-logo.png\",\"alt\":\"DigiRobotics.xyz\",\"width\":210,\"height\":48,\"className\":\"h-auto w-[190px]\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-[17px] text-white/60\",\"children\":\"Egocentric data for robotics training.\"}]]}],[\"$\",\"nav\",null,{\"aria-label\":\"Footer navigation\",\"className\":\"flex max-w-2xl flex-wrap gap-x-7 gap-y-3\",\"children\":[[\"$\",\"a\",\"Contributor\",{\"href\":\"/#contributors\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Contributor\"}],[\"$\",\"a\",\"Marketplace\",{\"href\":\"/#marketplace\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Marketplace\"}],[\"$\",\"a\",\"Custom Data\",{\"href\":\"/#custom-data\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Custom Data\"}],[\"$\",\"a\",\"Capture Gear\",{\"href\":\"/gear\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Capture Gear\"}],[\"$\",\"a\",\"Articles\",{\"href\":\"/blog\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Articles\"}],[\"$\",\"a\",\"Agent Demo\",{\"href\":\"/agent-demo\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Agent Demo\"}],[\"$\",\"a\",\"Privacy & Terms\",{\"href\":\"/#privacy-note\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Privacy & Terms\"}],\"$L26\"]}]]}],\"$L27\",\"$L28\",\"$L29\"]}]}]\n9:[\"$\",\"$L2a\",null,{\"children\":[\"$\",\"$2b\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@2c\"}]}]\nc:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L2d\",null,{\"children\":[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L2e\",null,{\"children\":[\"$\",\"$2b\",null,{\"name\":\"Next.Metadata\",\"children\":[[\"$\",\"title\",\"0\",{\"children\":\"The New Standard for Robot Learning — DigiRobotics\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"First-person training data and autonomous stablecoin settlement are becoming the foundation of embodied intelligence — the new standard in robot learning requires egocentric datasets at scale and a payment rail that can pay thousands of contributors instantly.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.webmanifest\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"https://digirobotics.xyz/blog/the-new-standard-for-robot-learning\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:title\",\"content\":\"The New Standard for Robot Learning\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:description\",\"content\":\"First-person training data and autonomous stablecoin settlement are becoming the foundation of embodied intelligence — the new standard in robot learning requires egocentric datasets at scale and a payment rail that can pay thousands of contributors instantly.\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:url\",\"content\":\"https://digirobotics.xyz/blog/the-new-standard-for-robot-learning\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image\",\"content\":\"https://digirobotics.xyz/images/blog/the-new-standard-for-robot-learning-cover.jpg\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:image:alt\",\"content\":\"The New Standard for Robot Learning\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"10\",{\"property\":\"article:published_time\",\"content\":\"2026-11-20\"}],[\"$\",\"meta\",\"11\",{\"property\":\"article:modified_time\",\"content\":\"2026-11-20\"}],[\"$\",\"meta\",\"12\",{\"property\":\"article:author\",\"content\":\"DigiRobotics Team\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:title\",\"content\":\"The New Standard for Robot Learning\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:description\",\"content\":\"First-person training data and autonomous stablecoin settlement are becoming the foundation of embodied intelligence — the new standard in robot learning requires egocentric datasets at scale and a payment rail that can pay thousands of contributors instantly.\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:image\",\"content\":\"https://digirobotics.xyz/images/blog/the-new-standard-for-robot-learning-cover.jpg\"}],[\"$\",\"link\",\"17\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?63d5b2ef705d808e\",\"type\":\"image/x-icon\",\"sizes\":\"256x256\"}],[\"$\",\"link\",\"18\",{\"rel\":\"icon\",\"href\":\"/icon.png?1f3d5ce59ec9c445\",\"type\":\"image/png\",\"sizes\":\"1254x1254\"}],[\"$\",\"link\",\"19\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-icon.png?1f3d5ce59ec9c445\",\"type\":\"image/png\",\"sizes\":\"1254x1254\"}],[\"$\",\"$L2f\",\"20\",{}]]}]}]}],null]}]\ne:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L30\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L31\",null,{}]}]]}]\n11:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L30\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L31\",null,{}]}]]}]\n14:true\n17:[\"$\",\"p\",\"p-2\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"What egocentric data captures that external cameras cannot is significant. Hand-object contact is clearer from the agent's perspective because hands are closer to the camera and less likely to be occluded by the robot's own body. Gaze direction — where the demonstrator is looking — is only accessible from head-mounted or wrist-mounted cameras. Relative depth and proximity between the end-effector and a target object are more accurately represented from the robot's own viewpoint than from a ceiling camera. And first-person capture is a first-class input — one additional hour of egocentric human data improves policy quality more than one additional hour of robot teleoperation data at scale, establishing it as more than a cheaper substitute.\"}]\n18:[\"$\",\"h2\",\"h2-1\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"The Settlement Layer That Makes It Economic\"}]\n19:[\"$\",\"p\",\"p-3\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The new standard in robot training data implies a corresponding standard in payment infrastructure. If the dataset scaling laws hold, a 20,000-hour egocentric corpus requires roughly 200 contributors producing 100 approved hours each, across multiple countries, each generating dozens of micro-transactions over the project lifecycle. A traditional procurement flow — invoice, approval, batch payment, 30-day settlement — collapses under the weight of that volume.\"}]\n1a:[\"$\",\"p\",\"p-4\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The agentic payment stack now being standardized across the financial industry provides the alternative. It is structured as a five-layer stack. The settlement layer uses high-throughput blockchains where stablecoin transfers reach deterministic finality in sub-seconds. The token layer uses USD-pegged stablecoins providing programmable medium of exchange with 24/7 operation and sub-cent fees. The protocol layer includes open standards including an HTTP-native agentic payment protocol that repurposes the HTTP \\\"Payment Required\\\" status code for machine-to-machine payments directly inside API calls; an agent payments protocol backed by a coalition of more than 60 banks and tech firms providing Authorization, Authenticity, and Accountability primitives; and a universal commerce protocol standardizing merchant discovery. The application layer includes AI agents, marketplaces, and procurement workflows. And the identity and authorization layer uses verifiable credentials and mandate frameworks.\"}]\n1b:[\"$\",\"p\",\"p-5\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Underneath all five layers runs a cross-cutting AI control plane — the missing piece identified in recent industry research — providing spending limits, counterparty allowlists, escalation thresholds, and auditability that spans every layer horizontally rather than living in any one. The control plane is what makes agentic commerce safe enough to operate at the volume and frequency that distributed data contribution requires.\"}]\n1c:[\"$\",\"p\",\"p-6\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"USD-pegged stablecoins already process roughly $27 trillion in annual transaction volume, and federal stablecoin legislation has removed the largest institutional barrier to adoption. Industry analyses project US business-to-consumer orchestrated revenue from agentic commerce at up to $1 trillion by 2030, with global projections ranging from $3T to $5T. The defining properties — deterministic finality, 24/7 operation, programmable conditionality — are not features legacy fiat ledgers provide natively, and they are the precise properties that paying distributed egocentric data contributors at scale requires.\"}]\n1d:[\"$\",\"h2\",\"h2-2\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Why the Two Stacks Are Co-Dependent\"}]\n1e:[\"$\",\"p\",\"p-7\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The new standard in robot training data and the agentic payment stack are usually discussed in separate communities. They are, in fact, the same problem viewed from two angles.\"}]\n1f:[\"$\",\"p\",\"p-8\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The data side demands a payment rail that can settle thousands of micro-contributions per day across multiple jurisdictions without correspondent banking delays or fees that exceed the transaction value. The payment side demands real-world tasks to settle around — and the richest, most under-monetized category of real-world task data is first-person human activity, the manipulation, locomotion, and tool use that robotics labs are desperate to acquire.\"}]\n20:[\"$\",\"p\",\"p-9\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The complementarity between human egocentric data and robot teleoperation data is now well established: use first-person human data to bootstrap new tasks and cover environmental diversity, use teleoperation to calibrate the final policy to specific robot hardware. The same complementarity holds at the infrastructure level: use the egocentric data layer to scale training signal, use the agentic payment layer to scale contributor payouts. Neither works alone. Together they unlock a closed loop that finally makes the new standard in robot learning economically viable at planetary scale.\"}]\n21:[\"$\",\"h2\",\"h2-3\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Conclusion\"}]\n22:[\"$\",\"p\",\"p-10\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"DigiRobotics is the world's first stablecoin-native marketplace for agentic commerce in real-world robotics data — purpose-built at the intersection of these two stacks. Contributors capture egocentric footage of physical tasks using accessible wearable devices; that data is tokenized and listed on the marketplace, where AI agents, robotics labs, and humanoid developers procure it programmatically. Settlement runs over an HTTP-native agentic payment protocol in USDG stablecoins on a high-performance Layer-2 network, with a cross-cutting control plane governing spending limits, counterparty allowlists, and auditability for every transaction.\"}]\n23:[\"$\",\"p\",\"p-11\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"By composing the agentic payment rail directly with the egocentric contribution pipeline, DigiRobotics operationalizes the new standard in robot learning at the scale the scaling laws demand. Everyday users earn USDG for first-person capture; autonomous agents purchase that data around the clock; Physical AI policies improve with every doubling of human demonstration hours, exactly as the documented log-linear law predicts. The new standard in training data meets the new standard in settlement — finally wired together as one loop.\"}]\n24:[\"$\",\"div\",null,{\"className\":\"mt-16 border-t border-white/10 pt-8\",\"children\":[\"$\",\"$L3\",null,{\"href\":\"/blog\",\"className\":\"inline-flex min-h-11 items-center gap-2 rounded-full border border-white/15 px-5 py-3 text-[14px] font-semibold transition hover:border-[var(--primary)] hover:text-[var(--primary)]\",\"children\":[[\"$\",\"$L4\",null,{\"icon\":\"$0:data:0:rsc:props:children:0:props:children:2:props:children:0:props:children:1:props:children:0:props:children:0:props:icon\",\"size\":16,\"aria-hidden\":\"true\"}],\" Return to the archive\"]}]}]\n26:[\"$\",\"a\",\"Contact Us\",{\"href\":\"mailto:hello@digirobotics.xyz\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Contact Us\"}]\n27:[\"$\",\"div\",null,{\"id\":\"privacy-note\",\"className\":\"mt-10 grid gap-4 border-t border-white/[.08] pt-6 text-[13px] leading-5 text-white/45 sm:grid-cols-[1fr_auto]\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Privacy and terms notices will be published before campaign enrollment or data collection begins. Contact the team for Phase 1 information.\"}],[\"$\",\"p\",null,{\"children\":\"© 2026 DigiRobotics\"}]]}]\n28:[\"$\",\"div\",null,{\"className\":\"mt-6 flex items-center gap-4 text-white/45\",\"children\":[[\"$\",\"a\",null,{\"href\":\"#\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-white/45 hover:text-white transition-colors\",\"children\":[\"$\",\"$L4\",null,{\"icon\":{\"name\":\"x\",\"size\":24,\"node\":[[\"path\",{\"d\":\"M18 6 6 18\",\"key\":\"1bl5f8\"}],[\"path\",{\"d\":\"m6 6 12 12\",\"key\":\"d8bk6v\"}]]},\"size\":18,\"aria-hidden\":\"true\"}]}],[\"$\",\"a\",null,{\"href\":\"#\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-white/45 hover:text-white transition-colors\",\"children\":[\"$\",\"$L4\",null,{\"icon\":{\"name\":\"mail\",\"size\":24,\"node\":[[\"path\",{\"d\":\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\",\"key\":\"132q7q\"}],[\"rect\",{\"x\":\"2\",\"y\":\"4\",\"width\":\"20\",\"height\":\"16\",\"rx\":\"2\",\"key\":\"izxlao\"}]]},\"size\":18,\"aria-hidden\":\"true\"}]}]]}]\n29:[\"$\",\"p\",null,{\"className\":\"mt-5 font-mono text-[10px] uppercase tracking-[.12em] text-white/35\",\"children\":\"Agent-compatible payment workflows powered by stablecoins and x402. Phase 1 infrastructure.\"}]\n2c:null\nb:300\nb:C\n13:0\nd:\"$undefined\"\nf:\"$undefined\"\n12:\"$undefined\"\na:\"$undefined\"\n"}}