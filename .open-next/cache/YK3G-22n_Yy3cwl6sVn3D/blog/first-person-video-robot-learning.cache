ine\\\":15,\\\"column\\\":46,\\\"offset\\\":954}}},\\\"className\\\":\\\"relative pl-6 text-base leading-relaxed before:absolute before:left-0 before:top-[0.72em] before:size-1.5 before:rounded-full before:bg-[var(--primary)]\\\",\\\"children\\\":\\\"consent, licensing, and privacy boundaries.\\\"}],\\\"\\\\n\\\"]}]\\n2c:[\\\"$\\\",\\\"p\\\",\\\"p-4\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"The last point is foundational. A technically valuable recording can still be unusable if the people, screens, or locations inside it were captured without an appropriate basis for use.\\\"}]\\n2d:[\\\"$\\\",\\\"h2\\\",\\\"h2-1\\\",{\\\"className\\\":\\\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\\\",\\\"children\\\":\\\"Demonstrations are not instructions\\\"}]\\n2e:[\\\"$\\\",\\\"p\\\",\\\"p-5\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"A recording shows what happened. It does not automatically explain why it happened.\\\"}]\\n2f:[\\\"$\\\",\\\"p\\\",\\\"p-6\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"Two visually similar hand movements may represent very different decisions. One person rotates a component to align a notch; another rotates it simply to see a label. Models benefit when video is paired with structured context such as task labels, object states, timestamps, and quality review.\\\"}]\\n30:[\\\"$\\\",\\\"blockquote\\\",\\\"blockquote-0\\\",{\\\"className\\\":\\\"my-10 border-l-2 border-[var(--primary)] bg-[var(--primary)]/[0.06] px-6 py-2 font-heading text-xl leading-8 text-white sm:px-8\\\",\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",\\\"p-0\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"The goal is not to collect the most footage. It is to preserve the decisions that make the footage meaningful.\\\"}],\\\"\\\\n\\\"]}]\\n31:[\\\"$\\\",\\\"h2\\\",\\\"h2-2\\\",{\\\"className\\\":\\\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\\\",\\\"children\\\":\\\"Design for evaluation\\\"}]\\n32:[\\\"$\\\",\\\"p\\\",\\\"p-7\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"A dataset should make it possible to ask whether a system improved. That means holding out environments, performers, objects, or task variations rather than measuring performance only on familiar scenes.\\\"}]\\n33:[\\\"$\\\",\\\"div\\\",\\\"table-0\\\",{\\\"className\\\":\\\"my-9 overflow-x-auto rounded-2xl border border-white/10\\\",\\\"children\\\":[\\\"$\\\",\\\"table\\\",null,{\\\"className\\\":\\\"w-full border-collapse text-left text-[15px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",\\\"thead-0\\\",{\\\"className\\\":\\\"bg-white/[0.05] font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--primary)]\\\",\\\"children\\\":[\\\"$\\\",\\\"tr\\\",\\\"tr-0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"th\\\",\\\"th-0\\\",{\\\"className\\\":\\\"border-b border-white/10 px-5 py-4 font-medium\\\",\\\"children\\\":\\\"Collection choice\\\"}],[\\\"$\\\",\\\"th\\\",\\\"th-1\\\",{\\\"className\\\":\\\"border-b border-white/10 px-5 py-4 font-medium\\\",\\\"children\\\":\\\"What it helps evaluate\\\"}]]}]}],[\\\"$\\\",\\\"tbody\\\",\\\"tbody-0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"tr\\\",\\\"tr-0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"td-0\\\",{\\\"className\\\":\\\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_\\u0026]:border-b-0\\\",\\\"children\\\":\\\"Multiple performers\\\"}],[\\\"$\\\",\\\"td\\\",\\\"td-1\\\",{\\\"className\\\":\\\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_\\u0026]:border-b-0\\\",\\\"children\\\":\\\"Variation in technique and body geometry\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"tr-1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"td-0\\\",{\\\"className\\\":\\\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_\\u0026]:border-b-0\\\",\\\"children\\\":\\\"New workspaces\\\"}],[\\\"$\\\",\\\"td\\\",\\\"td-1\\\",{\\\"className\\\":\\\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_\\u0026]:border-b-0\\\",\\\"children\\\":\\\"Robustness to layout and lighting\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"tr-2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"td-0\\\",{\\\"className\\\":\\\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_\\u0026]:border-b-0\\\",\\\"children\\\":\\\"Failed attempts\\\"}],[\\\"$\\\",\\\"td\\\",\\\"td-1\\\",{\\\"className\\\":\\\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_\\u0026]:border-b-0\\\",\\\"children\\\":\\\"Recovery and error recognition\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"tr-3\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"td-0\\\",{\\\"className\\\":\\\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_\\u0026]:border-b-0\\\",\\\"children\\\":\\\"Explicit end states\\\"}],[\\\"$\\\",\\\"td\\\",\\\"td-1\\\",{\\\"className\\\":\\\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_\\u0026]:border-b-0\\\",\\\"children\\\":\\\"Task completion and verification\\\"}]]}]]}]]}]}]\\n34:[\\\"$\\\",\\\"h2\\\",\\\"h2-3\\\",{\\\"className\\\":\\\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\\\",\\\"children\\\":\\\"From capture to a durable asset\\\"}]\\n35:[\\\"$\\\",\\\"p\\\",\\\"p-8\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foregrou