{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/[slug]/layout,_N_T_/blog/[slug]/page,_N_T_/blog/first-person-video-robot-learning"},"segmentPaths":["/_tree","/_full","/_index","/blog/$d$slug/__PAGE__"],"prefetchHints":{"hints":0,"slots":{"children":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fdigirobotics%2Fbrand%2Fdigirobotics-logo.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fdigirobotics%2Fbrand%2Fdigirobotics-logo.png&amp;w=640&amp;q=75 2x\"/><link rel=\"stylesheet\" href=\"/_next/static/css/9b6cbde999f1a60b.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/1558ad27e78fe6f2.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-feab7531448ae1d4.js\"/><script src=\"/_next/static/chunks/4bd1b696-f998cba21de05210.js\" async=\"\"></script><script src=\"/_next/static/chunks/93794-e8109c8d2fd3ab34.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-e238e8a45519d65c.js\" async=\"\"></script><script src=\"/_next/static/chunks/66609-81fc326aefa2b35a.js\" async=\"\"></script><script src=\"/_next/static/chunks/17112-6d02a7878e38f17b.js\" async=\"\"></script><script src=\"/_next/static/chunks/96048-94353edf3fef0226.js\" async=\"\"></script><script src=\"/_next/static/chunks/37024-473db45fa25438c6.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-9ceac550056e754f.js\" async=\"\"></script><script src=\"/_next/static/chunks/99489-7b4b74c1a59849db.js\" async=\"\"></script><script src=\"/_next/static/chunks/5772-2ad3d6bb0136fa62.js\" async=\"\"></script><script src=\"/_next/static/chunks/57304-ca98254065b92130.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/error-f0666043f78adcc8.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/blog/%5Bslug%5D/page-a38ec015cb873e3f.js\" async=\"\"></script><title>Why first-person video changes what robots can learn — DigiRobotics</title><meta name=\"description\" content=\"A practical look at why viewpoint, intent, and task structure matter when human activity becomes training data for embodied systems.\"/><link rel=\"manifest\" href=\"/manifest.webmanifest\"/><link rel=\"canonical\" href=\"https://digirobotics.xyz/blog/first-person-video-robot-learning\"/><meta property=\"og:title\" content=\"Why first-person video changes what robots can learn\"/><meta property=\"og:description\" content=\"A practical look at why viewpoint, intent, and task structure matter when human activity becomes training data for embodied systems.\"/><meta property=\"og:url\" content=\"https://digirobotics.xyz/blog/first-person-video-robot-learning\"/><meta property=\"og:type\" content=\"article\"/><meta property=\"article:published_time\" content=\"2026-09-30\"/><meta property=\"article:author\" content=\"DigiRobotics Research\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Why first-person video changes what robots can learn\"/><meta name=\"twitter:description\" content=\"A practical look at why viewpoint, intent, and task structure matter when human activity becomes training data for embodied systems.\"/><link rel=\"icon\" href=\"/favicon.ico?63d5b2ef705d808e\" type=\"image/x-icon\" sizes=\"256x256\"/><link rel=\"icon\" href=\"/icon.png?1f3d5ce59ec9c445\" type=\"image/png\" sizes=\"1254x1254\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.png?1f3d5ce59ec9c445\" type=\"image/png\" sizes=\"1254x1254\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main-content\" class=\"sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-[var(--primary)] focus:px-5 focus:py-3 focus:text-[15px] focus:font-semibold focus:text-[var(--page-bg)]\">Skip to content</a><noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript><script type=\"application/ld+json\">[{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"DigiRobotics\",\"url\":\"https://digirobotics.xyz\",\"logo\":\"https://digirobotics.xyz/digirobotics/brand/digirobotics-logo.png\",\"description\":\"Egocentric data for robotics training, captured through human eyes.\"},{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"DigiRobotics.xyz\",\"url\":\"https://digirobotics.xyz\"}]</script><div id=\"main-content\"><main class=\"min-h-screen bg-[var(--page-bg)] text-white\"><header class=\"sticky top-0 z-50 border-b border-white/[.08] bg-[#141923]/95 backdrop-blur-lg\"><nav aria-label=\"Primary navigation\" class=\"mx-auto flex h-[76px] max-w-[1440px] items-center gap-6 px-5 sm:px-8 lg:px-12 xl:px-16\"><a aria-label=\"DigiRobotics home\" class=\"mr-auto shrink-0\" href=\"/#top\"><img alt=\"DigiRobotics\" width=\"210\" height=\"48\" decoding=\"async\" data-nimg=\"1\" class=\"h-auto w-[168px] lg:w-[190px]\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fdigirobotics%2Fbrand%2Fdigirobotics-logo.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fdigirobotics%2Fbrand%2Fdigirobotics-logo.png&amp;w=640&amp;q=75 2x\" src=\"/_next/image?url=%2Fdigirobotics%2Fbrand%2Fdigirobotics-logo.png&amp;w=640&amp;q=75\"/></a><div class=\"hidden items-center gap-8 xl:flex\"><a class=\"shrink-0 whitespace-nowrap py-3 text-[13px] font-medium tracking-normal text-white/80 transition-colors duration-300 ease-out hover:text-[var(--primary)]\" href=\"/#contributors\">Become a contributor</a><div class=\"relative\"><button aria-expanded=\"false\" aria-controls=\"marketplace-menu\" class=\"flex min-h-11 shrink-0 items-center gap-1 whitespace-nowrap text-[13px] font-medium tracking-normal text-white/80 transition-colors duration-300 ease-out hover:text-[var(--primary)]\">Enter marketplace <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><div class=\"relative\"><button aria-expanded=\"false\" aria-controls=\"data-menu\" class=\"flex min-h-11 shrink-0 items-center gap-1 whitespace-nowrap text-[13px] font-medium tracking-normal text-white/80 transition-colors duration-300 ease-out hover:text-[var(--primary)]\">Request custom data <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><a class=\"shrink-0 whitespace-nowrap py-3 text-[13px] font-medium tracking-normal text-white/80 transition-colors duration-300 ease-out hover:text-[var(--primary)]\" href=\"/gear\">Gadgets for capture</a><a class=\"shrink-0 whitespace-nowrap py-3 text-[13px] font-medium tracking-normal text-white/80 transition-colors duration-300 ease-out hover:text-[var(--primary)]\" href=\"/agent-demo\">Agent demo</a><a class=\"shrink-0 whitespace-nowrap py-3 text-[13px] font-medium tracking-normal text-white/80 transition-colors duration-300 ease-out hover:text-[var(--primary)]\" href=\"/blog\">Articles</a></div><div class=\"hidden items-center gap-6 sm:flex\"><a aria-label=\"Your orders\" class=\"relative grid size-11 shrink-0 place-items-center rounded-full border border-white/15 text-white/75 transition-colors hover:border-[var(--primary)]/50 hover:text-[var(--primary)]\" href=\"/orders\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-package-search\" aria-hidden=\"true\"><path d=\"M12 22V12\"></path><path d=\"M20.27 18.27 22 20\"></path><path d=\"M21 10.498V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.729l7 4a2 2 0 0 0 2 .001l.98-.559\"></path><path d=\"M3.29 7 12 12l8.71-5\"></path><path d=\"m7.5 4.27 8.997 5.148\"></path><circle cx=\"18.5\" cy=\"16.5\" r=\"2.5\"></circle></svg></a><a aria-label=\"Cart with 0 items\" class=\"relative grid size-11 shrink-0 place-items-center rounded-full border border-white/15 text-white/75 transition-colors hover:border-[var(--primary)]/50 hover:text-[var(--primary)]\" href=\"/checkout\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shopping-bag\" aria-hidden=\"true\"><path d=\"M16 10a4 4 0 0 1-8 0\"></path><path d=\"M3.103 6.034h17.794\"></path><path d=\"M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z\"></path></svg></a><button type=\"button\" class=\"min-h-11 shrink-0 whitespace-nowrap rounded-full border border-transparent px-3 text-[13px] font-medium tracking-normal text-white/75 transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-[var(--primary)]/50 hover:bg-white/5 hover:text-[var(--primary)]\">Sign in</button><button type=\"button\" class=\"min-h-11 shrink-0 whitespace-nowrap rounded-full bg-[var(--primary)] px-5 text-[13px] font-semibold tracking-normal text-[var(--page-bg)] transition-all duration-300 ease-out hover:-translate-y-0.5 hover:opacity-90 hover:shadow-[0_10px_30px_-14px_var(--primary)]\">Join now</button></div><button aria-label=\"Open navigation\" aria-expanded=\"false\" aria-controls=\"mobile-nav\" class=\"grid size-11 place-items-center rounded-full border border-white/15 xl:hidden\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></nav></header><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"Why first-person video changes what robots can learn\",\"description\":\"A practical look at why viewpoint, intent, and task structure matter when human activity becomes training data for embodied systems.\",\"datePublished\":\"2026-09-30\",\"dateModified\":\"2026-09-30\",\"author\":{\"@type\":\"Organization\",\"name\":\"DigiRobotics Research\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"DigiRobotics\",\"url\":\"https://digirobotics.xyz\"},\"mainEntityOfPage\":\"https://digirobotics.xyz/blog/first-person-video-robot-learning\"}</script><article><header class=\"relative overflow-hidden border-b border-white/10\"><div aria-hidden=\"true\" class=\"absolute inset-0 opacity-25 [background-image:radial-gradient(oklch(from_var(--primary)_l_c_h_/_24%)_1px,transparent_1px)] [background-size:22px_22px]\"></div><div class=\"relative mx-auto max-w-5xl px-5 pb-16 pt-12 sm:px-8 sm:pb-24 sm:pt-16\"><a class=\"inline-flex min-h-11 items-center gap-2 font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--muted-foreground)] transition hover:text-[var(--primary)]\" href=\"/blog\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-left\" aria-hidden=\"true\"><path d=\"m12 19-7-7 7-7\"></path><path d=\"M19 12H5\"></path></svg> Back to field notes</a><div class=\"mt-14 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[10px] uppercase tracking-[0.16em]\"><span class=\"text-[var(--primary)]\">Robotics</span><span aria-hidden=\"true\" class=\"text-white/25\">/</span><time dateTime=\"2026-09-30\" class=\"text-[var(--muted-foreground)]\">September 30, 2026</time><span aria-hidden=\"true\" class=\"text-white/25\">/</span><span class=\"text-[var(--muted-foreground)]\">6 min read</span></div><h1 class=\"mt-6 max-w-5xl font-display text-3xl md:text-4xl font-bold leading-tight tracking-[-0.03em] text-white\">Why first-person video changes what robots can learn</h1><p class=\"mt-8 max-w-3xl text-xl leading-9 text-[var(--muted-foreground)] sm:text-2xl\">A practical look at why viewpoint, intent, and task structure matter when human activity becomes training data for embodied systems.</p><div class=\"mt-10 flex items-center gap-3 text-[14px]\"><span class=\"grid size-10 place-items-center rounded-full border border-[var(--primary)]/40 bg-[var(--primary)]/10 font-heading text-[var(--primary)]\">DR</span><div><p class=\"font-semibold\">DigiRobotics Research</p></div></div></div></header><div class=\"mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[170px_minmax(0,760px)] lg:justify-center\"><aside class=\"hidden lg:block\"><div class=\"sticky top-28 border-t border-[var(--primary)] pt-4 font-mono text-[9px] uppercase leading-5 tracking-[0.15em] text-[var(--muted-foreground)]\">DigiRobotics<br/>Field note<br/>2026.09.30</div></aside><div class=\"min-w-0\"><p class=\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\">Most video on the internet shows an action from the outside. A robot learning to perform that action faces a different view: hands enter from below, tools hide the work surface, and the important object may leave the frame entirely.</p>\n<p class=\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\">First-person, or egocentric, capture narrows that gap. It records a task closer to the perspective from which an embodied system will eventually perceive and plan it.</p>\n<h2 class=\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\">Viewpoint is part of the data</h2>\n<p class=\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\">A camera angle is not cosmetic. It determines which relationships are visible: the distance from hand to tool, the moment a grip changes, and the sequence of attention across a workspace.</p>\n<p class=\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\">Useful egocentric data therefore needs more than a head-mounted camera. A collection plan should describe:</p>\n<ul class=\"my-6 space-y-3 pl-1 text-base leading-relaxed text-[var(--muted-foreground)]\">\n<li node=\"[object Object]\" class=\"relative pl-6 text-base leading-relaxed before:absolute before:left-0 before:top-[0.72em] before:size-1.5 before:rounded-full before:bg-[var(--primary)]\">the task and its intended outcome;</li>\n<li node=\"[object Object]\" class=\"relative pl-6 text-base leading-relaxed before:absolute before:left-0 before:top-[0.72em] before:size-1.5 before:rounded-full before:bg-[var(--primary)]\">the environment and relevant objects;</li>\n<li node=\"[object Object]\" class=\"relative pl-6 text-base leading-relaxed before:absolute before:left-0 before:top-[0.72em] before:size-1.5 before:rounded-full before:bg-[var(--primary)]\">the start, transition, and completion states;</li>\n<li node=\"[object Object]\" class=\"relative pl-6 text-base leading-relaxed before:absolute before:left-0 before:top-[0.72em] before:size-1.5 before:rounded-full before:bg-[var(--primary)]\">interruptions, corrections, and failed attempts;</li>\n<li node=\"[object Object]\" class=\"relative pl-6 text-base leading-relaxed before:absolute before:left-0 before:top-[0.72em] before:size-1.5 before:rounded-full before:bg-[var(--primary)]\">consent, licensing, and privacy boundaries.</li>\n</ul>\n<p class=\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\">The last point is foundational. A technically valuable recording can still be unusable if the people, screens, or locations inside it were captured without an appropriate basis for use.</p>\n<h2 class=\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\">Demonstrations are not instructions</h2>\n<p class=\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\">A recording shows what happened. It does not automatically explain why it happened.</p>\n<p class=\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\">Two visually similar hand movements may represent very different decisions. One person rotates a component to align a notch; another rotates it simply to see a label. Models benefit when video is paired with structured context such as task labels, object states, timestamps, and quality review.</p>\n<blockquote class=\"my-10 border-l-2 border-[var(--primary)] bg-[var(--primary)]/[0.06] px-6 py-2 font-heading text-xl leading-8 text-white sm:px-8\">\n<p class=\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\">The goal is not to collect the most footage. It is to preserve the decisions that make the footage meaningful.</p>\n</blockquote>\n<h2 class=\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\">Design for evaluation</h2>\n<p class=\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\">A dataset should make it possible to ask whether a system improved. That means holding out environments, performers, objects, or task variations rather than measuring performance only on familiar scenes.</p>\n<div class=\"my-9 overflow-x-auto rounded-2xl border border-white/10\"><table class=\"w-full border-collapse text-left text-[15px]\"><thead class=\"bg-white/[0.05] font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--primary)]\"><tr><th class=\"border-b border-white/10 px-5 py-4 font-medium\">Collection choice</th><th class=\"border-b border-white/10 px-5 py-4 font-medium\">What it helps evaluate</th></tr></thead><tbody><tr><td class=\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_&amp;]:border-b-0\">Multiple performers</td><td class=\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_&amp;]:border-b-0\">Variation in technique and body geometry</td></tr><tr><td class=\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_&amp;]:border-b-0\">New workspaces</td><td class=\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_&amp;]:border-b-0\">Robustness to layout and lighting</td></tr><tr><td class=\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_&amp;]:border-b-0\">Failed attempts</td><td class=\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_&amp;]:border-b-0\">Recovery and error recognition</td></tr><tr><td class=\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_&amp;]:border-b-0\">Explicit end states</td><td class=\"border-b border-white/[0.07] px-5 py-4 leading-6 text-[var(--muted-foreground)] last:[tr:last-child_&amp;]:border-b-0\">Task completion and verification</td></tr></tbody></table></div>\n<h2 class=\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\">From capture to a durable asset</h2>\n<p class=\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\">Provenance connects the recording to its contributor, capture brief, review history, and permitted uses. Storage and tokenization can help reference those records, but neither replaces a clear license or a reliable quality process.</p>\n<p class=\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\">The durable asset is not merely a video file. It is a documented piece of evidence about how a real task unfolds—from a perspective a robot can use.</p><div class=\"mt-16 border-t border-white/10 pt-8\"><a class=\"inline-flex min-h-11 items-center gap-2 rounded-full border border-white/15 px-5 py-3 text-[14px] font-semibold transition hover:border-[var(--primary)] hover:text-[var(--primary)]\" href=\"/blog\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-left\" aria-hidden=\"true\"><path d=\"m12 19-7-7 7-7\"></path><path d=\"M19 12H5\"></path></svg> Return to the archive</a></div></div></div></article><footer class=\"border-t border-white/[.08] bg-[#111620] py-12\"><div class=\"mx-auto w-full max-w-[1440px] px-5 sm:px-8 lg:px-12 xl:px-16\"><div class=\"grid gap-10 lg:grid-cols-[1fr_auto] lg:items-start\"><div><img alt=\"DigiRobotics.xyz\" loading=\"lazy\" width=\"210\" height=\"48\" decoding=\"async\" data-nimg=\"1\" class=\"h-auto w-[190px]\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fdigirobotics%2Fbrand%2Fdigirobotics-logo.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fdigirobotics%2Fbrand%2Fdigirobotics-logo.png&amp;w=640&amp;q=75 2x\" src=\"/_next/image?url=%2Fdigirobotics%2Fbrand%2Fdigirobotics-logo.png&amp;w=640&amp;q=75\"/><p class=\"mt-4 text-[17px] text-white/60\">Egocentric data for robotics training.</p></div><nav aria-label=\"Footer navigation\" class=\"flex max-w-2xl flex-wrap gap-x-7 gap-y-3\"><a href=\"/#contributors\" class=\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\">Contributor</a><a href=\"/#marketplace\" class=\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\">Marketplace</a><a href=\"/#custom-data\" class=\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\">Custom Data</a><a href=\"/gear\" class=\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\">Capture Gear</a><a href=\"/blog\" class=\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\">Articles</a><a href=\"/agent-demo\" class=\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transi