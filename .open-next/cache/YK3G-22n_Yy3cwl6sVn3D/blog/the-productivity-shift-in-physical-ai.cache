,{\"className\":\"text-[var(--muted-foreground)]\",\"children\":\"11 min read\"}]]}],[\"$\",\"h1\",null,{\"className\":\"mt-6 max-w-5xl font-display text-3xl md:text-4xl font-bold leading-tight tracking-[-0.03em] text-white\",\"children\":\"The Productivity Shift in Physical AI\"}],[\"$\",\"p\",null,{\"className\":\"mt-8 max-w-3xl text-xl leading-9 text-[var(--muted-foreground)] sm:text-2xl\",\"children\":\"AI agents have crossed from personality-driven experiments to productivity-driven autonomous systems — and egocentric capture has made the same jump from research curiosity to production-grade workflow. Both transitions demand the same settlement infrastructure: autonomous, instant, programmatically governed stablecoin payments.\"}],[\"$\",\"div\",null,{\"className\":\"mt-10 flex items-center gap-3 text-[14px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"grid size-10 place-items-center rounded-full border border-[var(--primary)]/40 bg-[var(--primary)]/10 font-heading text-[var(--primary)]\",\"children\":\"DR\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"DigiRobotics Team\"}],[\"$\",\"p\",null,{\"className\":\"mt-0.5 text-[12px] text-[var(--muted-foreground)]\",\"children\":[\"Updated \",\"November 20, 2026\"]}]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[170px_minmax(0,760px)] lg:justify-center\",\"children\":[\"$L27\",\"$L28\"]}]]}],\"$L29\"]}]\n21:null\n25:[[\"$\",\"title\",\"0\",{\"children\":\"The Productivity Shift in Physical AI — DigiRobotics\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"AI agents have crossed from personality-driven experiments to productivity-driven autonomous systems — and egocentric capture has made the same jump from research curiosity to production-grade workflow. Both transitions demand the same settlement infrastructure: autonomous, instant, programmatically governed stablecoin payments.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.webmanifest\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"https://digirobotics.xyz/blog/the-productivity-shift-in-physical-ai\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:title\",\"content\":\"The Productivity Shift in Physical AI\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:description\",\"content\":\"AI agents have crossed from personality-driven experiments to productivity-driven autonomous systems — and egocentric capture has made the same jump from research curiosity to production-grade workflow. Both transitions demand the same settlement infrastructure: autonomous, instant, programmatically governed stablecoin payments.\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:url\",\"content\":\"https://digirobotics.xyz/blog/the-productivity-shift-in-physical-ai\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image\",\"content\":\"https://digirobotics.xyz/images/blog/the-productivity-shift-in-physical-ai-cover.jpg\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:image:alt\",\"content\":\"The Productivity Shift in Physical AI\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"10\",{\"property\":\"article:published_time\",\"content\":\"2026-11-20\"}],[\"$\",\"meta\",\"11\",{\"property\":\"article:modified_time\",\"content\":\"2026-11-20\"}],[\"$\",\"meta\",\"12\",{\"property\":\"article:author\",\"content\":\"DigiRobotics Team\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:title\",\"content\":\"The Productivity Shift in Physical AI\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:description\",\"content\":\"AI agents have crossed from personality-driven experiments to productivity-driven autonomous systems — and egocentric capture has made the same jump from research curiosity to production-grade workflow. Both transitions demand the same settlement infrastructure: autonomous, instant, programmatically governed stablecoin payments.\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:image\",\"content\":\"https://digirobotics.xyz/images/blog/the-productivity-shift-in-physical-ai-cover.jpg\"}],[\"$\",\"link\",\"17\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?63d5b2ef705d808e\",\"type\":\"image/x-icon\",\"sizes\":\"256x256\"}],[\"$\",\"link\",\"18\",{\"rel\":\"icon\",\"href\":\"/icon.png?1f3d5ce59ec9c445\",\"type\":\"image/png\",\"sizes\":\"1254x1254\"}],[\"$\",\"link\",\"19\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-icon.png?1f3d5ce59ec9c445\",\"type\":\"image/png\",\"sizes\":\"1254x1254\"}],[\"$\",\"$L2a\",\"20\",{}]]\n27:[\"$\",\"aside\",null,{\"className\":\"hidden lg:block\",\"children\":[\"$\",\"div\",null,{\"className\":\"sticky top-28 border-t border-[var(--primary)] pt-4 font-mono text-[9px] uppercase leading-5 tracking-[0.15em] text-[var(--muted-foreground)]\",\"children\":[\"DigiRobotics\",[\"$\",\"br\",null,{}],\"Field note\",[\"$\",\"br\",null,{}],\"2026.11.20\"]}]}]\n28:[\"$\",\"div\",null,{\"className\":\"min-w-0\",\"children\":[[[\"$\",\"blockquote\",\"blockquote-0\",{\"className\":\"my-10 border-l-2 border-[var(--primary)] bg-[var(--primary)]/[0.06] px-6 py-2 font-heading text-xl leading-8 text-white sm:px-8\",\"children\":[\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"font-semibold text-white\",\"children\":\"TL;DR:\"}]}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"AI agents crossed a structural divide — from personality-driven experiments (music, memes, art) to productivity-driven systems that monitor, code, research, and procure on behalf of users. The same two-wave shift is happening on the data side — egocentric capture moved from small lab cohorts to production-grade distributed collection at planetary scale. Both transitions demand the same settlement infrastructure: autonomous, instant, programmatically governed stablecoin payments. The protocol layer has crystallized around HTTP-native agentic payments, agent authorization primitives, and USDG stablecoin settlement on high-performance Layer-2 networks. DigiRobotics composes both production-grade stacks into a single closed loop: capture, verify, tokenize, discover, pay, earn.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"h2\",\"h2-0\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"The Two-Wave Evolution of AI Agents\"}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The first wave of onchain AI agents arrived in 2024 as personality-based experiments. Autonomous creators produced music, memes, art, and digital collectibles. Several early experiments reached token valuations of $450 million to $700 million at their peak, demonstrating that crypto could convert software, attention, and collective belief into liquid markets faster than traditional funding mechanisms. They were fascinating as proofs of concept, but they did not solve real economic problems.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The second wave shifted to productivity-based agents — systems that monitor information flows across social media, governance forums, podcasts, and market discussions; systems that extend coding, research, and workflow automation tools; systems that procure resources on behalf of users without manual approval at each step. The question the industry now asks is no longer \\\"does AI need crypto?\\\" but \\\"what kind of economic infrastructure autonomous AI systems will need to function at scale.\\\"\"}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"That infrastructure is being built right now. The protocol layer has crystallized around open standards. An HTTP-native agentic payment protocol — co-developed by a major cryptocurrency exchange and a leading web infrastructure provider — has processed over 100 million payments and reached roughly $600 million in annualized volume, repurposing the HTTP \\\"Payment Required\\\" status code for machine-to-machine settlement directly inside API calls. An agent payments protocol, backed by a coalition of more than 60 banks, payment processors, and tech firms, provides the Authorization, Authenticity, and Accountability primitives an agent needs to act as a trustworthy payer. A machine payments specification from a leading payment processor supports recurring agent-to-service relationships. A universal commerce protocol standardizes agent discovery of merchant capabilities.\"}],\"\\n\",\"$L2b\",\"\\n\",\"$L2c\",\"\\n\",\"$L2d\",\"\\n\",\"$L2e\",\"\\n\",\"$L2f\",\"\\n\",\"$L30\",\"\\n\",\"$L31\",\"\\n\",\"$L32\",\"\\n\",\"$L33\",\"\\n\",\"$L34\",\"\\n\",\"$L35\",\"\\n\",\"$L36\",\"\\n\",\"$L37\",\"\\n\",\"$L38\",\"\\n\",\"$L39\",\"\\n\",\"$L3a\",\"\\n\",\"$L3b\"],\"$L3c\"]}]\n29:[\"$\",\"footer\",null,{\"className\":\"border-t border-white/[.08] bg-[#111620] py-12\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full max-w-[1440px] px-5 sm:px-8 lg:px-12 xl:px-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-10 lg:grid-cols-[1fr_auto] lg:items-start\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"$Lb\",null,{\"src\":\"/digirobotics/brand/digirobotics-logo.png\",\"alt\":\"DigiRobotics.xyz\",\"width\":210,\"height\":48,\"className\":\"h-auto w-[190px]\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-[17px] text-white/60\",\"children\":\"Egocentric data for robotics training.\"}]]}],[\"$\",\"nav\",null,{\"aria-label\":\"Footer navigation\",\"className\":\"flex max-w-2xl flex-wrap gap-x-7 gap-y-3\",\"children\":[[\"$\",\"a\",\"Contributor\",{\"href\":\"/#contributors\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Contributor\"}],[\"$\",\"a\",\"Marketplace\",{\"href\":\"/#marketplace\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Marketplace\"}],[\"$\",\"a\",\"Custom Data\",{\"href\":\"/#custom-data\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Custom Data\"}],[\"$\",\"a\",\"Capture Gear\",{\"href\":\"/gear\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Capture Gear\"}],[\"$\",\"a\",\"Articles\",{\"href\":\"/blog\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Articles\"}],[\"$\",\"a\",\"Agent Demo\",{\"href\":\"/agent-demo\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Agent Demo\"}],[\"$\",\"a\",\"Privacy & Terms\",{\"href\":\"/#privacy-note\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Privacy & Terms\"}],\"$L3d\"]}]]}],\"$L3e\",\"$L3f\",\"$L40\"]}]}]\n2b:[\"$\",\"p\",\"p-3\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Underneath the protocol layer, stablecoins deliver the only rail that settles in sub-second time with sub-cent fees. USD-pegged stablecoins already process roughly $27 trillion in annual transaction volume, and federal stablecoin legislation has removed the largest institutional barrier to adoption. Industry analyses project agentic commerce revenue at up to $1 trillion by 2030, with global projections ranging from $3T to $5T.\"}]\n2c:[\"$\",\"p\",\"p-4\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The defining security principle is blunt: an agent should never be the last line of defense against its own failures. The production-grade stack enforces this through a five-dimension policy engine — spending limits, counterparty allowlists, transaction type restrictions, time-based controls, and escalation thresholds.\"}]\n2d:[\"$\",\"h2\",\"h2-1\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"The Parallel Maturation of Egocentric Capture\"}]\n2e:[\"$\",\"p\",\"p-5\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The same two-wave pattern is visible on the data side. The first wave of egocentric data collection was research-driven — small cohorts of lab participants wearing clunky headsets, capturing a few hundred hours of scripted activity. The second wave is production-driven — distributed contributors capturing authentic real-world tasks at planetary scale.\"}]\n2f:[\"$\",\"p\",\"p-6\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"A recent large-scale collection program produced 30,000 hours of raw first-person video, of which 24,000+ hours cleared annotation and quality review for model training — an 80% yield rate that exposes the discipline production-scale capture now demands. The workflow is structured around five design decisions. Forehead-mounted capture at a 45° downward angle using leading consumer smartphones in wearable rigs keeps hands, objects, and workspace in frame without dedicated hardware. Authentic activity in real environments — household, industrial, retail, hospitality, agricultural, construction, and service settings across multiple countries and continents. Mobile-application-driven submission with automated formatting, integrity checks, and location verification. A one-day review cycle with explicit rejection reasons, enabling rapid recapture rather than weeks-late discovery of capture errors. And up to 100 approved hours per participant, generating dozens of micro-submissions over each project lifecycle.\"}]\n30:[\"$\",\"p\",\"p-7\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The output is explicitly robotics-ready — usable for activity recognition, hand-object interaction modeling, and robotic perception without rework.\"}]\n31:[\"$\",\"h2\",\"h2-2\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Why Productivity Demands Production-Grade Settlement\"}]\n32:[\"$\",\"p\",\"p-8\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The productivity shift on both sides creates the same economic constraint. A productivity-driven agent procuring real-world data cannot operate at scale if every transaction requires human approval, batch settlement, and 30-day invoicing. A productivity-driven data contributor cannot sustain 100 approved hours of capture if payouts arrive weeks after submission.\"}]\n33:[\"$\",\"p\",\"p-9\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The two productivity shifts compose into a single closed loop:\"}]\n34:[\"$\",\"p\",\"p-10\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Contributor captures first-person footage → mobile application submits and verifies → one-day QA cycle approves or rejects → approved footage is tokenized and listed → productivity-driven agent discovers it and settles via an HTTP-native payment protocol in seconds → five-dimension policy engine enforces governance → contributor receives stablecoin payout → improved data trains improved policies → more deployment creates more demand for data → contributor captures more footage.\"}]\n35:[\"$\",\"p\",\"p-11\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The loop only closes when both sides are production-grade. Personality-driven agents and research-grade capture could coexist without autonomous settlement — they did not transact at frequency or volume. Productivity-driven agents and production-grade capture cannot. They require the same settlement infrastructure: sub-second finality, sub-cent fees, programmable conditionality, and cross-cutting governance that wraps every transaction.\"}]\n36:[\"$\",\"h2\",\"h2-3\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"How DigiRobotics Is Building the Future\"}]\n37:[\"$\",\"p\",\"p-12\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"DigiRobotics is the world's first stablecoin-native marketplace for agentic commerce in real-world robotics data — purpose-built at the intersection of both productivity shifts.\"}]\n41:T4a1,DigiRobotics is the world's first stablecoin-native marketplace for agentic commerce in real-world robotics data — purpose-built at the intersection of both productivity shifts. Our platform composes both production-grade stacks into a single loop. Egocentric data capture at scale means contributors record first-person physical tasks using accessible wearable devices and smartphones, extending the production-grade capture workflow beyond any single program's cohort. HTTP-native agentic payments mean productivity-driven agents procure data programmatically via the HTTP \"Payment Required\" payment flow, with single-call micropayments settling in seconds. USDG stablecoin settlement on a high-performance Layer-2 network provides sub-second finality, negligible gas costs, and borderless by design. The five-dimension policy engine enforces spending limits, counterparty allowlists, transaction type restrictions, time-based controls, and escalation thresholds on every transaction. Mobile-application-driven submission with multi-stage QA, automatic anonymization, and structured metadata ensures every dataset meets the rigor that production-scale manipulation policies demand.38:[\"$\",\"p\",\"p-13\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"$41\"}]\n39:[\"$\",\"p\",\"p-14\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"By composing the production-grade capture pipeline directly with the production-grade settlement stack, DigiRobotics operationalizes the productivity shift in Physical AI. Contributors earn USDG the moment their data is consumed; productivity-driven agents procure data around the clock; embodied AI policies scale toward their documented potential.\"}]\n3a:[\"$\",\"h2\",\"h2-4\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Start Building With Us\"}]\n3b:[\"$\",\"p\",\"p-15\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"If you capture first-person video — cooking, assembling, operating machinery, repairing, demonstrating any physical task — your footage can train the next generation of humanoids and earn you USDG the moment it is consumed. Robotics labs and agent developers can procure production-grade egocentric data programmatically, with instant settlement and verifiable provenance. Join the DigiRobotics marketplace and help build the planetary-scale data pipeline for Physical AI.\"}]\n3c:[\"$\",\"div\",null,{\"className\":\"mt-16 border-t border-white/10 pt-8\",\"children\":[\"$\",\"$L26\",null,{\"href\":\"/blog\",\"className\":\"inline-flex min-h-11 items-center gap-2 rounded-full border border-white/15 px-5 py-3 text-[14px] font-semibold transition hover:border-[var(--primary)] hover:text-[var(--primary)]\",\"children\":[[\"$\",\"$La\",null,{\"ref\":\"$undefined\",\"icon\":\"$1e:props:children:2:props:children:0:props:children:1:props:children:0:props:children:0:props:icon\",\"className\":\"$undefined\",\"size\":16,\"aria-hidden\":\"true\"}],\" Return to the archive\"]}]}]\n3d:[\"$\",\"a\",\"Contact Us\",{\"href\":\"mailto:hello@digirobotics.xyz\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Contact Us\"}]\n3e:[\"$\",\"div\",null,{\"id\":\"privacy-note\",\"className\":\"mt-10 grid gap-4 border-t border-white/[.08] pt-6 text-[13px] leading-5 text-white/45 sm:grid-cols-[1fr_auto]\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Privacy and terms notices will be published before campaign enrollment or data collection begins. Contact the team for Phase 1 information.\"}],[\"$\",\"p\",null,{\"children\":\"© 2026 DigiRobotics\"}]]}]\n3f:[\"$\",\"div\",null,{\"className\":\"mt-6 flex items-center gap-4 text-white/45\",\"children\":[[\"$\",\"a\",null,{\"href\":\"#\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-white/45 hover:text-white transition-colors\",\"children\":[\"$\",\"$La\",null,{\"ref\":\"$undefined\",\"icon\":\"$14:props:children:0:props:children:props:icon\",\"className\":\"$undefined\",\"size\":18,\"aria-hidden\":\"true\"}]}],[\"$\",\"a\",null,{\"href\":\"#\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-white/45 hover:text-white transition-colors\",\"children\":[\"$\",\"$La\",null,{\"ref\":\"$undefined\",\"icon\":\"$14:props:children:1:props:children:props:icon\",\"className\":\"$undefined\",\"size\":18,\"aria-hidden\":\"true\"}]}]]}]\n40:[\"$\",\"p\",null,{\"className\":\"mt-5 font-mono text-[10px] uppercase tracking-[.12em] text-white/35\",\"children\":\"Agent-compatible payment workflows powered by stablecoins and x402. Phase 1 infrastructure.\"}]\n","segmentData":{"/_tree":":HL[\"/_next/static/css/9b6cbde999f1a60b.css\",\"