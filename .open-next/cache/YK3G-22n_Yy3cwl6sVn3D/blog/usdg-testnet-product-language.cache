dren\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"DigiRobotics Protocol Lab\"}],null]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[170px_minmax(0,760px)] lg:justify-center\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"hidden lg:block\",\"children\":[\"$\",\"div\",null,{\"className\":\"sticky top-28 border-t border-[var(--primary)] pt-4 font-mono text-[9px] uppercase leading-5 tracking-[0.15em] text-[var(--muted-foreground)]\",\"children\":[\"DigiRobotics\",[\"$\",\"br\",null,{}],\"Field note\",[\"$\",\"br\",null,{}],\"2026.09.10\"]}]}],[\"$\",\"div\",null,{\"className\":\"min-w-0\",\"children\":[[[\"$\",\"p\",\"p-0\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Stablecoin language carries technical and financial meaning. In a testnet product, a short label can accidentally imply that a mock asset is redeemable, production-issued, or equivalent to the real-world token it represents.\"}],\"\\n\",\"$L27\",\"\\n\",\"$L28\",\"\\n\",\"$L29\",\"\\n\",\"$L2a\",\"\\n\",\"$L2b\",\"\\n\",\"$L2c\",\"\\n\",\"$L2d\",\"\\n\",\"$L2e\",\"\\n\",\"$L2f\",\"\\n\",\"$L30\",\"\\n\",\"$L31\"],\"$L32\"]}]]}]]}],\"$L33\"]}]\n21:null\n25:[[\"$\",\"title\",\"0\",{\"children\":\"How to talk about stablecoins in a testnet product — DigiRobotics\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"A content checklist for keeping USDG ecosystem language accurate across prototypes, demos, and production-facing interfaces.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.webmanifest\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"https://digirobotics.xyz/blog/usdg-testnet-product-language\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:title\",\"content\":\"How to talk about stablecoins in a testnet product\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:description\",\"content\":\"A content checklist for keeping USDG ecosystem language accurate across prototypes, demos, and production-facing interfaces.\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:url\",\"content\":\"https://digirobotics.xyz/blog/usdg-testnet-product-language\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"8\",{\"property\":\"article:published_time\",\"content\":\"2026-09-10\"}],[\"$\",\"meta\",\"9\",{\"property\":\"article:author\",\"content\":\"DigiRobotics Protocol Lab\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:title\",\"content\":\"How to talk about stablecoins in a testnet product\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:description\",\"content\":\"A content checklist for keeping USDG ecosystem language accurate across prototypes, demos, and production-facing interfaces.\"}],[\"$\",\"link\",\"13\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?63d5b2ef705d808e\",\"type\":\"image/x-icon\",\"sizes\":\"256x256\"}],[\"$\",\"link\",\"14\",{\"rel\":\"icon\",\"href\":\"/icon.png?1f3d5ce59ec9c445\",\"type\":\"image/png\",\"sizes\":\"1254x1254\"}],[\"$\",\"link\",\"15\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-icon.png?1f3d5ce59ec9c445\",\"type\":\"image/png\",\"sizes\":\"1254x1254\"}],[\"$\",\"$L34\",\"16\",{}]]\n27:[\"$\",\"p\",\"p-1\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"DigiRobotics is built for the USDG and Paxos ecosystem. Its current supported networks are Arbitrum Sepolia and Robinhood Chain Testnet. The interface must still describe each configured test asset exactly as it exists.\"}]\n28:[\"$\",\"h2\",\"h2-0\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Configuration comes before copy\"}]\n29:[\"$\",\"p\",\"p-2\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Product copy should derive network names, token symbols, and decimal handling from typed configuration. Content should never invent a contract address or silently substitute a familiar stablecoin.\"}]\n2a:[\"$\",\"p\",\"p-3\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":[\"For a test deployment, preserve qualifiers such as \",[\"$\",\"code\",\"code-0\",{\"node\":{\"type\":\"element\",\"tagName\":\"code\",\"properties\":{},\"children\":[{\"type\":\"text\",\"value\":\"mock\",\"position\":{\"start\":{\"line\":9,\"column\":52,\"offset\":732},\"end\":{\"line\":9,\"column\":58,\"offset\":738}}}],\"position\":{\"start\":{\"line\":9,\"column\":52,\"offset\":732},\"end\":{\"line\":9,\"column\":58,\"offset\":738}}},\"className\":\" rounded bg-white/[0.07] px-1.5 py-0.5 font-mono text-[0.86em] text-[#b9ef65]\",\"children\":\"mock\"}],\" or \",[\"$\",\"code\",\"code-1\",{\"node\":{\"type\":\"element\",\"tagName\":\"code\",\"properties\":{},\"children\":[{\"type\":\"text\",\"value\":\"test\",\"position\":{\"start\":{\"line\":9,\"column\":62,\"offset\":742},\"end\":{\"line\":9,\"column\":68,\"offset\":748}}}],\"position\":{\"start\":{\"line\":9,\"column\":62,\"offset\":742},\"end\":{\"line\":9,\"column\":68,\"offset\":748}}},\"className\":\" rounded bg-white/[0.07] px-1.5 py-0.5 font-mono text-[0.86em] text-[#b9ef65]\",\"children\":\"test\"}],\" wherever users could otherwise mistake the asset for production Paxos USDG.\"]}]\n2b:[\"$\",\"h2\",\"h2-1\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Make the environment visible\"}]\n2c:[\"$\",\"p\",\"p-4\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"A good transaction summary answers four questions before a user approves an action:\"}]\n2d:[\"$\",\"ul\",\"ul-0\",{\"className\":\"my-6 space-y-3 pl-1 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"node\":{\"type\":\"element\",\"tagName\":\"li\",\"properties\":{},\"children\":[{\"type\":\"text\",\"value\":\"Which network is active?\",\"position\":{\"start\":{\"line\":15,\"column\":3,\"offset\":946},\"end\":{\"line\":15,\"column\":27,\"offset\":970}}}],\"position\":{\"start\":{\"line\":15,\"column\":1,\"offset\":944},\"end\":{\"line\":15,\"column\":27,\"offset\":970}}},\"className\":\"relative pl-6 text-base leading-relaxed before:absolute before:left-0 before:top-[0.72em] before:size-1.5 before:rounded-full before:bg-[var(--primary)]\",\"children\":\"Which network is active?\"}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"node\":{\"type\":\"element\",\"tagName\":\"li\",\"properties\":{},\"children\":[{\"type\":\"text\",\"value\":\"Which configured asset is being used?\",\"position\":{\"start\":{\"line\":16,\"column\":3,\"offset\":973},\"end\":{\"line\":16,\"column\":40,\"offset\":1010}}}],\"position\":{\"start\":{\"line\":16,\"column\":1,\"offset\":971},\"end\":{\"line\":16,\"column\":40,\"offset\":1010}}},\"className\":\"relative pl-6 text-base leading-relaxed before:absolute before:left-0 before:top-[0.72em] before:size-1.5 before:rounded-full before:bg-[var(--primary)]\",\"children\":\"Which configured asset is being used?\"}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"node\":{\"type\":\"element\",\"tagName\":\"li\",\"properties\":{},\"children\":[{\"type\":\"text\",\"value\":\"Is the asset a test asset?\",\"position\":{\"start\":{\"line\":17,\"column\":3,\"offset\":1013},\"end\":{\"line\":17,\"column\":29,\"offset\":1039}}}],\"position\":{\"start\":{\"line\":17,\"column\":1,\"offset\":1011},\"end\":{\"line\":17,\"column\":29,\"offset\":1039}}},\"className\":\"relative pl-6 text-base leading-relaxed before:absolute before:left-0 before:top-[0.72em] before:size-1.5 before:rounded-full before:bg-[var(--primary)]\",\"children\":\"Is the asset a test asset?\"}],\"\\n\",[\"$\",\"li\",\"li-3\",{\"node\":{\"type\":\"element\",\"tagName\":\"li\",\"properties\":{},\"children\":[{\"type\":\"text\",\"value\":\"What amount will be authorized?\",\"position\":{\"start\":{\"line\":18,\"column\":3,\"offset\":1042},\"end\":{\"line\":18,\"column\":34,\"offset\":1073}}}],\"position\":{\"start\":{\"line\":18,\"column\":1,\"offset\":1040},\"end\":{\"line\":18,\"column\":34,\"offset\":1073}}},\"className\":\"relative pl-6 text-base leading-relaxed before:absolute before:left-0 before:top-[0.72em] before:size-1.5 before:rounded-full before:bg-[var(--primary)]\",\"children\":\"What amount will be authorized?\"}],\"\\n\"]}]\n2e:[\"$\",\"p\",\"p-5\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The same information should remain available in receipts and support logs, excluding secrets and reusable signatures.\"}]\n2f:[\"$\",\"h2\",\"h2-2\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Avoid promises the software cannot support\"}]\n30:[\"$\",\"p\",\"p-6\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":[\"Words such as \",[\"$\",\"em\",\"em-0\",{\"children\":\"dollar\"}],\", \",[\"$\",\"em\",\"em-1\",{\"children\":\"redeemable\"}],\", or \",[\"$\",\"em\",\"em-2\",{\"children\":\"yield\"}],\" should be used only when the implemented product and issuer terms support them. A test token can simulate denomination and transfer behavior without carrying production redemption rights.\"]}]\n31:[\"$\",\"p\",\"p-7\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Precision is not merely a compliance exercise. It is interface safety: users and agents make better decisions when the environment, asset, and limitations are unambiguous.\"}]\n32:[\"$\",\"div\",null,{\"className\":\"mt-16 border-t border-white/10 pt-8\",\"children\":[\"$\",\"$L26\",null,{\