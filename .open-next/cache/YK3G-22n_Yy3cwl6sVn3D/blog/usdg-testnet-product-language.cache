d networks are Arbitrum Sepolia and Robinhood Chain Testnet. The interface must still describe each configured test asset exactly as it exists.\\\"}]\\n28:[\\\"$\\\",\\\"h2\\\",\\\"h2-0\\\",{\\\"className\\\":\\\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\\\",\\\"children\\\":\\\"Configuration comes before copy\\\"}]\\n29:[\\\"$\\\",\\\"p\\\",\\\"p-2\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"Product copy should derive network names, token symbols, and decimal handling from typed configuration. Content should never invent a contract address or silently substitute a familiar stablecoin.\\\"}]\\n2a:[\\\"$\\\",\\\"p\\\",\\\"p-3\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":[\\\"For a test deployment, preserve qualifiers such as \\\",[\\\"$\\\",\\\"code\\\",\\\"code-0\\\",{\\\"node\\\":{\\\"type\\\":\\\"element\\\",\\\"tagName\\\":\\\"code\\\",\\\"properties\\\":{},\\\"children\\\":[{\\\"type\\\":\\\"text\\\",\\\"value\\\":\\\"mock\\\",\\\"position\\\":{\\\"start\\\":{\\\"line\\\":9,\\\"column\\\":52,\\\"offset\\\":732},\\\"end\\\":{\\\"line\\\":9,\\\"column\\\":58,\\\"offset\\\":738}}}],\\\"position\\\":{\\\"start\\\":{\\\"line\\\":9,\\\"column\\\":52,\\\"offset\\\":732},\\\"end\\\":{\\\"line\\\":9,\\\"column\\\":58,\\\"offset\\\":738}}},\\\"className\\\":\\\" rounded bg-white/[0.07] px-1.5 py-0.5 font-mono text-[0.86em] text-[#b9ef65]\\\",\\\"children\\\":\\\"mock\\\"}],\\\" or \\\",[\\\"$\\\",\\\"code\\\",\\\"code-1\\\",{\\\"node\\\":{\\\"type\\\":\\\"element\\\",\\\"tagName\\\":\\\"code\\\",\\\"properties\\\":{},\\\"children\\\":[{\\\"type\\\":\\\"text\\\",\\\"value\\\":\\\"test\\\",\\\"position\\\":{\\\"start\\\":{\\\"line\\\":9,\\\"column\\\":62,\\\"offset\\\":742},\\\"end\\\":{\\\"line\\\":9,\\\"column\\\":68,\\\"offset\\\":748}}}],\\\"position\\\":{\\\"start\\\":{\\\"line\\