ems-center gap-x-4 gap-y-2 font-mono text-[10px] uppercase tracking-[0.16em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[var(--primary)]\",\"children\":\"Robotics\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"text-white/25\",\"children\":\"/\"}],[\"$\",\"time\",null,{\"dateTime\":\"2026-11-20\",\"className\":\"text-[var(--muted-foreground)]\",\"children\":\"November 20, 2026\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"text-white/25\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-[var(--muted-foreground)]\",\"children\":\"12 min read\"}]]}],[\"$\",\"h1\",null,{\"className\":\"mt-6 max-w-5xl font-display text-3xl md:text-4xl font-bold leading-tight tracking-[-0.03em] text-white\",\"children\":\"The Data Supply Chain Gets a Price Tag\"}],[\"$\",\"p\",null,{\"className\":\"mt-8 max-w-3xl text-xl leading-9 text-[var(--muted-foreground)] sm:text-2xl\",\"children\":\"Robotics data cannot be scraped — it must be physically captured. Stablecoin micropayments remove the fee floor, enabling an open, machine-payable marketplace where verified data is bought by the capture, not by the contract.\"}],[\"$\",\"div\",null,{\"className\":\"mt-10 flex items-center gap-3 text-[14px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"grid size-10 place-items-center rounded-full border border-[var(--primary)]/40 bg-[var(--primary)]/10 font-heading text-[var(--primary)]\",\"children\":\"DR\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"DigiRobotics Team\"}],[\"$\",\"p\",null,{\"className\":\"mt-0.5 text-[12px] text-[var(--muted-foreground)]\",\"children\":[\"Updated \",\"November 20, 2026\"]}]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[170px_minmax(0,760px)] lg:justify-center\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"hidden lg:block\",\"children\":[\"$\",\"div\",null,{\"className\":\"sticky top-28 border-t border-[var(--primary)] pt-4 font-mono text-[9px] uppercase leading-5 tracking-[0.15em] text-[var(--muted-foreground)]\",\"children\":[\"DigiRobotics\",\"$L27\",\"Field note\",\"$L28\",\"2026.11.20\"]}]}],\"$L29\"]}]]}],\"$L2a\"]}]\n21:null\n25:[[\"$\",\"title\",\"0\",{\"children\":\"The Data Supply Chain Gets a Price Tag — DigiRobotics\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Robotics data cannot be scraped — it must be physically captured. Stablecoin micropayments remove the fee floor, enabling an open, machine-payable marketplace where verified data is bought by the capture, not by the contract.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.webmanifest\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"https://digirobotics.xyz/blog/the-data-supply-chain-gets-a-price-tag\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:title\",\"content\":\"The Data Supply Chain Gets a Price Tag\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:description\",\"content\":\"Robotics data cannot be scraped — it must be physically captured. Stablecoin micropayments remove the fee floor, enabling an open, machine-payable marketplace where verified data is bought by the capture, not by the contract.\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:url\",\"content\":\"https://digirobotics.xyz/blog/the-data-supply-chain-gets-a-price-tag\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image\",\"content\":\"https://digirobotics.xyz/images/blog/the-data-supply-chain-gets-a-price-tag-cover.jpg\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:image:alt\",\"content\":\"The Data Supply Chain Gets a Price Tag\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"10\",{\"property\":\"article:published_time\",\"content\":\"2026-11-20\"}],[\"$\",\"meta\",\"11\",{\"property\":\"article:modified_time\",\"content\":\"2026-11-20\"}],[\"$\",\"meta\",\"12\",{\"property\":\"article:author\",\"content\":\"DigiRobotics Team\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:title\",\"content\":\"The Data Supply Chain Gets a Price Tag\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:description\",\"content\":\"Robotics data cannot be scraped — it must be physically captured. Stablecoin micropayments remove the fee floor, enabling an open, machine-payable marketplace where verified data is bought by the capture, not by the contract.\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:image\",\"content\":\"https://digirobotics.xyz/images/blog/the-data-supply-chain-gets-a-price-tag-cover.jpg\"}],[\"$\",\"link\",\"17\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?63d5b2ef705d808e\",\"type\":\"image/x-icon\",\"sizes\":\"256x256\"}],[\"$\",\"link\",\"18\",{\"rel\":\"icon\",\"href\":\"/icon.png?1f3d5ce59ec9c445\",\"type\":\"image/png\",\"sizes\":\"1254x1254\"}],[\"$\",\"link\",\"19\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-icon.png?1f3d5ce59ec9c445\",\"type\":\"image/png\",\"sizes\":\"1254x1254\"}],[\"$\",\"$L2b\",\"20\",{}]]\n27:[\"$\",\"br\",null,{}]\n28:[\"$\",\"br\",null,{}]\n29:[\"$\",\"div\",null,{\"className\":\"min-w-0\",\"children\":[[[\"$\",\"blockquote\",\"blockquote-0\",{\"className\":\"my-10 border-l-2 border-[var(--primary)] bg-[var(--primary)]/[0.06] px-6 py-2 font-heading text-xl leading-8 text-white sm:px-8\",\"children\":[\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"font-semibold text-white\",\"children\":\"TL;DR:\"}]}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Robotics data cannot be scraped — every demonstration must be physically captured through teleoperation, egocentric footage, and synchronized multi-sensor streams. A specialized vendor landscape has emerged, but collection remains slow, bespoke, and locked behind long enterprise contracts. Stablecoin micropayments have removed the fee floor, making sub-cent and per-request payments economically real. Together they enable a new model: an open, machine-payable marketplace where verified robotics data is bought by the capture, not by the contract. DigiRobotics is building exactly that supply chain.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"h2\",\"h2-0\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Robotics Data Can't Be Scraped\"}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"A language model learns from text already sitting on the internet. A robot has no such archive. There is no public record of \\\"what it feels like to pick up a mug\\\" — every useful robotics dataset must be physically created, by a human operating a rig, wearing a camera, or steering a robot arm action by action.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"What makes this harder than conventional computer vision collection is synchronization. Physical AI data is fundamentally multimodal. Teleoperation data comes from a human driving a robot arm, recorded action by action, for imitation learning. Egocentric data is first-person footage from chest-mounted or robot-mounted cameras, matching the robot's deployment viewpoint. Multimodal sensor data combines LiDAR, depth, proprioception, and force-torque captured together for perception and control. Simulation-augmented data creates synthetic scenes validated against reality to extend coverage cheaply.\"}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Every stream must align down to fractions of a second, paired with the exact action taken. Out-of-sync data is worse than no data: it teaches the model the wrong physics.\"}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Inside the Specialized Vendor Landscape\"}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Because no single archive exists, an entire industry of collection specialists now competes for robotics teams. The landscape is fragmented by design strengths. Some vendors dominate end-to-end workflows, combining capture, annotation, and automated sync validation in one platform. Others own scale, running hundred-million-annotation workforces tuned to automotive and sensor-fusion programs. Boutique providers offer bespoke capture with strict compliance documentation for controlled manipulation tasks. New specialists focus purely on distributed egocentric capture, with contributors self-recording everyday tasks at volume. Hardware-first teams approach the problem through tiered teleoperation rigs, treating capture quality as an engineering discipline.\"}],\"\\n\",\"$L2c\",\"\\n\",\"$L2d\",\"\\n\",\"$L2e\",\"\\n\",\"$L2f\",\"\\n\",\"$L30\",\"\\n\",\"$L31\",\"\\n\",\"$L32\",\"\\n\",\"$L33\",\"\\n\",\"$L34\",\"\\n\",\"$L35\",\"\\n\",\"$L36\",\"\\n\",\"$L37\",\"\\n\",\"$L38\",\"\\n\",\"$L39\",\"\\n\",\"$L3a\",\"\\n\",\"$L3b\"],\"$L3c\"]}]\n2a:[\"$\",\"footer\",null,{\"className\":\"border-t border-white/[.08] bg-[#111620] py-12\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full max-w-[1440px] px-5 sm:px-8 lg:px-12 xl:px-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-10 lg:grid-cols-[1fr_auto] lg:items-start\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"$Lb\",null,{\"src\":\"/digirobotics/brand/digirobotics-logo.png\",\"alt\":\"DigiRobotics.xyz\",\"width\":210,\"height\":48,\"className\":\"h-auto w-[190px]\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-[17px] text-white/60\",\"children\":\"Egocentric data for robotics training.\"}]]}],[\"$\",\"nav\",null,{\"aria-label\":\"Footer navigation\",\"className\":\"flex max-w-2xl flex-wrap gap-x-7 gap-y-3\",\"children\":[[\"$\",\"a\",\"Contributor\",{\"href\":\"/#contributors\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Contributor\"}],[\"$\",\"a\",\"Marketplace\",{\"href\":\"/#marketplace\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Marketplace\"}],[\"$\",\"a\",\"Custom Data\",{\"href\":\"/#custom-data\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Custom Data\"}],[\"$\",\"a\",\"Capture Gear\",{\"href\":\"/gear\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Capture Gear\"}],[\"$\",\"a\",\"Articles\",{\"href\":\"/blog\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Articles\"}],[\"$\",\"a\",\"Agent Demo\",{\"href\":\"/agent-demo\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Agent Demo\"}],[\"$\",\"a\",\"Privacy & Terms\",{\"href\":\"/#privacy-note\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Privacy & Terms\"}],\"$L3d\"]}]]}],\"$L3e\",\"$L3f\",\"$L40\"]}]}]\n2c:[\"$\",\"p\",\"p-4\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"For buyers, the selection calculus now includes modality coverage, rig compatibility, automated QA, security compliance, and — critically — scalability. A vendor excellent at a 50-episode pilot often fails at production volume, in cost, throughput, or consistency.\"}]\n2d:[\"$\",\"p\",\"p-5\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"And public datasets, while a legitimate on-ramp — some covering over a million real-robot trajectories across dozens of robot types — cannot match a specific robot, environment, or task. Custom collection is where every serious program eventually lands.\"}]\n2e:[\"$\",\"h2\",\"h2-2\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Why Procurement Breaks at Scale\"}]\n2f:[\"$\",\"p\",\"p-6\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Here is the structural weakness in today's model: robotics data is bought the way enterprises buy consulting — negotiations, minimum engagements, fixed-price contracts, multi-week lead times. Meanwhile, the actual unit of value is tiny: one validated demonstration, one clean egocentric clip, one synchronized sensor pass.\"}]\n30:[\"$\",\"p\",\"p-7\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"That mismatch produces three failures. Slow iteration means a model team identifying a data gap waits weeks for a new procurement cycle to fill it. Elite gating means only well-funded labs can afford custom capture; contributors and smaller teams are locked out of supplying. Zero liquidity means captured data sits siloed, with no market mechanism to price, resell, or relicense it.\"}]\n31:[\"$\",\"p\",\"p-8\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"What the market lacks is not vendors. It is a rack rate — a way to transact at the resolution of a single capture.\"}]\n32:[\"$\",\"h2\",\"h2-3\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Micropayments Make Data Liquid\"}]\n33:[\"$\",\"p\",\"p-9\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Stablecoin settlement changes the unit economics of data entirely. Sub-cent transactions mean network fees below a cent versus a ~$0.30 card-fee floor that made small purchases impossible. Nanopayment sizes mean reported settlements as small as one millionth of a dollar, viable for per-frame or per-request billing. Instant settlement means seconds, not the multi-day windows of card rails. Programmable terms mean smart contracts defining who gets paid, when, and under what quality conditions. Streaming compensation means value flowing continuously, per second, ideal for contributor capture sessions.\"}]\n34:[\"$\",\"p\",\"p-10\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The revived HTTP 402 payment pattern completes the flow: a data endpoint declares its terms, an agent pays programmatically, verification happens, and the data is served — no account, no invoice, no minimum contract.\"}]\n35:[\"$\",\"p\",\"p-11\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"In the near term, the biggest payers will not be humans. They will be agents: robot fleets buying demonstrations of the exact task they're failing at, or paying per-scan for the metric 3D model of a new environment. Demand arrives as machine-fillable requests; supply answers with validated captures — each one a microtransaction.\"}]\n36:[\"$\",\"h2\",\"h2-4\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"How DigiRobotics Is Building the Future\"}]\n37:[\"$\",\"p\",\"p-12\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"DigiRobotics fuses the collection landscape with the payment rails. It is building a stablecoin-native data marketplace — the first venue where verified robotics data trades in machine-sized units: per capture, per clip, per scan. Its full lifecycle under one roof brings contributor networks, device verification, sensor sync validation, and annotation pipelines feeding directly into the marketplace. Agent-ready endpoints provide HTTP 402-style pay-per-request access so robots and AI agents purchase data autonomously, at the moment they need it. Its contributor economy lets capture specialists and everyday workers worldwide earn instantly in micropayments and streaming disbursements, turning physical experience into liquid income. And governance as infrastructure means consent, compliance, and quality validation are priced into every unit, not bolted on afterwards.\"}]\n38:[\"$\",\"p\",\"p-13\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The old model sold contracts. DigiRobotics sells experience — by the frame.\"}]\n39:[\"$\",\"h2\",\"h2-5\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Start Building With Us\"}]\n3a:[\"$\",\"p\",\"p-14\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Whether your robot is missing a thousand demonstrations or you have a camera rig and two free hands, the machine experience market is open.\"}]\n3b:[\"$\",\"p\",\"p-15\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Join DigiRobotics to buy, supply, or build on the world's first stablecoin-native marketplace for real-world robotics data.\"}]\n3c:[\"$\",\"div\",null,{\"className\":\"mt-16 border-t border-white/10 pt-8\",\"children\":[\"$\",\"$L26\",null,{\"href\":\"/blog\",\"className\":\"inline-flex min-h-11 items-center gap-2 rounded-full border border-white/15 px-5 py-3 text-[14px] font-semibold transition hover:border-[var(--primary)] hover:text-[var(--primary)]\",\"children\":[[\"$\",\"$La\",null,{\"ref\":\"$undefined\",\"icon\":\"$1e:props:children:2:props:children:0:props:children:1:props:children:0:props:children:0:props:icon\",\"className\":\"$undefined\",\"size\":16,\"aria-hidden\":\"true\"}],\" Return to the archive\"]}]}]\n3d:[\"$\",\"a\",\"Contact Us\",{\"href\":\"mailto:hello@digirobotics.xyz\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Contact Us\"}]\n3e:[\"$\",\"div\",null,{\"id\":\"privacy-note\",\"className\":\"mt-10 grid gap-4 border-t border-white/[.08] pt-6 text-[13px] leading-5 text-white/45 sm:grid-cols-[1fr_auto]\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Privacy and terms notices will be published before campaign enrollment or data collection begins. Contact the team for Phase 1 information.\"}],[\"$\",\"p\",null,{\"children\":\"© 2026 DigiRobotics\"}]]}]\n3f:[\"$\",\"div\",null,{\"className\":\"mt-6 flex items-center gap-4 text-white/45\",\"children\":[[\"$\",\"a\",null,{\"href\":\"#\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-white/45 hover:text-white transition-colors\",\"children\":[\"$\",\"$La\",null,{\"ref\":\"$undefined\",\"icon\":\"$14:props:children:0:props:children:props:icon\",\"className\":\"$undefined\",\"size\":18,\"aria-hidden\":\"true\"}]}],[\"$\",\"a\",null,{\"href\":\"#\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-white/45 hover:text-white transition-colors\",\"children\":[\"$\",\"$La\",null,{\"ref\":\"$undefined\",\"icon\":\"$14:props:children:1:props:children:props:icon\",\"className\":\"$undefined\",\"size\":18,\"aria-hidden\":\"true\"}]}]]}]\n40:[\"$\",\"p\",null,{\"className\":\"mt-5 font-mono text-[10px] uppercase tracking-[.12em] text-white/35\",\"children\":\"Agent-compatible payment workflows powered by stablecoins and x402. Phase 1 infrastructure.\"}]\n","segmentData":{"/_tree":":HL[\"/_next/static/css/9b6cbde999f1a60b.css\",\"style\"]\n:HL[\"/_next/static/css/1558ad27e78fe6f2.css\",\"style\"]\n0:{\"tree\":{\"name\":\"\",\"param\":null,\"prefetchHints\":4112,\"slots\":{\"children\":{\"name\":\"blog\",\"param\":null,\"prefetchHints\":4160,\"slots\":{\"children\":{\"name\":\"slug\",\"param\":{\"type\":\"d\",\"key\":\"the-data-supply-chain-gets-a-price-tag\",\"siblings\":[]},\"prefetchHints\":4192,\"slots\":{\"children\":{\"name\":\"__PAGE__\",\"param\":null,\"prefetchHints\":4256,\"slots\":null}}}}}}},\"staleTime\":300,\"buildId\":\"YK3G-22n_Yy3cwl6sVn3D\"}\n","/_full":"1:\"$Sreact.fragment\"\n3:I[60203,[\"66609\",\"static/chunks/66609-81fc326aefa2b35a.js\",\"17112\",\"static/chunks/17112-6d02a7878e38f17b.js\",\"96048\",\"static/chunks/96048-94353edf3fef0226.js\",\"37024\",\"static/chunks/37024-473db45fa25438c6.js\",\"7177\",\"static/chunks/app/layout-9ceac550056e754f.js\"],\"ThirdwebSessionProvider\"]\n4:I[35682,[\"66609\",\"static/chunks/66609-81fc326aefa2b35a.js\",\"17112\",\"static/chunks/17112-6d02a7878e38f17b.js\",\"96048\",\"static/chunks/96048-94353edf3fef0226.js\",\"37024\",\"static/chunks/37024-473db45fa25438c6.js\",\"7177\",\"static/chunks/app/layout-9ceac550056e754f.js\"],\"CartProvider\"]\n5:I[76826,[\"66609\",\"static/chunks/66609-81fc326aefa2b35a.js\",\"17112\",\"static/chunks/17112-6d02a7878e38f17b.js\",\"96048\",\"static/chunks/96048-94353edf3fef0226.js\",\"37024\",\"static/chunks/37024-473db45fa25438c6.js\",\"7177\",\"static/chunks/app/layout-9ceac550056e754f.js\"],\"AuthFlowProvider\"]\n6:I[57121,[],\"\"]\n7:I[78007,[\"99489\",\"static/chunks/99489-7b4b74c1a59849db.js\",\"5772\",\"static/chunks/5772-2ad3d6bb0136fa62.js\",\"57304\",\"static/chunks/57304-ca98254065b92130.js\",\"18039\",\"static/chunks/app/error-f0666043f78adcc8.js\"],\"default\"]\n8:I[74581,[],\"\"]\n9:I[57304,[\"99489\",\"static/chunks/99489-7b4b74c1a59849db.js\",\"5772\",\"static/chunks/5772-2ad3d6bb0136fa62.js\",\"57304\",\"static/chunks/57304-ca98254065b92130.js\",\"95953\",\"static/chunks/app/blog/%5Bslug%5D/page-a38ec015cb873e