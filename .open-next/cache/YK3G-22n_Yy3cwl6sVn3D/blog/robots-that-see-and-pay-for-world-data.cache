]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[170px_minmax(0,760px)] lg:justify-center\",\"children\":[\"$L27\",\"$L28\"]}]]}],\"$L29\"]}]\n21:null\n25:[[\"$\",\"title\",\"0\",{\"children\":\"Robots That See and Pay for World Data — DigiRobotics\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Third-person training data fails robots because they never see from their own eyes. Egocentric first-person datasets close the perception-action gap, and stablecoin micropayments make machine-payable data commerce viable — together forming a marketplace where robots buy verified first-person training data.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.webmanifest\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"https://digirobotics.xyz/blog/robots-that-see-and-pay-for-world-data\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:title\",\"content\":\"Robots That See and Pay for World Data\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:description\",\"content\":\"Third-person training data fails robots because they never see from their own eyes. Egocentric first-person datasets close the perception-action gap, and stablecoin micropayments make machine-payable data commerce viable — together forming a marketplace where robots buy verified first-person training data.\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:url\",\"content\":\"https://digirobotics.xyz/blog/robots-that-see-and-pay-for-world-data\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image\",\"content\":\"https://digirobotics.xyz/images/blog/robots-that-see-and-pay-for-world-data-cover.jpg\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:image:alt\",\"content\":\"Robots That See and Pay for World Data\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"10\",{\"property\":\"article:published_time\",\"content\":\"2026-11-20\"}],[\"$\",