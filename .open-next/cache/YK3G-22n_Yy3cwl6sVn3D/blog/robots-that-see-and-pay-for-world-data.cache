ze:22px_22px]\"}],[\"$\",\"div\",null,{\"className\":\"relative mx-auto max-w-5xl px-5 pb-16 pt-12 sm:px-8 sm:pb-24 sm:pt-16\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/blog\",\"className\":\"inline-flex min-h-11 items-center gap-2 font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--muted-foreground)] transition hover:text-[var(--primary)]\",\"children\":[[\"$\",\"$L4\",null,{\"icon\":{\"name\":\"arrow-left\",\"size\":24,\"node\":[[\"path\",{\"d\":\"m12 19-7-7 7-7\",\"key\":\"1l729n\"}],[\"path\",{\"d\":\"M19 12H5\",\"key\":\"x3x0zl\"}]]},\"size\":14,\"aria-hidden\":\"true\"}],\" Back to field notes\"]}],[\"$\",\"div\",null,{\"className\":\"mt-14 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[10px] uppercase tracking-[0.16em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[var(--primary)]\",\"children\":\"Robotics\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"text-white/25\",\"children\":\"/\"}],[\"$\",\"time\",null,{\"dateTime\":\"2026-11-20\",\"className\":\"text-[var(--muted-foreground)]\",\"children\":\"November 20, 2026\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"text-white/25\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-[var(--muted-foreground)]\",\"children\":\"11 min read\"}]]}],[\"$\",\"h1\",null,{\"className\":\"mt-6 max-w-5xl font-display text-3xl md:text-4xl font-bold leading-tight tracking-[-0.03em] text-white\",\"children\":\"Robots That See and Pay for World Data\"}],[\"$\",\"p\",null,{\"className\":\"mt-8 max-w-3xl text-xl leading-9 text-[var(--muted-foreground)] sm:text-2xl\",\"children\":\"Third-person training data fails robots because they never see from their own eyes. Egocentric first-person datasets close the perception-action gap, and stablecoin micropayments make machine-payable data commerce viable — together forming a marketplace where robots buy verified first-person training data.\"}],[\"$\",\"div\",null,{\"className\":\"mt-10 flex items-center gap-3 text-[14px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"grid size-10 place-items-center rounded-full border border-[var(--primary)]/40 bg-[var(--primary)]/10 font-heading text-[var(--primary)]\",\"children\":\"DR\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"DigiRobotics Team\"}],[\"$\",\"p\",null,{\"className\":\"mt-0.5 text-[12px] text-[var(--muted-foreground)]\",\"children\":[\"Updated \",\"November 20, 2026\"]}]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[170px_minmax(0,760px)] lg:justify-center\",\"children\":[\"$L5\",\"$L6\"]}]]}],\"$L7\"]}],null,\"$L8\"]}],\"isPartial\":\"$@9\",\"staleTime\":\"$a\",\"varyParams\":null},{\"rsc\":\"$Lb\",\"isPartial\":\"$@c\",\"staleTime\":\"$a\",\"varyParams\":null},{\"rsc\":\"$Ld\",\"isPartial\":\"$@e\",\"staleTime\":\"$a\",\"varyParams\":\"$f\"},{\"rsc\":\"$L10\",\"isPartial\":\"$@11\",\"staleTime\":\"$a\",\"varyParams\":\"$f\"}],\"isUpgradeableISRFallback\":false,\"a\":\"$@12\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@13\"}\n22:I[38437,[\"99489\",\"static/chunks/99489-7b4b74c1a59849db.js\",\"5772\",\"static/chunks/5772-2ad3d6bb0136fa62.js\",\"57304\",\"static/chunks/57304-ca98254065b92130.js\",\"95953\",\"static/chunks/app/blog/%5Bslug%5D/page-a38ec015cb873e3f.js\"],\"Image\"]\n27:I[90484,[],\"OutletBoundary\"]\n28:\"$Sreact.suspense\"\n2a:I[90484,[],\"ViewportBoundary\"]\n2b:I[90484,[],\"MetadataBoundary\"]\n2c:I[86869,[],\"IconMark\"]\n2d:I[57121,[],\"\"]\n2e:I[74581,[],\"\"]\n5:[\"$\",\"aside\",null,{\"className\":\"hidden lg:block\",\"children\":[\"$\",\"div\",null,{\"className\":\"sticky top-28 border-t border-[var(--primary)] pt-4 font-mono text-[9px] uppercase leading-5 tracking-[0.15em] text-[var(--muted-foreground)]\",\"children\":[\"DigiRobotics\",[\"$\",\"br\",null,{}],\"Field note\",[\"$\",\"br\",null,{}],\"2026.11.20\"]}]}]\n6:[\"$\",\"div\",null,{\"className\":\"min-w-0\",\"children\":[[[\"$\",\"blockquote\",\"blockquote-0\",{\"className\":\"my-10 border-l-2 border-[var(--primary)] bg-[var(--primary)]/[0.06] px-6 py-2 font-heading text-xl leading-8 text-white sm:px-8\",\"children\":[\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"font-semibold text-white\",\"children\":\"TL;DR:\"}]}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Most robot training data is captured from third-person cameras — but robots act through their own \\\"eyes,\\\" creating a perception–action mismatch that breaks real-world performance. Egocentric first-person datasets align what a model learns with what it sees during execution, making manipulation far more reliable. Scaling first-person data is hard: labeling is expensive, occlusions are common, and contributor diversity is limited. Agentic payment rails — fast, sub-cent, always-on settlement — let machines buy compute, APIs, and data autonomously. The fusion of both: a machine-payable marketplace for real-world egocentric robotics data.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"h2\",\"h2-0\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Why Third-Person Training Data Fails\"}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Picture a robot trained to pick up a cup using footage shot from a camera in the corner of the room. The clip looks clean — but the robot will never experience the world from that corner. During deployment, its onboard camera faces a scene it never rehearsed.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"This is the perception–action mismatch, and it is the quiet failure behind many underperforming manipulation systems. Lost contact detail — third-person views obscure the precise hand-object contact points where manipulation succeeds or fails. Distorted depth cues — external perspectives flatten the geometry the robot must reason about. Broken generalization — the model memorizes scenes from a viewpoint it will never occupy.\"}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"First-Person Data Changes Robot Learning\"}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Egocentric datasets close the gap by capturing the world exactly as the actor experiences it — head-mounted, wrist-mounted, or robot-mounted cameras recording what the \\\"eyes\\\" actually see while a task unfolds. When training input matches deployment input, perception and action finally align, and manipulation behavior becomes measurably more stable.\"}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The field is scaling fast. Recent landmark datasets include ~10,000 hours of first-person factory footage — a billion-frame industrial corpus with per-worker camera calibration, enabling geometry-aware perception, visual odometry, and 3D learning out of the box. There is 3,600+ hours of everyday activity video — captured across hundreds of participants and countries, powering action understanding and human-object interaction research. Fine-grained kitchen benchmarks include millions of frames labeled with verb–noun action pairs like open fridge and cut apple, with high-detail editions adding recipe steps, gaze, and audio grounded in 3D kitchen replicas. And there is multimodal robot navigation data — synchronized camera, fisheye, and LiDAR streams from crowded, unstructured environments, with over a million 3D bounding-box annotations.\"}],\"\\n\",\"$L14\",\"\\n\",\"$L15\",\"\\n\",\"$L16\",\"\\n\",\"$L17\",\"\\n\",\"$L18\",\"\\n\",\"$L19\",\"\\n\",\"$L1a\",\"\\n\",\"$L1b\",\"\\n\",\"$L1c\",\"\\n\",\"$L1d\",\"\\n\",\"$L1e\",\"\\n\",\"$L1f\",\"\\n\",\"$L20\"],\"$L21\"]}]\n7:[\"$\",\"footer\",null,{\"className\":\"border-t border-white/[.08] bg-[#111620] py-12\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full max-w-[1440px] px-5 sm:px-8 lg:px-12 xl:px-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-10 lg:grid-cols-[1fr_auto] lg:items-start\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"$L22\",null,{\"src\":\"/digirobotics/brand/digirobotics-logo.png\",\"alt\":\"DigiRobotics.xyz\",\"width\":210,\"height\":48,\"className\":\"h-auto w-[190px]\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-[17px] text-white/60\",\"children\":\"Egocentric data for robotics training.\"}]]}],[\"$\",\"nav\",null,{\"aria-label\":\"Footer navigation\",\"className\":\"flex max-w-2xl flex-wrap gap-x-7 gap-y-3\",\"children\":[[\"$\",\"a\",\"Contributor\",{\"href\":\"/#contributors\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Contributor\"}],[\"$\",\"a\",\"Marketplace\",{\"href\":\"/#marketplace\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Marketplace\"}],[\"$\",\"a\",\"Custom Data\",{\"href\":\"/#custom-data\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Custom Data\"}],[\"$\",\"a\",\"Capture Gear\",{\"href\":\"/gear\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Capture Gear\"}],[\"$\",\"a\",\"Articles\",{\"href\":\"/blog\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Articles\"}],[\"$\",\"a\",\"Agent Demo\",{\"href\":\"/agent-demo\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Agent Demo\"}],[\"$\",\"a\",\"Privacy & Terms\",{\"href\":\"/#privacy-note\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Privacy & Terms\"}],\"$L23\"]}]]}],\"$L24\",\"$L25\",\"$L26\"]}]}]\n8:[\"$\",\"$L27\",null,{\"children\":[\"$\",\"$28\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@29\"}]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L2a\",null,{\"children\":[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L2b\",null,{\"children\":[\"$\",\"$28\",null,{\"name\":\"Next.Metadata\",\"children\":[[\"$\",\"title\",\"0\",{\"children\":\"Robots That See and Pay for World Data — DigiRobotics\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Third-person training data fails robots because they never see from their own eyes. Egocentric first-person datasets close the perception-action gap, and stablecoin micropayments make machine-payable data commerce viable — together forming a marketplace where robots buy verified first-person training data.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.webmanifest\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"https://digirobotics.xyz/blog/robots-that-see-and-pay-for-world-data\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:title\",\"content\":\"Robots That See and Pay for World Data\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:description\",\"content\":\"Third-person training data fails robots because they never see from their own eyes. Egocentric first-person datasets close the perception-action gap, and stablecoin micropayments make machine-payable data commerce viable — together forming a marketplace where robots buy verified first-person training data.\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:url\",\"content\":\"https://digirobotics.xyz/blog/robots-that-see-and-pay-for-world-data\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image\",\"content\":\"https://digirobotics.xyz/images/blog/robots-that-see-and-pay-for-world-data-cover.jpg\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:image:alt\",\"content\":\"Robots That See and Pay for World Data\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"10\",{\"property\":\"article:published_time\",\"content\":\"2026-11-20\"}],[\"$\",\"meta\",\"11\",{\"property\":\"article:modified_time\",\"content\":\"2026-11-20\"}],[\"$\",\"meta\",\"12\",{\"property\":\"article:author\",\"content\":\"DigiRobotics Team\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:title\",\"content\":\"Robots That See and Pay for World Data\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:description\",\"content\":\"Third-person training data fails robots because they never see from their own eyes. Egocentric first-person datasets close the perception-action gap, and stablecoin micropayments make machine-payable data commerce viable — together forming a marketplace where robots buy verified first-person training data.\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:image\",\"content\":\"https://digirobotics.xyz/images/blog/robots-that-see-and-pay-for-world-data-cover.jpg\"}],[\"$\",\"link\",\"17\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?63d5b2ef705d808e\",\"type\":\"image/x-icon\",\"sizes\":\"256x256\"}],[\"$\",\"link\",\"18\",{\"rel\":\"icon\",\"href\":\"/icon.png?1f3d5ce59ec9c445\",\"type\":\"image/png\",\"sizes\":\"1254x1254\"}],[\"$\",\"link\",\"19\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-icon.png?1f3d5ce59ec9c445\",\"type\":\"image/png\",\"sizes\":\"1254x1254\"}],[\"$\",\"$L2c\",\"20\",{}]]}]}]}],null]}]\nd:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2d\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L2e\",null,{}]}]]}]\n10:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2d\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L2e\",null,{}]}]]}]\n13:true\n14:[\"$\",\"p\",\"p-4\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Together these prove the pattern: first-person, well-annotated, sensor-rich data is the substrate of capable embodied AI — and it is becoming the most contested resource in robotics.\"}]\n15:[\"$\",\"h2\",\"h2-2\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"The Real Gaps Still to Close\"}]\n16:[\"$\",\"p\",\"p-5\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Egocentric data is powerful, but four structural bottlenecks limit it today. Labeling cost — fine-grained, time-aligned action annotations are slow and expensive to produce. Visual noise and occlusion — fast head and hand motion creates blur; the very hands being studied block the objects they manipulate. Hardware inconsistency — wearable rigs vary in alignment, intrinsics, and placement across contributors. Bias and diversity gaps — small contributor pools produce narrow distributions that fail on unseen tasks and environments.\"}]\n17:[\"$\",\"p\",\"p-6\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Closing these gaps demands more than bigger lab budgets. It requires distributed collection at scale — thousands of contributors, verified devices, quality validation, and consent governance — plus a way to price and exchange that data efficiently.\"}]\n18:[\"$\",\"h2\",\"h2-3\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"When Robots Pay Their Own Way\"}]\n19:[\"$\",\"p\",\"p-7\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Simultaneously, the economic layer for autonomous machines is materializing. Agentic payments — transactions initiated and settled by software with no human in the loop — are moving from concept to production infrastructure. HTTP-native payment protocols turn a long-unused web status code into a pay-per-request layer: an agent requests a resource, pays, and receives verified access in one automated loop. High-throughput blockchain rails deliver sub-cent fees and near-instant finality, making high-frequency machine-to-machine transactions economical. Stablecoins provide the value format machines need: globally portable, continuously settling, and programmable. Smart contracts encode who gets paid, when, and why — automating royalties, usage fees, and payouts between services.\"}]\n1a:[\"$\",\"p\",\"p-8\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Put the two trends together and a new market appears. A robot (or its controlling agent) that needs more egocentric training data for a new task — a new warehouse layout, a new tool, a new climate — could simply pay another machine or human contributor for it, settle in seconds, and keep learning. Data supply meets machine demand, with no checkout page in between.\"}]\n1b:[\"$\",\"h2\",\"h2-4\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"How DigiRobotics Is Building the Future\"}]\n1c:[\"$\",\"p\",\"p-9\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"DigiRobotics is building that intersection. It is creating a stablecoin-native data marketplace — the world's first rail where real-world robotics data is collected, validated, and exchanged through machine-speed, agent-friendly payments. Its egocentric-first collection uses distributed contributor networks capturing authentic first-person work across households, factories, and field environments. Quality and governance are built in — consent, device validation, calibration standards, and labeling pipelines that cut the cost of time-aligned action data. And its agentic commerce readiness means infrastructure designed for the moment when robots buy data, pay for compute, and sell their own task records autonomously.\"}]\n1d:[\"$\",\"p\",\"p-10\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Robots that see like their operators. Rails that let them transact like economic actors. One platform.\"}]\n1e:[\"$\",\"h2\",\"h2-5\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Start Building With Us\"}]\n1f:[\"$\",\"p\",\"p-11\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The market for machine-readable, first-person physical-world experience is forming now.\"}]\n20:[\"$\",\"p\",\"p-12\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Partner with DigiRobotics to contribute data, integrate your embodied AI stack, or prepare your robotics operation for the agentic commerce economy.\"}]\n21:[\"$\",\"div\",null,{\"className\":\"mt-16 border-t border-white/10 pt-8\",\"children\":[\"$\",\"$L3\",null,{\"href\":\"/blog\",\"className\":\"inline-flex min-h-11 items-center gap-2 rounded-full border border-white/15 px-5 py-3 text-[14px] font-semibold transition hover:border-[var(--primary)] hover:text-[var(--primary)]\",\"children\":[[\"$\",\"$L4\",null,{\"icon\":\"$0:data:0:rsc:props:children:0:props:children:2:props:children:0:props:children:1:props:children:0:props:children:0:props:icon\",\"size\":16,\"aria-hidden\":\"true\"}],\" Return to the archive\"]}]}]\n23:[\"$\",\"a\",\"Contact Us\",{\"href\":\"mailto:hello@digirobotics.xyz\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Contact Us\"}]\n24:[\"$\",\"div\",null,{\"id\":\"privacy-note\",\"className\":\"mt-10 grid gap-4 border-t border-white/[.08] pt-6 text-[13px] leading-5 text-white/45 sm:grid-cols-[1fr_auto]\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Privacy and terms notices will be published before campaign enrollment or data collection begins. Contact the team for Phase 1 information.\"}],[\"$\",\"p\",null,{\"children\":\"© 2026 DigiRobotics\"}]]}]\n25:[\"$\",\"div\",null,{\"className\":\"mt-6 flex items-center gap-4 text-white/45\",\"children\":[[\"$\",\"a\",null,{\"href\":\"#\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-white/45 hover:text-white transition-colors\",\"children\":[\"$\",\"$L4\",null,{\"icon\":{\"name\":\"x\",\"size\":24,\"node\":[[\"path\",{\"d\":\"M18 6 6 18\",\"key\":\"1bl5f8\"}],[\"path\",{\"d\":\"m6 6 12 12\",\"key\":\"d8bk6v\"}]]},\"size\":18,\"aria-hidden\":\"true\"}]}],[\"$\",\"a\",null,{\"href\":\"#\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-white/45 hover:text-white transition-colors\",\"children\":[\"$\",\"$L4\",null,{\"icon\":{\"name\":\"mail\",\"size\":24,\"node\":[[\"path\",{\"d\":\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\",\"key\":\"132q7q\"}],[\"rect\",{\"x\":\"2\",\"y\":\"4\",\"width\":\"20\",\"height\":\"16\",\"rx\":\"2\",\"key\":\"izxlao\"}]]},\"size\":18,\"aria-hidden\":\"true\"}]}]]}]\n26:[\"$\",\"p\",null,{\"className\":\"mt-5 font-mono text-[10px] uppercase tracking-[.12em] text-white/35\",\"children\":\"Agent-compatible payment workflows powered by stablecoins and x402. Phase 1 infrastructure.\"}]\n29:null\na:300\na:C\n12:0\nc:\"$undefined\"\ne:\"$undefined\"\n11:\"$undefined\"\n9:\"$undefined\"\n"}}