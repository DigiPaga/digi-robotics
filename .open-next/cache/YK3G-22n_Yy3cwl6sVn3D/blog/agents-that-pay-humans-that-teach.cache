le-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Contact Us\"}]\n13:[\"$\",\"div\",null,{\"id\":\"privacy-note\",\"className\":\"mt-10 grid gap-4 border-t border-white/[.08] pt-6 text-[13px] leading-5 text-white/45 sm:grid-cols-[1fr_auto]\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Privacy and terms notices will be published before campaign enrollment or data collection begins. Contact the team for Phase 1 information.\"}],[\"$\",\"p\",null,{\"children\":\"© 2026 DigiRobotics\"}]]}]\n14:[\"$\",\"div\",null,{\"className\":\"mt-6 flex items-center gap-4 text-white/45\",\"children\":[[\"$\",\"a\",null,{\"href\":\"#\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-white/45 hover:text-white transition-colors\",\"children\":[\"$\",\"$La\",null,{\"ref\":\"$undefined\",\"icon\":{\"name\":\"x\",\"size\":24,\"node\":[[\"path\",{\"d\":\"M18 6 6 18\",\"key\":\"1bl5f8\"}],[\"path\",{\"d\":\"m6 6 12 12\",\"key\":\"d8bk6v\"}]]},\"className\":\"$undefined\",\"size\":18,\"aria-hidden\":\"true\"}]}],[\"$\",\"a\",null,{\"href\":\"#\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-white/45 hover:text-white transition-colors\",\"children\":[\"$\",\"$La\",null,{\"ref\":\"$undefined\",\"icon\":{\"name\":\"mail\",\"size\":24,\"node\":[[\"path\",{\"d\":\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\",\"key\":\"132q7q\"}],[\"rect\",{\"x\":\"2\",\"y\":\"4\",\"width\":\"20\",\"height\":\"16\",\"rx\":\"2\",\"key\":\"izxlao\"}]]},\"className\":\"$undefined\",\"size\":18,\"aria-hidden\":\"true\"}]}]]}]\n15:[\"$\",\"p\",null,{\"className\":\"mt-5 font-mono text-[10px] uppercase tracking-[.12em] text-white/35\",\"children\":\"Agent-compatible payment workflows powered by stablecoins and x402. Phase 1 infrastructure.\"}]\n16:[\"$\",\"$L1d\",null,{}]\n17:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L6\",null,{\"parallelRouterKe