://schema.org\\\",\\\"@type\\\":\\\"BlogPosting\\\",\\\"headline\\\":\\\"Trust Rails for the Robot Data Market\\\",\\\"description\\\":\\\"The robotics training data market is fragmented and trust-starved. DigiRobotics is building a stablecoin-native exchange where provenance, confirmation gates, and layered security make data verifiable before agents ever click buy.\\\",\\\"datePublished\\\":\\\"2026-11-20\\\",\\\"dateModified\\\":\\\"2026-11-20\\\",\\\"author\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"DigiRobotics Team\\\"},\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"DigiRobotics\\\",\\\"url\\\":\\\"https://digirobotics.xyz\\\"},\\\"mainEntityOfPage\\\":\\\"https://digirobotics.xyz/blog/trust-rails-for-the-robot-data-market\\\",\\\"image\\\":\\\"https://digirobotics.xyz/images/blog/trust-rails-for-the-robot-data-market-cover.jpg\\\"}\"}}],[\"$\",\"article\",null,{\"children\":[[\"$\",\"header\",null,{\"className\":\"relative overflow-hidden border-b border-white/10\",\"children\":[[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute inset-0 opacity-25 [background-image:radial-gradient(oklch(from_var(--primary)_l_c_h_/_24%)_1px,transparent_1px)] [background-size:22px_22px]\"}],[\"$\",\"div\",null,{\"className\":\"relative mx-auto max-w-5xl px-5 pb-16 pt-12 sm:px-8 sm:pb-24 sm:pt-16\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/blog\",\"className\":\"inline-flex min-h-11 items-center gap-2 font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--muted-foreground)] transition hover:text-[var(--primary)]\",\"children\":[[\"$\",\"$L4\",null,{\"icon\":{\"name\":\"arrow-left\",\"size\":24,\"node\":[[\"path\",{\"d\":\"m12 19-7-7 7-7\",\"key\":\"1l729n\"}],[\"path\",{\"d\":\"M19 12H5\",\"key\":\"x3x0zl\"}]]},\"size\":14,\"aria-hidden\":\"true\"}],\" Back to field notes\"]}],[\"$\",\"div\",null,{\"className\":\"mt-14 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[10px] uppercase tracking-[0.16em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[var(--primary)]\",\"children\":\"Robotics\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"text-white/25\",\"children\":\"/\"}],[\"$\",\"time\",null,{\"dateTime\":\"2026-11-20\",\"className\":\"text-[var(--muted-foreground)]\",\"children\":\"November 20, 2026\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"text-white/25\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-[var(--muted-foreground)]\",\"children\":\"14 min read\"}]]}],[\"$\",\"h1\",null,{\"className\":\"mt-6 max-w-5xl font-display text-3xl md:text-4xl font-bold leading-tight tracking-[-0.03em] text-white\",\"children\":\"Trust Rails for the Robot Data Market\"}],[\"$\",\"p\",null,{\"className\":\"mt-8 max-w-3xl text-xl leading-9 text-[var(--muted-foreground)] sm:text-2xl\",\"children\":\"The robotics training data market is fragmented and trust-starved. DigiRobotics is building a stablecoin-native exchange where provenance, confirmation gates, and layered security make data verifiable before agents ever click buy.\"}],[\"$\",\"div\",null,{\"className\":\"mt-10 flex items-center gap-3 text-[14px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"grid size-10 place-items-center rounded-full border border-[var(--primary)]/40 bg-[var(--primary)]/10 font-heading text-[var(--primary)]\",\"children\":\"DR\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold\",\"children\":\"DigiRobotics Team\"}],[\"$\",\"p\",null,{\"className\":\"mt-0.5 text-[12px] text-[var(--muted-foreground)]\",\"children\":[\"Updated \",\"November 20, 2026\"]}]]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[170px_minmax(0,760px)] lg:justify-center\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"hidden lg:block\",\"children\":[\"$\",\"div\",null,{\"className\":\"sticky top-28 border-t border-[var(--primary)] pt-4 font-mono text-[9px] uppercase leading-5 tracking-[0.15em] text-[var(--muted-foreground)]\",\"children\":[\"DigiRobotics\",\"$L5\",\"Field note\",\"$L6\",\"2026.11.20\"]}]}],\"$L7\"]}]]}],\"$L8\"]}],null,\"$L9\"]}],\"isPartial\":\"$@a\",\"staleTime\":\"$b\",\"varyParams\":null},{\"rsc\":\"$Lc\",\"isPartial\":\"$@d\",\"staleTime\":\"$b\",\"varyParams\":null},{\"rsc\":\"$Le\",\"isPartial\":\"$@f\",\"staleTime\":\"$b\",\"varyParams\":\"$10\"},{\"rsc\":\"$L11\",\"isPartial\":\"$@12\",\"staleTime\":\"$b\",\"varyParams\":\"$10\"}],\"isUpgradeableISRFallback\":false,\"a\":\"$@13\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@14\"}\n22:I[38437,[\"99489\",\"static/chunks/99489-7b4b74c1a59849db.js\",\"5772\",\"static/chunks/5772-2ad3d6bb0136fa62.js\",\"57304\",\"static/chunks/57304-ca98254065b92130.js\",\"95953\",\"static/chunks/app/blog/%5Bslug%5D/page-a38ec015cb873e3f.js\"],\"Image\"]\n27:I[90484,[],\"OutletBoundary\"]\n28:\"$Sreact.suspense\"\n2a:I[90484,[],\"ViewportBoundary\"]\n2b:I[90484,[],\"MetadataBoundary\"]\n2c:I[86869,[],\"IconMark\"]\n2d:I[57121,[],\"\"]\n2e:I[74581,[],\"\"]\n5:[\"$\",\"br\",null,{}]\n6:[\"$\",\"br\",null,{}]\n7:[\"$\",\"div\",null,{\"className\":\"min-w-0\",\"children\":[[[\"$\",\"blockquote\",\"blockquote-0\",{\"className\":\"my-10 border-l-2 border-[var(--primary)] bg-[var(--primary)]/[0.06] px-6 py-2 font-heading text-xl leading-8 text-white sm:px-8\",\"children\":[\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"font-semibold text-white\",\"children\":\"TL;DR:\"}]}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The robotics training data market has become a gold rush, with dozens of funded companies competing across demonstrations, teleoperation, curation, and synthetic data. Fragmented supply creates a trust problem — buyers cannot easily verify provenance, consent, and quality across vendors. Research on agentic commerce protocols shows trust comes from confirmation gates, override mechanisms, and layered security — not just speed. Applied to robotics data, trust architecture becomes the differentiator: agents will only buy from marketplaces they can verify. DigiRobotics is building that trusted, stablecoin-native exchange for real-world robotics data.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"h2\",\"h2-0\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"A Fragmented Data Gold Rush\"}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The race to supply real-world robotics data has exploded. A current landscape scan counts over forty companies organized into four distinct categories, most founded within the past two years. The largest segment is human-centric demonstration data, which pays people to record themselves performing everyday household, industrial, and trade tasks from a first-person view. Then there is robot-centric demonstration and teleoperation, where humans operate real robots remotely, capturing robot-native trajectories. Processing and curation pipelines validate sync, grade quality, verify whether robot rollouts succeeded, and package raw recordings into training-ready datasets. Finally, synthetic data generation creates simulated scenes serving rare, degraded, or dangerous scenarios that real capture cannot reach.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The patterns are telling. Capture networks are going physical — some operators now run dozens of capture stations across multiple sites, recording hundreds of synchronized hours per day. Contributor economies are forming, paying everyday workers to film real tasks. And provenance is becoming a product feature: consent-cleared, chain-of-custody tracked datasets with explicit format standards.\"}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"But look closely at the landscape and something is missing. Every vendor is a pipeline, not a market. Buyers must vet each supplier separately, negotiate separately, and trust separately.\"}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Trust Is the Missing Transaction Layer\"}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Fresh academic research on agentic commerce protocols — AI-mediated transactions between software buyers, sellers, and services — recently mapped what this new transactional world requires. Its integrative review converges on three findings. First, dual-pathway design: purely functional competence is not enough; transaction systems must also carry signaling that builds confidence — transparency of process, visible verification, and consistent conduct over time. Second, autonomy-preserving guardrails: explicitly designed confirmation gates for consequential actions, and override options that let a human step in without dismantling the automation. Trust is built by giving people deliberate control points, not by removing humans entirely. Third, layered security architecture: identity, authorization, and verification enforced at multiple independent layers, because a single perimeter fails when transactions no longer pass through human hands.\"}],\"\\n\",\"$L15\",\"\\n\",\"$L16\",\"\\n\",\"$L17\",\"\\n\",\"$L18\",\"\\n\",\"$L19\",\"\\n\",\"$L1a\",\"\\n\",\"$L1b\",\"\\n\",\"$L1c\",\"\\n\",\"$L1d\",\"\\n\",\"$L1e\",\"\\n\",\"$L1f\",\"\\n\",\"$L20\"],\"$L21\"]}]\n8:[\"$\",\"footer\",null,{\"className\":\"border-t border-white/[.08] bg-[#111620] py-12\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full max-w-[1440px] px-5 sm:px-8 lg:px-12 xl:px-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-10 lg:grid-cols-[1fr_auto] lg:items-start\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"$L22\",null,{\"src\":\"/digirobotics/brand/digirobotics-logo.png\",\"alt\":\"DigiRobotics.xyz\",\"width\":210,\"height\":48,\"className\":\"h-auto w-[190px]\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-[17px] text-white/60\",\"children\":\"Egocentric data for robotics training.\"}]]}],[\"$\",\"nav\",null,{\"aria-label\":\"Footer navigation\",\"className\":\"flex max-w-2xl flex-wrap gap-x-7 gap-y-3\",\"children\":[[\"$\",\"a\",\"Contributor\",{\"href\":\"/#contributors\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Contributor\"}],[\"$\",\"a\",\"Marketplace\",{\"href\":\"/#marketplace\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Marketplace\"}],[\"$\",\"a\",\"Custom Data\",{\"href\":\"/#custom-data\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Custom Data\"}],[\"$\",\"a\",\"Capture Gear\",{\"href\":\"/gear\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Capture Gear\"}],[\"$\",\"a\",\"Articles\",{\"href\":\"/blog\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Articles\"}],[\"$\",\"a\",\"Agent Demo\",{\"href\":\"/agent-demo\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Agent Demo\"}],[\"$\",\"a\",\"Privacy & Terms\",{\"href\":\"/#privacy-note\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Privacy & Terms\"}],\"$L23\"]}]]}],\"$L24\",\"$L25\",\"$L26\"]}]}]\n9:[\"$\",\"$L27\",null,{\"children\":[\"$\",\"$28\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@29\"}]}]\nc:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L2a\",null,{\"children\":[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L2b\",null,{\"children\":[\"$\",\"$28\",null,{\"name\":\"Next.Metadata\",\"children\":[[\"$\",\"title\",\"0\",{\"children\":\"Trust Rails for the Robot Data Market — DigiRobotics\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"The robotics training data market is fragmented and trust-starved. DigiRobotics is building a stablecoin-native exchange where provenance, confirmation gates, and layered security make data verifiable before agents ever click buy.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.webmanifest\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"https://digirobotics.xyz/blog/trust-rails-for-the-robot-data-market\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:title\",\"content\":\"Trust Rails for the Robot Data Market\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:description\",\"content\":\"The robotics training data market is fragmented and trust-starved. DigiRobotics is building a stablecoin-native exchange where provenance, confirmation gates, and layered security make data verifiable before agents ever click buy.\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:url\",\"content\":\"https://digirobotics.xyz/blog/trust-rails-for-the-robot-data-market\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image\",\"content\":\"https://digirobotics.xyz/images/blog/trust-rails-for-the-robot-data-market-cover.jpg\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:image:alt\",\"content\":\"Trust Rails for the Robot Data Market\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"10\",{\"property\":\"article:published_time\",\"content\":\"2026-11-20\"}],[\"$\",\"meta\",\"11\",{\"property\":\"article:modified_time\",\"content\":\"2026-11-20\"}],[\"$\",\"meta\",\"12\",{\"property\":\"article:author\",\"content\":\"DigiRobotics Team\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:title\",\"content\":\"Trust Rails for the Robot Data Market\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:description\",\"content\":\"The robotics training data market is fragmented and trust-starved. DigiRobotics is building a stablecoin-native exchange where provenance, confirmation gates, and layered security make data verifiable before agents ever click buy.\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:image\",\"content\":\"https://digirobotics.xyz/images/blog/trust-rails-for-the-robot-data-market-cover.jpg\"}],[\"$\",\"link\",\"17\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?63d5b2ef705d808e\",\"type\":\"image/x-icon\",\"sizes\":\"256x256\"}],[\"$\",\"link\",\"18\",{\"rel\":\"icon\",\"href\":\"/icon.png?1f3d5ce59ec9c445\",\"type\":\"image/png\",\"sizes\":\"1254x1254\"}],[\"$\",\"link\",\"19\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-icon.png?1f3d5ce59ec9c445\",\"type\":\"image/png\",\"sizes\":\"1254x1254\"}],[\"$\",\"$L2c\",\"20\",{}]]}]}]}],null]}]\ne:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2d\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L2e\",null,{}]}]]}]\n11:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2d\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L2e\",null,{}]}]]}]\n14:true\n15:[\"$\",\"p\",\"p-4\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The review's most important implication: as AI agents become economic actors, the design of the transaction layer — not the intelligence of the agent — becomes the trust bottleneck. An agent economy without verification, consent gates, and accountability remains a laboratory curiosity, not a market.\"}]\n16:[\"$\",\"p\",\"p-5\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The robotics data market is about to test that thesis at scale.\"}]\n17:[\"$\",\"h2\",\"h2-2\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"When Agents Buy Experience\"}]\n18:[\"$\",\"p\",\"p-6\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Robotics fleets — and their controlling agents — are the natural customers of the fragmented data landscape. A warehouse robot that keeps dropping a specific component doesn't need a procurement contract with a data vendor; it needs twenty validated first-person demonstrations of that exact grasp.\"}]\n19:[\"$\",\"p\",\"p-7\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Designing that transaction correctly requires importing the trust findings directly into the data market. Provenance becomes a first-class trade attribute — every capture carries verifiable chain-of-custody: who recorded it, on which validated device, with what consent and location authorization. Alongside quality grading, provenance becomes part of the price. Confirmation gates govern consequential purchases — high-value or sensitive datasets trigger a human approval step while routine microtransactions flow autonomously. Autonomy scales; judgment stays in the loop. Layered verification stacks device attestation, contributor identity, quality scoring, and settlement verification as independent, stacked checks — mirroring the layered-security architecture the research prescribes. Reputation becomes capital — reliable suppliers of clean, rights-cleared data accrue verifiable track records that agents and buyers can query before transacting.\"}]\n1a:[\"$\",\"p\",\"p-8\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Payments make the market possible; trust makes it survivable. Stablecoin settlement provides the speed and unit economics — sub-cent, instant, programmable — while the trust layer determines whether any rational fleet operator ever lets an agent click \\\"buy.\\\"\"}]\n1b:[\"$\",\"h2\",\"h2-3\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"How DigiRobotics Is Building the Future\"}]\n1c:[\"$\",\"p\",\"p-9\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"DigiRobotics treats these findings as a build spec, not a research note. The company is building a stablecoin-native marketplace for real-world robotics data, where captures from human contributors, teleoperation rigs, and validated capture stations trade as priced, licensed units. Its provenance-first architecture embeds consent, device verification, and chain-of-custody at capture time, so every dataset arrives pre-trusted rather than post-audited. Confirmation gates and override rails build human control points into agentic purchasing flows, matching enterprise trust with machine-speed commerce. Layered security and reputation systems provide independent verification at every layer, with contributor track records accrued as queryable market capital. Finally, instant, machine-payable settlement enables sub-cent and streaming payments that let robots, agents, and data buyers transact at the pace physical AI actually learns.\"}]\n1d:[\"$\",\"p\",\"p-10\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The gold rush supplies the data. The trust rails determine who wins it.\"}]\n1e:[\"$\",\"h2\",\"h2-4\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Start Building With Us\"}]\n1f:[\"$\",\"p\",\"p-11\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Fragmented supply meets autonomous demand. The winners will be those who make both sides verifiably trustworthy.\"}]\n20:[\"$\",\"p\",\"p-12\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Connect with DigiRobotics to supply data, source training experience, or build on the trust-first infrastructure for agentic commerce in physical AI.\"}]\n21:[\"$\",\"div\",null,{\"className\":\"mt-16 border-t border-white/10 pt-8\",\"children\":[\"$\",\"$L3\",null,{\"href\":\"/blog\",\"className\":\"inline-flex min-h-11 items-center gap-2 rounded-full border border-white/15 px-5 py-3 text-[14px] font-semibold transition hover:border-[var(--primary)] hover:text-[var(--primary)]\",\"children\":[[\"$\",\"$L4\",null,{\"icon\":\"$0:data:0:rsc:props:children:0:props:children:2:props:children:0:props:children:1:props:children:0:props:children:0:props:icon\",\"size\":16,\"aria-hidden\":\"true\"}],\" Return to the archive\"]}]}]\n23:[\"$\",\"a\",\"Contact Us\",{\"href\":\"mailto:hello@digirobotics.xyz\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Contact Us\"}]\n24:[\"$\",\"div\",null,{\"id\":\"privacy-note\",\"className\":\"mt-10 grid gap-4 border-t border-white/[.08] pt-6 text-[13px] leading-5 text-white/45 sm:grid-cols-[1fr_auto]\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Privacy and terms notices will be published before campaign enrollment or data collection begins. Contact the team for Phase 1 information.\"}],[\"$\",\"p\",null,{\"children\":\"© 2026 DigiRobotics\"}]]}]\n25:[\"$\",\"div\",null,{\"className\":\"mt-6 flex items-center gap-4 text-white/45\",\"children\":[[\"$\",\"a\",null,{\"href\":\"#\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-white/45 hover:text-white transition-colors\",\"children\":[\"$\",\"$L4\",null,{\"icon\":{\"name\":\"x\",\"size\":24,\"node\":[[\"path\",{\"d\":\"M18 6 6 18\",\"key\":\"1bl5f8\"}],[\"path\",{\"d\":\"m6 6 12 12\",\"key\":\"d8bk6v\"}]]},\"size\":18,\"aria-hidden\":\"true\"}]}],[\"$\",\"a\",null,{\"href\":\"#\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-white/45 hover:text-white transition-colors\",\"children\":[\"$\",\"$L4\",null,{\"icon\":{\"name\":\"mail\",\"size\":24,\"node\":[[\"path\",{\"d\":\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\",\"key\":\"132q7q\"}],[\"rect\",{\"x\":\"2\",\"y\":\"4\",\"width\":\"20\",\"height\":\"16\",\"rx\":\"2\",\"key\":\"izxlao\"}]]},\"size\":18,\"aria-hidden\":\"true\"}]}]]}]\n26:[\"$\",\"p\",null,{\"className\":\"mt-5 font-mono text-[10px] uppercase tracking-[.12em] text-white/35\",\"children\":\"Agent-compatible payment workflows powered by stablecoins and x402. Phase 1 infrastructure.\"}]\n29:null\nb:300\nb:C\n13:0\nd:\"$undefined\"\nf:\"$undefined\"\n12:\"$undefined\"\na:\"$undefined\"\n"}}