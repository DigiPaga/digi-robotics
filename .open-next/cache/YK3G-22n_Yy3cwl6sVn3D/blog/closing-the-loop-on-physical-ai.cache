b\",\"varyParams\":\"$10\"}],\"isUpgradeableISRFallback\":false,\"a\":\"$@13\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@14\"}\n26:I[38437,[\"99489\",\"static/chunks/99489-7b4b74c1a59849db.js\",\"5772\",\"static/chunks/5772-2ad3d6bb0136fa62.js\",\"57304\",\"static/chunks/57304-ca98254065b92130.js\",\"95953\",\"static/chunks/app/blog/%5Bslug%5D/page-a38ec015cb873e3f.js\"],\"Image\"]\n2b:I[90484,[],\"OutletBoundary\"]\n2c:\"$Sreact.suspense\"\n2e:I[90484,[],\"ViewportBoundary\"]\n2f:I[90484,[],\"MetadataBoundary\"]\n30:I[86869,[],\"IconMark\"]\n31:I[57121,[],\"\"]\n32:I[74581,[],\"\"]\n5:[\"$\",\"br\",null,{}]\n6:[\"$\",\"br\",null,{}]\n15:T554,A robot trains well in evaluation and simulation but fails in the real world — because training data was captured from a viewpoint its sensor never sees. This distribution gap is the manipulation policy's silent killer. Egocentric data solves it by capturing from the same perspective the robot's camera occupies at deployment — first-person data is a first-class training input, not a cheaper substitute for teleoperation. One hour of human egocentric hand data contributed more to policy performance than an additional hour of robot teleoperation in one study. Another found a log-linear scaling law with 54% average improvement over no-pretraining baseline. Five properties separate robot-ready egocentric data from footage that merely looks correct — including matched camera geometry, multimodal synchronization, per-joint hand pose, contact point annotations, and structured scenario coverage. The distribution gap is fundamentally an economic problem — legacy financial rails cannot pay thousands of distributed contributors at micro-transaction volumes. The agentic payment stack provides sub-second finality, sub-cent fees, and programmable conditionality — the exact properties distributed data contribution requires. DigiRobotics composes both stacks into a single closed loop where contributors earn USDG the moment their footage is consumed.16:T421,Five properties separate robot-ready egocentric data from footage that merely looks correct. Camera geometry matched to the robot's onboard sensor means a 15° field-of-view mismatch shifts the apparent size and position of grasped objects enough to degrade fine manipulation. Multimodal synchronization requires RGB, depth, IMU, and skeleton streams to be timestamp-aligned to within tens of milliseconds — a 50 ms offset between RGB and IMU is invisible in raw data and catastrophic in policy training. Per-joint hand pose at keyframes, especially at grasp onset and closure — bounding boxes tell a policy a hand is present; per-joint keypoints tell it which fingers are flexed. Contact point annotations identify which part of the hand touches which part of the object, at what moment — this is largely absent from public datasets. And structured scenario coverage, including failure and recovery sequences — unstructured \"natural activity\" footage clusters around common actions and produces almost nothing of the edge cases where policies fail.7:[\"$\",\"div\",null,{\"className\":\"min-w-0\",\"children\":[[[\"$\",\"blockquote\",\"blockquote-0\",{\"className\":\"my-10 border-l-2 border-[var(--primary)] bg-[var(--primary)]/[0.06] px-6 py-2 font-heading text-xl leading-8 text-white sm:px-8\",\"children\":[\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"font-semibold text-white\",\"children\":\"TL;DR:\"}]}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"$15\"}],\"\\n\"]}],\"\\n\",[\"$\",\"h2\",\"h2-0\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"The Distribution Gap\"}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Robots perceive the world through onboard sensors — wrist-mounted cameras, head-mounted depth modules, end-effector lenses. Yet most robotics training datasets are collected from third-person or ceiling-mounted views. The result is what practitioners call a perception-action mismatch: the policy learns from a perspective it will never use at execution time, and critical details — contact points, fine hand motion, depth cues — are lost in translation.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"$16\"}],\"\\n\",\"$L17\",\"\\n\",\"$L18\",\"\\n\",\"$L19\",\"\\n\",\"$L1a\",\"\\n\",\"$L1b\",\"\\n\",\"$L1c\",\"\\n\",\"$L1d\",\"\\n\",\"$L1e\",\"\\n\",\"$L1f\",\"\\n\",\"$L20\",\"\\n\",\"$L21\",\"\\n\",\"$L22\",\"\\n\",\"$L23\",\"\\n\",\"$L24\"],\"$L25\"]}]\n8:[\"$\",\"footer\",null,{\"className\":\"border-t border-white/[.08] bg-[#111620] py-12\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full max-w-[1440px] px-5 sm:px-8 lg:px-12 xl:px-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-10 lg:grid-cols-[1fr_auto] lg:items-start\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"$L26\",null,{\"src\":\"/digirobotics/brand/digirobotics-logo.png\",\"alt\":\"DigiRobotics.xyz\",\"width\":210,\"height\":48,\"className\":\"h-auto w-[190px]\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-[17px] text-white/60\",\"children\":\"Egocentric data for robotics training.\"}]]}],[\"$\",\"nav\",null,{\"aria-label\":\"Footer navigation\",\"className\":\"flex max-w-2xl flex-wrap gap-x-7 gap-y-3\",\"children\":[[\"$\",\"a\",\"Contributor\",{\"href\":\"/#contributors\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Contributor\"}],[\"$\",\"a\",\"Marketplace\",{\"href\":\"/#marketplace\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Marketplace\"}],[\"$\",\"a\",\"Custom Data\",{\"href\":\"/#custom-data\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Custom Data\"}],[\"$\",\"a\",\"Capture Gear\",{\"href\":\"/gear\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Capture Gear\"}],[\"$\",\"a\",\"Articles\",{\"href\":\"/blog\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Articles\"}],[\"$\",\"a\",\"Agent Demo\",{\"href\":\"/agent-demo\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Agent Demo\"}],[\"$\",\"a\",\"Privacy & Terms\",{\"href\":\"/#privacy-note\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Privacy & Terms\"}],\"$L27\"]}]]}],\"$L28\",\"$L29\",\"$L2a\"]}]}]\n9:[\"$\",\"$L2b\",null,{\"children\":[\"$\",\"$2c\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@2d\"}]}]\nc:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L2e\",null,{\"children\":[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L2f\",null,{\"children\":[\"$\",\"$2c\",null,{\"name\":\"Next.Metadata\",\"children\":[[\"$\",\"title\",\"0\",{\"children\":\"Closing the Loop on Physical AI — DigiRobotics\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"First-person robot training data and autonomous stablecoin settlement are converging into a single closed loop for embodied intelligence — closing the distribution gap between training viewpoints and real-world deployment.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.webmanifest\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"https://digirobotics.xyz/blog/closing-the-loop-on-physical-ai\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:title\",\"content\":\"Closing the Loop on Physical AI\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:description\",\"content\":\"First-person robot training data and autonomous stablecoin settlement are converging into a single closed loop for embodied intelligence — closing the distribution gap between training viewpoints and real-world deployment.\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:url\",\"content\":\"https://digirobotics.xyz/blog/closing-the-loop-on-physical-ai\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image\",\"content\":\"https://digirobotics.xyz/images/blog/closing-the-loop-on-physical-ai-cover.jpg\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:image:alt\",\"content\":\"Closing the Loop on Physical AI\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"10\",{\"property\":\"article:published_time\",\"content\":\"2026-11-20\"}],[\"$\",\"meta\",\"11\",{\"property\":\"article:modified_time\",\"content\":\"2026-11-20\"}],[\"$\",\"meta\",\"12\",{\"property\":\"article:author\",\"content\":\"DigiRobotics Team\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:title\",\"content\":\"Closing the Loop on Physical AI\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:description\",\"content\":\"First-person robot training data and autonomous stablecoin settlement are converging into a single closed loop for embodied intelligence — closing the distribution gap between training viewpoints and real-world deployment.\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:image\",\"content\":\"https://digirobotics.xyz/images/blog/closing-the-loop-on-physical-ai-cover.jpg\"}],[\"$\",\"link\",\"17\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?63d5b2ef705d808e\",\"type\":\"image/x-icon\",\"sizes\":\"256x256\"}],[\"$\",\"link\",\"18\",{\"rel\":\"icon\",\"href\":\"/icon.png?1f3d5ce59ec9c445\",\"type\":\"image/png\",\"sizes\":\"1254x1254\"}],[\"$\",\"link\",\"19\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-icon.png?1f3d5ce59ec9c445\",\"type\":\"image/png\",\"sizes\":\"1254x1254\"}],[\"$\",\"$L30\",\"20\",{}]]}]}]}],null]}]\ne:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L31\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L32\",null,{}]}]]}]\n11:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L31\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L32\",null,{}]}]]}]\n14:true\n17:[\"$\",\"p\",\"p-2\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The hardest unsolved gap is force data. Video captures what a hand looks like; it cannot capture how hard a grasp is, or when slip is imminent. For deformable objects — cloth, food, soft materials — force feedback is the primary signal a policy needs, and it is absent from every publicly available egocentric dataset.\"}]\n18:[\"$\",\"h2\",\"h2-1\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"The Agentic Payment Stack\"}]\n19:[\"$\",\"p\",\"p-3\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"On the settlement side, agentic commerce has moved from theoretical discussion into measurable infrastructure. AI systems now act as independent economic actors — discovering services, negotiating terms, and executing financial settlement with minimal human intervention. The protocol layer has crystallized around open standards: an HTTP-native agentic payment protocol that repurposes the HTTP \\\"Payment Required\\\" status code for machine-to-machine payments directly inside API calls; an agent payments protocol backed by a coalition of more than 60 banks, payment processors, and tech firms that provides the Authorization, Authenticity, and Accountability primitives an agent needs to act as a trustworthy payer; and a universal commerce protocol that standardizes agent discovery of merchant capabilities through well-known manifest files.\"}]\n1a:[\"$\",\"p\",\"p-4\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Underneath the protocol layer, stablecoins deliver the only rail that settles in sub-second time with sub-cent fees. The recent passage of federal stablecoin legislation in the United States has removed one of the largest institutional barriers to adoption. USD-pegged stablecoins already process roughly $27 trillion in annual transaction volume, yet represent less than 1% of daily transaction volume — implying substantial headroom. Industry analyses project US business-to-consumer orchestrated revenue from agentic commerce at up to $1 trillion by 2030, with global projections ranging from $3T to $5T.\"}]\n1b:[\"$\",\"p\",\"p-5\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The defining properties are deterministic finality (sub-second, irreversible settlement), 24/7 operation, and programmable conditionality — funds lock and release only when a service is verifiably delivered. These are not features legacy fiat ledgers provide natively, and they are the precise properties autonomous agents require to transact trustlessly at scale.\"}]\n1c:[\"$\",\"h2\",\"h2-2\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Why the Two Stacks Are Co-Dependent\"}]\n1d:[\"$\",\"p\",\"p-6\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The distribution gap and the agentic payment stack are usually discussed in separate communities — robotics researchers on one side, crypto-native builders on the other. They are, in fact, the same problem viewed from two angles.\"}]\n1e:[\"$\",\"p\",\"p-7\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"Consider the economics of a 20,000-hour egocentric dataset assembled to satisfy a documented log-linear scaling law. At 100 approved hours per contributor, that dataset requires roughly 200 participants across multiple countries, each generating dozens of micro-transactions over the project lifecycle. A traditional procurement flow — invoice, approval, batch payment, 30-day settlement — collapses under the weight of that volume. The marginal cost of paying one contributor for one hour of approved footage approaches zero only if the settlement rail itself costs near zero and settles instantly.\"}]\n1f:[\"$\",\"p\",\"p-8\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"That is exactly what the agentic payment stack provides. The same HTTP-native payment protocol that processes API micropayments for AI agents can settle contributor payouts for egocentric data — atomically, programmatically, and without human review of each transaction. The same stablecoin settlement that delivers sub-second finality for autonomous agents can pay a contributor the moment their footage passes quality review, with no correspondent banking delays and no FX friction.\"}]\n20:[\"$\",\"p\",\"p-9\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The reverse dependency is just as strong. Agentic commerce needs real-world tasks to settle around. The richest, most under-monetized category of real-world task data is physical human activity — the manipulation, locomotion, and tool use that robotics labs are desperate to acquire. Without a marketplace that connects contributors to consumers programmatically, the long tail of physical-world expertise stays locked inside a handful of well-capitalized labs. Without the data that marketplace would surface, embodied AI policies plateau well below their documented scaling-law potential.\"}]\n21:[\"$\",\"p\",\"p-10\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"The closed loop is clear: contributor captures first-person footage → data is tokenized and listed → autonomous agent discovers it and settles via an HTTP-native payment protocol in seconds → contributor receives stablecoin payout → improved data trains improved policies → more deployment creates more demand for data.\"}]\n22:[\"$\",\"h2\",\"h2-3\",{\"className\":\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\",\"children\":\"Conclusion\"}]\n23:[\"$\",\"p\",\"p-11\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"DigiRobotics is the world's first stablecoin-native marketplace for agentic commerce in real-world robotics data — purpose-built at the intersection of these two stacks. Contributors capture egocentric footage of physical tasks using accessible wearable devices; that data is tokenized and listed on the marketplace, where AI agents, robotics labs, and humanoid developers procure it programmatically. Settlement runs over an HTTP-native agentic payment protocol in USDG stablecoins on a high-performance Layer-2 network, paying contributors the instant their data is consumed — no invoices, no batch payouts, no 30-day settlement windows.\"}]\n24:[\"$\",\"p\",\"p-12\",{\"className\":\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\",\"children\":\"By composing the agentic payment rail directly with the egocentric contribution pipeline, DigiRobotics unlocks the long tail of human physical expertise that no single lab can collect internally. Everyday users earn USDG for first-person capture; autonomous agents purchase that data around the clock; Physical AI policies scale toward their documented log-linear potential. The distribution gap closes, the settlement rail disappears into the background, and the loop finally completes.\"}]\n25:[\"$\",\"div\",null,{\"className\":\"mt-16 border-t border-white/10 pt-8\",\"children\":[\"$\",\"$L3\",null,{\"href\":\"/blog\",\"className\":\"inline-flex min-h-11 items-center gap-2 rounded-full border border-white/15 px-5 py-3 text-[14px] font-semibold transition hover:border-[var(--primary)] hover:text-[var(--primary)]\",\"children\":[[\"$\",\"$L4\",null,{\"icon\":\"$0:data:0:rsc:props:children:0:props:children:2:props:children:0:props:children:1:props:children:0:props:children:0:props:icon\",\"size\":16,\"aria-hidden\":\"true\"}],\" Return to the archive\"]}]}]\n27:[\"$\",\"a\",\"Contact Us\",{\"href\":\"mailto:hello@digirobotics.xyz\",\"className\":\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\",\"children\":\"Contact Us\"}]\n28:[\"$\",\"div\",null,{\"id\":\"privacy-note\",\"className\":\"mt-10 grid gap-4 border-t border-white/[.08] pt-6 text-[13px] leading-5 text-white/45 sm:grid-cols-[1fr_auto]\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Privacy and terms notices will be published before campaign enrollment or data collection begins. Contact the team for Phase 1 information.\"}],[\"$\",\"p\",null,{\"children\":\"© 2026 DigiRobotics\"}]]}]\n29:[\"$\",\"div\",null,{\"className\":\"mt-6 flex items-center gap-4 text-white/45\",\"children\":[[\"$\",\"a\",null,{\"href\":\"#\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-white/45 hover:text-white transition-colors\",\"children\":[\"$\",\"$L4\",null,{\"icon\":{\"name\":\"x\",\"size\":24,\"node\":[[\"path\",{\"d\":\"M18 6 6 18\",\"key\":\"1bl5f8\"}],[\"path\",{\"d\":\"m6 6 12 12\",\"key\":\"d8bk6v\"}]]},\"size\":18,\"aria-hidden\":\"true\"}]}],[\"$\",\"a\",null,{\"href\":\"#\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-white/45 hover:text-white transition-colors\",\"children\":[\"$\",\"$L4\",null,{\"icon\":{\"name\":\"mail\",\"size\":24,\"node\":[[\"path\",{\"d\":\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\",\"key\":\"132q7q\"}],[\"rect\",{\"x\":\"2\",\"y\":\"4\",\"width\":\"20\",\"height\":\"16\",\"rx\":\"2\",\"key\":\"izxlao\"}]]},\"size\":18,\"aria-hidden\":\"true\"}]}]]}]\n2a:[\"$\",\"p\",null,{\"className\":\"mt-5 font-mono text-[10px] uppercase tracking-[.12em] text-white/35\",\"children\":\"Agent-compatible payment workflows powered by stablecoins and x402. Phase 1 infrastructure.\"}]\n2d:null\nb:300\nb:C\n13:0\nd:\"$undefined\"\nf:\"$undefined\"\n12:\"$undefined\"\na:\"$undefined\"\n"}}