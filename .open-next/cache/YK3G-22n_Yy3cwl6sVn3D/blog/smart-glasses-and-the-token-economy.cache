unit of currency for embodied AI.\\\",\\\"datePublished\\\":\\\"2026-11-20\\\",\\\"dateModified\\\":\\\"2026-11-20\\\",\\\"author\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"DigiRobotics Team\\\"},\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"DigiRobotics\\\",\\\"url\\\":\\\"https://digirobotics.xyz\\\"},\\\"mainEntityOfPage\\\":\\\"https://digirobotics.xyz/blog/smart-glasses-and-the-token-economy\\\",\\\"image\\\":\\\"https://digirobotics.xyz/images/blog/smart-glasses-and-the-token-economy-cover.jpg\\\"}\"}}],[\"$\",\"article\",null,{\"children\":[[\"$\",\"header\",null,{\"className\":\"relative overflow-hidden border-b border-white/10\",\"children\":[[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute inset-0 opacity-25 [background-image:radial-gradient(oklch(from_var(--primary)_l_c_h_/_24%)_1px,transparent_1px)] [background-size:22px_22px]\"}],[\"$\",\"div\",null,{\"className\":\"relative mx-auto max-w-5xl px-5 pb-16 pt-12 sm:px-8 sm:pb-24 sm:pt-16\",\"children\":[[\"$\",\"$L26\",null,{\"href\":\"/blog\",\"className\":\"inline-flex min-h-11 items-center gap-2 font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--muted-foreground)] transition hover:text-[var(--primary)]\",\"children\":[[\"$\",\"$La\",null,{\"ref\":\"$undefined\",\"icon\":{\"name\":\"arrow-left\",\"size\":24,\"node\":[[\"path\",{\"d\":\"m12 19-7-7 7-7\",\"key\":\"1l729n\"}],[\"path\",{\"d\":\"M19 12H5\",\"key\":\"x3x0zl\"}]]},\"className\":\"$undefined\",\"size\":14,\"aria-hidden\":\"true\"}],\" Back to field notes\"]}],[\"$\",\"div\",null,{\"className\":\"mt-14 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[10px] uppercase tracking-[0.16em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[var(--primary)]\",\"children\":\"Robotics\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"text-white/25\",\"children\":\"/\"}],[\"$\",\"time\",null,{\"dateTime\":\"2026-11-20\",\"className\":\"text-[var(--m