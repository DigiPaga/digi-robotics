g-5 tracking-[0.15em] text-[var(--muted-foreground)]\\\",\\\"children\\\":[\\\"DigiRobotics\\\",[\\\"$\\\",\\\"br\\\",null,{}],\\\"Field note\\\",[\\\"$\\\",\\\"br\\\",null,{}],\\\"2026.11.20\\\"]}]}]\\n28:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"min-w-0\\\",\\\"children\\\":[[[\\\"$\\\",\\\"blockquote\\\",\\\"blockquote-0\\\",{\\\"className\\\":\\\"my-10 border-l-2 border-[var(--primary)] bg-[var(--primary)]/[0.06] px-6 py-2 font-heading text-xl leading-8 text-white sm:px-8\\\",\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",\\\"p-0\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":[\\\"$\\\",\\\"strong\\\",\\\"strong-0\\\",{\\\"className\\\":\\\"font-semibold text-white\\\",\\\"children\\\":\\\"TL;DR:\\\"}]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",\\\"p-1\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"Physical AI needs rights-cleared first-person data captured in real environments — not scraped from the internet. Agentic commerce needs an HTTP-native payment standard that settles onchain in sub-seconds. DigiRobotics composes ZenO/Story data provenance with x402 on Algorand into a single closed loop where contributors earn USDG instantly.\\\"}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",\\\"h2-0\\\",{\\\"className\\\":\\\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\\\",\\\"children\\\":\\\"The Real-World Data Problem\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",\\\"p-0\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"ZenO launched its public beta in February 2026, integrated with Story — an AI-native blockchain network serving as the provenance, licensing, and economic layer for AI data and models. Story is backed by $136 million from a16z crypto, Polychain Capital, and Samsung Ventures, and launched its mainnet in February 2025. The integration turns ZenO's first-person capture pipeline into a programmable IP rail: wallet-signed consent and data identifiers are recorded onchain during the beta, with metadata and licensing information scheduled to follow as the roadmap matures.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",\\\"p-1\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"The thesis driving ZenO is blunt. As Co-Founder Dawn Kim put it: \\\\\\\"The real world doesn't look like the internet.\\\\\\\" Physical AI systems — robots, autonomous agents, embodied models — cannot train on scraped web content or synthetic data. They need high-quality, rights-cleared, first-person data captured in actual environments.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",\\\"p-2\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"ZenO's contributor model is structured around that insight. Contributors capture first-person audio, video, and images using ZenO-branded smart glasses or smartphones, depending on the mission. They upload through ZenO's application, which performs automated formatting and integrity checks. QA runs through a multi-stage process — AI screening plus human review — with automatic anonymization of faces and identifiable text. They tag with structured metadata describing actions and environments. And approved datasets are listed in ZenO's data marketplace for procurement by AI labs and robotics teams.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",\\\"h2-1\\\",{\\\"className\\\":\\\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\\\",\\\"children\\\":\\\"How x402 Settles Agent Payments\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",\\\"p-3\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"The counterpart to ZenO's data layer is x402 — an emerging payments standard built on HTTP status code 402, now implemented as a production-ready payment flow on Algorand. As Algorand's team frames it: \\\\\\\"While the necessity of 402 was always clear, the web lacked a standard protocol to execute the payment. Today, x402 finally transforms 'payment required' into a first-class, internet-native pattern.\\\\\\\"\\\"}],\\\"\\\\n\\\",\\\"$L2b\\\",\\\"\\\\n\\\",\\\"$L2c\\\",\\\"\\\\n\\\",\\\"$L2d\\\",\\\"\\\\n\\\",\\\"$L2e\\\",\\\"\\\\n\\\",\\\"$L2f\\\",\\\"\\\\n\\\",\\\"$L30\\\",\\\"\\\\n\\\",\\\"$L31\\\",\\\"\\\\n\\\",\\\"$L32\\\",\\\"\\\\n\\\",\\\"$L33\\\",\\\"\\\\n\\\",\\\"$L34\\\",\\\"\\\\n\\\",\\\"$L35\\\",\\\"\\\\n\\\",\\\"$L36\\\",\\\"\\\\n\\\",\\\"$L37\\\",\\\"\\\\n\\\",\\\"$L38\\\"],\\\"$L39\\\"]}]\\n29:[\\\"$\\\",\\\"footer\\\",null,{\\\"className\\\":\\\"border-t border-white/[.08] bg-[#111620] py-12\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto w-full max-w-[1440px] px-5 sm:px-8 lg:px-12 xl:px-16\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-10 lg:grid-cols-[1fr_auto] lg:items-start\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"$Lb\\\",null,{\\\"src\\\":\\\"/digirobotics/brand/digirobotics-logo.png\\\",\\\"alt\\\":\\\"DigiRobotics.xyz\\\",\\\"width\\\":210,\\\"height\\\":48,\\\"className\\\":\\\"h-auto w-[190px]\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-4 text-[17px] text-white/60\\\",\\\"children\\\":\\\"Egocentric data for robotics training.\\\"}]]}],[\\\"$\\\",\\\"nav\\\",null,{\\\"aria-label\\\":\\\"Footer navigation\\\",\\\"className\\\":\\\"flex max-w-2xl flex-wrap gap-x-7 gap-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",\\\"Contributor\\\",{\\\"href\\\":\\\"/#contributors\\\",\\\"className\\\":\\\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\\\",\\\"children\\\":\\\"Contributor\\\"}],[\\\"$\\\",\\\"a\\\",\\\"Marketplace\\\",{\\\"href\\\":\\\"/#marketplace\\\",\\\"className\\\":\\\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\\\",\\\"children\\\":\\\"Marketplace\\\"}],[\\\"$\\\",\\\"a\\\",\\\"Custom Data\\\",{\\\"href\\\":\\\"/#custom-data\\\",\\\"className\\\":\\\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\\\",\\\"children\\\":\\\"Custom Data\\\"}],[\\\"$\\\",\\\"a\\\",\\\"Capture Gear\\\",{\\\"href\\\":\\\"/gear\\\",\\\"className\\\":\\\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\\\",\\\"children\\\":\\\"Capture Gear\\\"}],[\\\"$\\\",\\\"a\\\",\\\"Articles\\\",{\\\"href\\\":\\\"/blog\\\",\\\"className\\\":\\\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\\\",\\\"children\\\":\\\"Articles\\\"}],[\\\"$\\\",\\\"a\\\",\\\"Agent Demo\\\",{\\\"href\\\":\\\"/agent-demo\\\",\\\"className\\\":\\\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\\\",\\\"children\\\":\\\"Agent Demo\\\"}],[\\\"$\\\",\\\"a\\\",\\\"Privacy \\u0026 Terms\\\",{\\\"href\\\":\\\"/#privacy-note\\\",\\\"className\\\":\\\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\\\",\\\"children\\\":\\\"Privacy \\u0026 Terms\\\"}],\\\"$L3a\\\"]}]]}],\\\"$L3b\\\",\\\"$L3c\\\",\\\"$L3d\\\"]}]}]\\n\"])</script><script>self.__next_f.push([1,\"2b:[\\\"$\\\",\\\"p\\\",\\\"p-4\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"The payment flow is four steps, designed for machine-to-machine settlement without human approval. First, a client or AI agent requests a resource from a protected endpoint. Second, the server responds with HTTP, MCP, or A2A 402 status plus a payment requirements definition — price, token, recipient, network. Third, the client constructs and submits payment according to the requirements. Fourth, the server verifies, settles onchain, and returns the resource upon success.\\\"}]\\n2c:[\\\"$\\\",\\\"p\\\",\\\"p-5\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"Algorand's infrastructure is what makes the flow practical at scale. The chain reports zero downtime since launch and 10,000 TPS, with instant finality and deterministic execution. Native atomic transaction grouping lets payment, authorization, and usage logic settle together in a single block — a property legacy rails cannot match. Stablecoin support enables predictable pricing for APIs, data, and services.\\\"}]\\n2d:[\\\"$\\\",\\\"p\\\",\\\"p-6\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"The use case surface is broad: micropayments for fractional-cent API access, machine-to-machine transactions between connected devices, autonomous agentic commerce, pay-as-you-go metered access, dynamic subscription management, and pay-per-API-call monetization. As the Algorand team writes, \\\\\\\"As decision-making costs approach zero, long-tail markets emerge, and capital is allocated in real time.\\\\\\\"\\\"}]\\n2e:[\\\"$\\\",\\\"h2\\\",\\\"h2-2\\\",{\\\"className\\\":\\\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\\\",\\\"children\\\":\\\"Where the Two Stacks Converge\\\"}]\\n2f:[\\\"$\\\",\\\"p\\\",\\\"p-7\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"ZenO's data layer and x402's payment layer are usually discussed in separate communities. They are, in fact, the same problem viewed from two angles.\\\"}]\\n30:[\\\"$\\\",\\\"p\\\",\\\"p-8\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"The contributor economics tell the story. Paying hundreds or thousands of distributed first-person data contributors via legacy rails is economically impossible at the transaction values involved — correspondent banking fees and settlement delays exceed the value of the data being procured. x402 on a high-throughput chain like Algorand dissolves that constraint: sub-cent fees, sub-second finality, 24/7 operation, programmable conditionality.\\\"}]\\n31:[\\\"$\\\",\\\"p\\\",\\\"p-9\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"The reverse dependency is just as strong. Agentic commerce needs real-world tasks to settle around. The richest, most under-monetized category of real-world data is first-person human activity — the manipulation, locomotion, and tool use that robotics labs are desperate to acquire. Without a marketplace that connects contributors to consumers programmatically, the long tail of physical-world expertise stays locked inside a handful of well-capitalized labs. Without the data that marketplace would surface, Physical AI policies plateau well below their scaling-law potential.\\\"}]\\n32:[\\\"$\\\",\\\"p\\\",\\\"p-10\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"The two stacks compose into a single closed loop: contributor captures first-person footage → data is registered and tokenized onchain → autonomous agent discovers it, evaluates pricing, and settles via x402 in seconds → contributor receives stablecoin payout → improved data trains improved policies → more deployment creates more demand for data.\\\"}]\\n33:[\\\"$\\\",\\\"h2\\\",\\\"h2-3\\\",{\\\"className\\\":\\\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\\\",\\\"children\\\":\\\"How DigiRobotics Is Building the Future\\\"}]\\n34:[\\\"$\\\",\\\"p\\\",\\\"p-11\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"DigiRobotics is the world's first stablecoin-native marketplace for agentic commerce in real-world robotics data — purpose-built at the intersection of the ZenO/Story data layer and the x402 settlement rail.\\\"}]\\n3e:T433,Our platform composes both stacks into a single loop. Egocentric data capture at scale means contributors record first-person physical tasks using accessible wearable devices and smartphones, extending the real-world capture model beyond any single platform's beta cohort. x402 agentic payments mean AI agents and robotics labs procure data programmatically via the HTTP 402 payment flow, with single-call micropayments for specific demonstration clips settling in seconds. USDG stablecoin settlement on Arbitrum delivers sub-second finality, negligible gas costs, borderless by design, with atomic transaction grouping for payment, authorization, and usage logic. Onchain provenance and licensing embed wallet-signed consent, tokenized datasets, and programmable data rights so every transaction carries verifiable provenance — the same property Story provides to ZenO's pipeline. Multi-stage QA and consent governance use AI screening plus human review, automatic PII anonymization, and structured metadata to ensure every dataset meets the rigor Physical AI labs demand.35:[\\\"$\\\",\\\"p\\\",\\\"p-12\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"$3e\\\"}]\\n36:[\\\"$\\\",\\\"p\\\",\\\"p-13\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"ZenO and Story proved that real-world, rights-cleared first-person data can be captured and registered onchain. x402 on Algorand proved that autonomous agents can settle for resources over HTTP without human approval. DigiRobotics is the loop that wires them together — turning everyday first-person capture into instantly settled, programmatically procured training data for Physical AI.\\\"}]\\n37:[\\\"$\\\",\\\"h2\\\",\\\"h2-4\\\",{\\\"className\\\":\\\"mb-4 mt-6 scroll-mt-24 font-heading text-xl md:text-2xl leading-tight tracking-[-0.03em] text-white\\\",\\\"children\\\":\\\"Start Contributing Today\\\"}]\\n38:[\\\"$\\\",\\\"p\\\",\\\"p-14\\\",{\\\"className\\\":\\\"my-4 text-base leading-relaxed text-[var(--muted-foreground)]\\\",\\\"children\\\":\\\"If you capture first-person video — cooking, assembling, operating machinery, repairing, demonstrating any physical task — your footage can train the next generation of humanoids and earn you USDG the moment it is consumed. Join the DigiRobotics marketplace and become part of the planetary-scale data pipeline for Physical AI.\\\"}]\\n39:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-16 border-t border-white/10 pt-8\\\",\\\"children\\\":[\\\"$\\\",\\\"$L26\\\",null,{\\\"href\\\":\\\"/blog\\\",\\\"className\\\":\\\"inline-flex min-h-11 items-center gap-2 rounded-full border border-white/15 px-5 py-3 text-[14px] font-semibold transition hover:border-[var(--primary)] hover:text-[var(--primary)]\\\",\\\"children\\\":[[\\\"$\\\",\\\"$La\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"icon\\\":\\\"$1e:props:children:2:props:children:0:props:children:1:props:children:0:props:children:0:props:icon\\\",\\\"className\\\":\\\"$undefined\\\",\\\"size\\\":16,\\\"aria-hidden\\\":\\\"true\\\"}],\\\" Return to the archive\\\"]}]}]\\n3a:[\\\"$\\\",\\\"a\\\",\\\"Contact Us\\\",{\\\"href\\\":\\\"mailto:hello@digirobotics.xyz\\\",\\\"className\\\":\\\"min-h-11 py-3 text-[14px] font-medium text-white/65 relative transition-colors duration-300 ease-out after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[var(--primary)] after:transition-transform after:duration-300 after:ease-out hover:text-[var(--primary)] hover:after:scale-x-100\\\",\\\"children\\\":\\\"Contact Us\\\"}]\\n3b:[\\\"$\\\",\\\"div\\\",null,{\\\"id\\\":\\\"privacy-note\\\",\\\"className\\\":\\\"mt-10 grid gap-4 border-t border-white/[.08] pt-6 text-[13px] leading-5 text-white/45 sm:grid-cols-[1fr_auto]\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Privacy and terms notices will be published before campaign enrollment or data collection begins. Contact the team for Phase 1 information.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"© 2026 DigiRobotics\\\"}]]}]\\n3c:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-6 flex items-center gap-4 text-white/45\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"text-white/45 hover:text-white transition-colors\\\",\\\"children\\\":[\\\"$\\\",\\\"$La\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"icon\\\":\\\"$14:props:children:0:props:children:props:icon\\\",\\\"className\\\":\\\"$undefined\\\",\\\"size\\\":18,\\\"aria-hidden\\\":\\\"true\\\"}]}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"text-white/45 hover:text-white transition-colors\\\",\\\"children\\\":[\\\"$\\\",\\\"$La\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"icon\\\":\\\"$14:props:children:1:props:children:props:icon\\\",\\\"className\\\":\\\"$undefined\\\",\\\"size\\\":18,\\\"aria-hidden\\\":\\\"true\\\"}]}]]}]\\n3d:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-5 font-mono text-[10px] uppercase tracking-[.12em] text-white/35\\\",\\\"children\\\":\\\"Agent-compatible payment workflows powered by stablecoins and x402. Phase 1 infrastructure.\\\"}]\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n3:I[60203,[\"66609\",\"static/chunks/66609-81fc326aefa2b35a.js\",\"17112\",\"static/chunks/17112-6d02a7878e38f17b.js\",\"96048\",\"static/chunks/96048-94353edf3fef0226.js\",\"37024\",\"static/chunks/37024-473db45fa25438c6.js\",\"7177\",\"static/chunks/app/layout-9ceac550056e754f.js\"],\"ThirdwebSessionProvider\"]\n4:I[35682,[\"66609\",\"static/chunks/66609-81fc326aefa2b35a.js\",\"17112\",\"static/chunks/17112-6d02a7878e38f17b.js\",\"96048\",\"static/chunks/96048-94353edf3fef0226.js\",\"37024\",\"static/chunks/37024-473db45fa25438c6.js\",\"7177\",\"static/chunks/app/layout-9ceac550056e754f.js\"],\"CartProvider\"]\n5:I[76826,[\"66609\",\"static/chunks/66609-81fc326aefa2b35