# Build-time values for the Cloudflare deploy of https://digirobotics.xyz.
# Copy to .env.production.local (gitignored) and fill in the blanks before `npm run deploy`.
#
# Everything here is public: Next.js inlines NEXT_PUBLIC_* into the browser bundle when it
# builds. Changing a value means building and deploying again.
# Do not put secrets in this file. The OpenNext build copies .env files into the Worker
# bundle. Runtime secrets go in with `wrangler secret put`, see .dev.vars.example.

# x402 backends of /agent-demo, one Worker per chain (x402-server/wrangler.jsonc). Arbitrum Sepolia
# is the default; leaving the Robinhood one empty shows that chain as "Not configured".
NEXT_PUBLIC_X402_BACKEND_URL=https://x402.digirobotics.xyz
NEXT_PUBLIC_X402_BACKEND_URL_ROBINHOOD=https://x402-rh.digirobotics.xyz

# thirdweb client id (the public one, not the secret key). Its allowed domains must include digirobotics.xyz.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=

# ZeroDev. NEXT_PUBLIC_ZERODEV_RPC_URL is optional and derives from the project id and chain id.
NEXT_PUBLIC_ZERODEV_PROJECT_ID=
NEXT_PUBLIC_ZERODEV_RPC_URL=
NEXT_PUBLIC_CHAIN_ID=421614

# EIP-3009 MockUSDG, same address on Arbitrum Sepolia (421614) and Robinhood Chain Testnet (46630).
NEXT_PUBLIC_MOCK_USDG_ADDRESS_ARBITRUM_SEPOLIA=0xBbB4155d20D739faABC3af41A3344FAEfD76dDD4
NEXT_PUBLIC_MOCK_USDG_ADDRESS_ROBINHOOD=0xBbB4155d20D739faABC3af41A3344FAEfD76dDD4

# Wallet that receives checkout payments.
NEXT_PUBLIC_STORE_WALLET_ADDRESS=
