/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Static image/illustration assets under public/. Workers Static Assets serves these
# directly (no literal file in .open-next/assets matches an app route path such as "/gear"
# or "/checkout", so the SSR Worker never shadows them) — confirmed against
# developers.cloudflare.com/workers/static-assets/headers/ before relying on this file at
# all: `_headers` rules are NOT applied to responses the Worker generates (every HTML page
# here, via the OpenNext Next.js server), only to genuine static-asset passthrough
# responses like these. Security headers therefore live in
# next.config.ts instead, not here. 7-day cache, not `immutable`: these filenames have no
# content hash, so a future in-place asset replacement (e.g. a logo re-export)
# should not get stuck behind a year-long cache.
/digirobotics/*
  Cache-Control: public, max-age=604800

/gear/*
  Cache-Control: public, max-age=604800

/marketplace/*
  Cache-Control: public, max-age=604800
