NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
NEXT_PUBLIC_ZERODEV_PROJECT_ID=
NEXT_PUBLIC_ZERODEV_RPC_URL=
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_MOCK_USDG_ADDRESS=
# Per-chain MockUSDG (from contracts/deployments/x402-<chainId>.json). The Arbitrum Sepolia value
# falls back to NEXT_PUBLIC_MOCK_USDG_ADDRESS, then to the first (non EIP-3009) MockUSDG.
# EIP-3009 MockUSDG from DeployX402.s.sol, same address on both testnets:
# 0xBbB4155d20D739faABC3af41A3344FAEfD76dDD4 (X402Facilitator 0xB7D6F2aC244C8562CEd113AAf1a1A41C253FE816).
NEXT_PUBLIC_MOCK_USDG_ADDRESS_ARBITRUM_SEPOLIA=0xBbB4155d20D739faABC3af41A3344FAEfD76dDD4
NEXT_PUBLIC_MOCK_USDG_ADDRESS_ROBINHOOD=0xBbB4155d20D739faABC3af41A3344FAEfD76dDD4
NEXT_PUBLIC_STORE_WALLET_ADDRESS=
NEXT_PUBLIC_X402_BACKEND_URL=http://localhost:3001
KIT_API_KEY=
KIT_FORM_ID=

# Robinhood Chain Testnet Configuration
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=46630
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# --- Private ops dashboard (/ops) --------------------------------------------
# Server-only. Never prefix these with NEXT_PUBLIC_. If any of the first four is
# missing, /ops shows a generic "Ops is not configured" page and nobody can sign in.
# What exactly is missing is written to the server log only, never to the page.
# Google OAuth client (type "Web application"); redirect URI = <origin>/ops/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session and OAuth state cookies. At least 32 chars, e.g. `openssl rand -base64 48`.
OPS_SESSION_SECRET=
# Comma separated Google accounts allowed into /ops. Case-insensitive; gmail dots ignored.
# Empty means nobody. Only addresses Google itself hosts can sign in: @gmail.com /
# @googlemail.com, or a Google Workspace address whose domain matches the ID token's `hd`
# claim. A Google account registered on any other mailbox (Outlook, a non-Workspace custom
# domain, ...) is refused even when listed here.
OPS_ALLOWED_EMAILS=
# Public origin used for the OAuth redirect_uri and every /ops redirect, e.g. https://digirobotics.xyz.
# Required when NODE_ENV=production: without it /ops stays "not configured", because the
# Host header is never trusted there. Optional in development, where it defaults to the
# request origin (https for any non-localhost host).
OPS_BASE_URL=
# Wallets to monitor, as a JSON array of {"label","address","role","minEth"}.
# The dashboard reads at most 10 wallets (the X402_PAY_TO row included); extra entries are not queried.
# Unset means these defaults:
# [{"label":"Deployer","address":"0x962B67f92E9BAfc3A584fe2EA3ad871AcA3509d6","role":"Owner / deployer","minEth":0.01},
#  {"label":"Settler","address":"0xd98aC3064B36dFb19b62558d48cB16f00105F473","role":"x402 settler (pays gas per settlement)","minEth":0.005}]
OPS_WALLETS=
# Optional x402 treasury (same value as x402-server X402_PAY_TO). Shown as an extra row with its mUSDG balance.
# mUSDG balances read the NEXT_PUBLIC_MOCK_USDG_ADDRESS_* values above (server-side as well).
X402_PAY_TO=
# --- Ops console sections (all optional, server-only unless NEXT_PUBLIC_) ------
# x402 server origin for the Marketplace and Infra sections (GET /health and
# /agent-demo/catalog, server-side). Falls back to NEXT_PUBLIC_X402_BACKEND_URL.
# Unset means those sections say "not configured".
X402_SERVER_URL=
# Repository whose GitHub Actions runs on main are shown, as owner/name. The public
# API is used without a token (60 requests per hour per IP; the console asks at most
# once every 2 minutes). Unset means DigiPaga/digi-robotics.
OPS_GITHUB_REPO=
# Shown as the deployed build in Overview and Infra. Set both at build time, e.g.
#   NEXT_PUBLIC_COMMIT_SHA=$(git rev-parse HEAD) NEXT_PUBLIC_BUILD_TIME=$(date -u +%FT%TZ) npm run build
# WORKERS_CI_COMMIT_SHA, CF_PAGES_COMMIT_SHA, VERCEL_GIT_COMMIT_SHA and GITHUB_SHA are read as fallbacks.
NEXT_PUBLIC_COMMIT_SHA=
NEXT_PUBLIC_BUILD_TIME=
