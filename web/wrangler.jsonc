{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "digirobotics-web",
	// DigiPaga account (owns the digirobotics.xyz zone). Not a secret.
	"account_id": "32f5bc193982cc1d267e89cbff9f1245",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Zone routes, not a custom domain: the apex and www already have proxied DNS records that
	// Cloudflare will not hand over to a Workers custom domain. Routes run the Worker in front of them.
	"routes": [
		{ "pattern": "digirobotics.xyz/*", "zone_name": "digirobotics.xyz" },
		{ "pattern": "www.digirobotics.xyz/*", "zone_name": "digirobotics.xyz" }
	],
	// Nothing references *.workers.dev for this Worker; the zone routes above are the only intended entry point.
	"workers_dev": false,
	"preview_urls": false,
	// Orders written by POST /api/orders.
	"d1_databases": [{ "binding": "ORDERS_DB", "database_name": "digirobotics-orders", "database_id": "0188eace-9732-4c88-99a2-0c6c17191b74" }],
	// Non-secret runtime config. Secrets are set with `wrangler secret put`, see .dev.vars.example.
	"vars": {
		"OPS_BASE_URL": "https://digirobotics.xyz",
		// Read at runtime by /ops for the mUSDG balances (EIP-3009 MockUSDG, same address on both testnets).
		"NEXT_PUBLIC_MOCK_USDG_ADDRESS_ARBITRUM_SEPOLIA": "0xBbB4155d20D739faABC3af41A3344FAEfD76dDD4",
		"NEXT_PUBLIC_MOCK_USDG_ADDRESS_ROBINHOOD": "0xBbB4155d20D739faABC3af41A3344FAEfD76dDD4"
	},
	"observability": {
		"enabled": true,
		"traces": { "enabled": true }
	}
}
