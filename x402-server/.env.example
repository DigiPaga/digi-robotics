# SERVER CONFIG
PORT=3001
NODE_ENV=development

# WALLET & DEPLOYER
PRIVATE_KEY=YOUR_PRIVATE_KEY
DEPLOYER_ADDRESS=YOUR_DEPLOYER_ADDRESS
PAYMENT_RECIPIENT=YOUR_DEPLOYER_ADDRESS

# RPC ENDPOINTS (Sponsor: QuickNode)
QUICKNODE_RPC_URL=https://your-quicknode-endpoint.com
ARBITRUM_SEPOLIA_RPC=https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com

# SPONSOR TOKEN ADDRESSES (Paxos)
# Robinhood Testnet
PAXOS_USDG_ROBINHOOD=0x5fc5360d0400a0fd4f2af552add042d716f1d168
# Arbitrum One (Mainnet addresses for reference/target)
PAXOS_USDG_ARBITRUM=0x004b506865409877c9fa29bfb1eba929984b9bbc
PAXOS_PYUSD_ARBITRUM=0x46850ad61c2b7d64d08c9c754f45254596696984

# IPFS & INFRA
PINATA_JWT=YOUR_PINATA_JWT
ZERODEV_PROJECT_ID=YOUR_ZERODEV_PROJECT_ID
DATABASE_URL=YOUR_POSTGRES_URL

# REAL X402 V2 AGENT DEMO
# PRIVATE_KEY is the server-only funded buyer. The seller must be a different address.
#
# X402_PAY_TO receives every payment. Use an EOA treasury (or a wallet contract that can move
# tokens out). Never use AgentRegistry or RoboticsMarketplace: they have no withdraw path, so
# anything paid to them is stuck. REAL_MUSDG_X402 refuses a payee with contract code.
#
# Mode REAL_X402_TEST_ASSET: Base Sepolia test USDC through the public x402.org facilitator
X402_MODE=REAL_X402_TEST_ASSET
X402_NETWORK=eip155:84532
X402_CHAIN_ID=84532
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_RESOURCE_BASE_URL=http://localhost:3001
X402_PAY_TO=YOUR_TREASURY_EOA
X402_ASSET_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_ASSET_NAME=USDC
X402_ASSET_VERSION=2
X402_ASSET_SYMBOL=USDC
X402_ASSET_DECIMALS=6
X402_PRICE_DISPLAY=0.05
X402_RPC_URL=https://sepolia.base.org

AGENT_MAX_SPEND_ATOMIC=50000
AGENT_MAX_TOTAL_SPEND_ATOMIC=50000
AGENT_ALLOWED_HOSTS=localhost:3001
AGENT_ALLOWED_PAY_TO=YOUR_TREASURY_EOA
AGENT_REQUEST_TIMEOUT_MS=30000
AGENT_RUN_TTL_MS=900000
AGENT_MAX_CONCURRENT_RUNS=1
# In-memory, per-process limits on GET /x402/datasets/:id/content (0 disables a limit).
# Every request counts per client IP; requests carrying a payment also count per payer address.
X402_RATE_LIMIT_WINDOW_MS=60000
X402_RATE_LIMIT_PER_IP=60
X402_RATE_LIMIT_PER_PAYER=10

# Mode REAL_MUSDG_X402: MockUSDG (EIP-3009) on Arbitrum Sepolia or Robinhood Chain Testnet.
# No hosted facilitator serves these chains, so the server verifies and settles in-process.
# Chain id, RPC and the token's EIP-712 name/version/symbol/decimals default from X402_NETWORK.
# The buyer (PRIVATE_KEY) needs mUSDG only (EIP-3009 is gasless for the payer); the facilitator
# signer needs native ETH for settlement gas. Deploy with contracts/script/DeployX402.s.sol.
# X402_MODE=REAL_MUSDG_X402
# X402_NETWORK=eip155:421614            # or eip155:46630 for Robinhood Chain Testnet
# X402_ASSET_ADDRESS=                   # MockUSDG from contracts/deployments/x402-<chainId>.json
# X402_FACILITATOR_PRIVATE_KEY=         # gas-paying settlement signer, approved settler on the contract
# X402_SETTLEMENT_CONTRACT=             # optional X402Facilitator; omit to settle straight to the token
# X402_PRICE_DISPLAY=0.05

# Robinhood Chain Testnet Configuration
ROBINHOOD_CHAIN_ID=46630
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
