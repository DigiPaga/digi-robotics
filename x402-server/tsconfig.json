{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": [
    "src/server.ts",
    "src/app.ts",
    "src/telegramBot.ts",
    "src/config/env.ts",
    "src/agent/**/*.ts",
    "src/data/**/*.ts",
    "src/routes/agentDemo.ts",
    "src/types/agentDemo.ts",
    "src/utils/redact.ts",
    "src/x402/**/*.ts",
    "src/tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
