{
  "name": "x402-server",
  "version": "1.0.0",
  "description": "DigiRobotics x402 Backend Server",
  "main": "src/server.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "wrangler types && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --import tsx --test src/tests/*.test.ts",
    "test:live": "node --import tsx --test src/tests/live-x402.test.ts",
    "lint": "eslint src/app.ts src/server.ts src/worker.ts src/agent src/config/env.ts src/data src/routes/agentDemo.ts src/types/agentDemo.ts src/utils/redact.ts src/x402 src/tests --max-warnings=0",
    "test:e2e": "node --import tsx --test src/tests/musdg-anvil.e2e.ts",
    "worker:dev": "WRANGLER_BUILD_PLATFORM=node wrangler dev --var X402_MODE:BLOCKED --var X402_NETWORK:eip155:84532 --var X402_ASSET_ADDRESS:0x036CbD53842c5426634e7929541eC2318f3dCF7e --var X402_RESOURCE_BASE_URL:http://localhost:8787 --var AGENT_ALLOWED_HOSTS:localhost:8787",
    "worker:deploy": "WRANGLER_BUILD_PLATFORM=node wrangler deploy",
    "worker:dev:robinhood": "WRANGLER_BUILD_PLATFORM=node wrangler dev --env robinhood --var X402_MODE:BLOCKED --var X402_RESOURCE_BASE_URL:http://localhost:8787 --var AGENT_ALLOWED_HOSTS:localhost:8787",
    "worker:deploy:robinhood": "WRANGLER_BUILD_PLATFORM=node wrangler deploy --env robinhood"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "@x402/express": "^2.27.0",
    "@x402/extensions": "^2.27.0",
    "@x402/fetch": "^2.27.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pinata-web3": "^0.5.4",
    "telegraf": "^4.16.3",
    "viem": "^2.56.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.39.5",
    "supertest": "^7.3.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.70.1",
    "wrangler": "4.145.0"
  }
}
